<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P11_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P11_colaboracion">
    <bpmn:documentation>P11 Abastecimiento: de la solicitud al pago. Solicitud aprobada, cotizaciones, orden de compra, recepción con PMP, factura con matching de 3 vías o umbral de aprobación, y pago.</bpmn:documentation>
    <bpmn:participant id="P11_pool_prov" name="Proveedor"></bpmn:participant>
    <bpmn:participant id="P11_pool_ae" name="Aether ERP" processRef="P11_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P11_mensaje_1" name="Pide cotización" sourceRef="P11_cot" targetRef="P11_pool_prov" />
    <bpmn:messageFlow id="P11_mensaje_2" name="Orden de compra" sourceRef="P11_oc" targetRef="P11_pool_prov" />
    <bpmn:messageFlow id="P11_mensaje_3" name="Despacho y guía" sourceRef="P11_pool_prov" targetRef="P11_rcp" />
    <bpmn:messageFlow id="P11_mensaje_4" name="Factura sin OC" sourceRef="P11_pool_prov" targetRef="P11_ib" />
    <bpmn:messageFlow id="P11_mensaje_5" name="Factura" sourceRef="P11_pool_prov" targetRef="P11_fac" />
    <bpmn:messageFlow id="P11_mensaje_6" name="Transferencia" sourceRef="P11_pag" targetRef="P11_pool_prov" />
  </bpmn:collaboration>
  <bpmn:process id="P11_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P11_carriles_ae">
      <bpmn:lane id="P11_carril_sol" name="Solicitante">
        <bpmn:flowNodeRef>P11_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_env</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_carril_com" name="Compras">
        <bpmn:flowNodeRef>P11_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_oc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_fac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_ib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_fb</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_carril_bod" name="Bodega">
        <bpmn:flowNodeRef>P11_rcp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P11_pmp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_gm3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_gu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_mov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_gmA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_asi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_carril_apr" name="Aprobador (purchases:approve)">
        <bpmn:flowNodeRef>P11_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_rj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_ovr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_apf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_gap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_rjb</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_carril_tes" name="Tesorería">
        <bpmn:flowNodeRef>P11_lote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_pag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_fp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P11_i" name="Se necesita comprar">
      <bpmn:outgoing>P11_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P11_req" name="Crear la solicitud de compra">
      <bpmn:incoming>P11_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P11_env" name="Enviar a aprobación">
      <bpmn:incoming>P11_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P11_dec" name="Revisar la solicitud">
      <bpmn:incoming>P11_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P11_gd" name="¿Aprobada?">
      <bpmn:incoming>P11_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_5</bpmn:outgoing>
      <bpmn:outgoing>P11_flujo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P11_rj" name="Solicitud rechazada">
      <bpmn:incoming>P11_flujo_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P11_cot" name="Pedir y comparar cotizaciones">
      <bpmn:incoming>P11_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P11_oc" name="Generar y enviar la orden de compra">
      <bpmn:incoming>P11_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P11_rcp" name="Recibir mercadería contra la OC">
      <bpmn:incoming>P11_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P11_pmp" name="Entrada a kardex y nuevo PMP (FOR UPDATE)">
      <bpmn:incoming>P11_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P11_fac" name="Registrar la factura del proveedor">
      <bpmn:incoming>P11_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="P11_m3" name="Matching de 3 vías: OC, recepción y factura">
      <bpmn:incoming>P11_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="P11_gm3" name="¿Cuadra?">
      <bpmn:incoming>P11_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_13</bpmn:outgoing>
      <bpmn:outgoing>P11_flujo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P11_ovr" name="Revisar la diferencia y autorizarla">
      <bpmn:documentation>overridePurchaseMatch: el estado pasa a OVERRIDDEN.</bpmn:documentation>
      <bpmn:incoming>P11_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="P11_ib" name="Llega factura sin orden de compra">
      <bpmn:outgoing>P11_flujo_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="P11_fb" name="Registrar la factura directa">
      <bpmn:incoming>P11_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P11_gu" name="¿Supera el umbral de aprobación?">
      <bpmn:incoming>P11_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_18</bpmn:outgoing>
      <bpmn:outgoing>P11_flujo_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P11_apf" name="Aprobar o rechazar la factura">
      <bpmn:incoming>P11_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P11_gap" name="¿Aprobada?">
      <bpmn:incoming>P11_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_21</bpmn:outgoing>
      <bpmn:outgoing>P11_flujo_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P11_rjb" name="Factura rechazada">
      <bpmn:incoming>P11_flujo_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P11_mov" name="Mover kardex y PMP">
      <bpmn:incoming>P11_flujo_18</bpmn:incoming>
      <bpmn:incoming>P11_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P11_gmA" name="">
      <bpmn:incoming>P11_flujo_13</bpmn:incoming>
      <bpmn:incoming>P11_flujo_15</bpmn:incoming>
      <bpmn:incoming>P11_flujo_23</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P11_asi" name="Asiento contable y cuenta por pagar">
      <bpmn:incoming>P11_flujo_24</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P11_lote" name="Armar el lote de pagos">
      <bpmn:incoming>P11_flujo_25</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P11_pag" name="Pagar y marcar el lote pagado">
      <bpmn:incoming>P11_flujo_26</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P11_con" name="Conciliar con la cartola">
      <bpmn:incoming>P11_flujo_27</bpmn:incoming>
      <bpmn:outgoing>P11_flujo_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P11_fp" name="Compra pagada">
      <bpmn:incoming>P11_flujo_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P11_flujo_1" sourceRef="P11_i" targetRef="P11_req" />
    <bpmn:sequenceFlow id="P11_flujo_2" sourceRef="P11_req" targetRef="P11_env" />
    <bpmn:sequenceFlow id="P11_flujo_3" sourceRef="P11_env" targetRef="P11_dec" />
    <bpmn:sequenceFlow id="P11_flujo_4" sourceRef="P11_dec" targetRef="P11_gd" />
    <bpmn:sequenceFlow id="P11_flujo_5" name="Sí" sourceRef="P11_gd" targetRef="P11_cot" />
    <bpmn:sequenceFlow id="P11_flujo_6" name="No" sourceRef="P11_gd" targetRef="P11_rj" />
    <bpmn:sequenceFlow id="P11_flujo_7" sourceRef="P11_cot" targetRef="P11_oc" />
    <bpmn:sequenceFlow id="P11_flujo_8" sourceRef="P11_oc" targetRef="P11_rcp" />
    <bpmn:sequenceFlow id="P11_flujo_9" sourceRef="P11_rcp" targetRef="P11_pmp" />
    <bpmn:sequenceFlow id="P11_flujo_10" sourceRef="P11_pmp" targetRef="P11_fac" />
    <bpmn:sequenceFlow id="P11_flujo_11" sourceRef="P11_fac" targetRef="P11_m3" />
    <bpmn:sequenceFlow id="P11_flujo_12" sourceRef="P11_m3" targetRef="P11_gm3" />
    <bpmn:sequenceFlow id="P11_flujo_13" name="Sí" sourceRef="P11_gm3" targetRef="P11_gmA" />
    <bpmn:sequenceFlow id="P11_flujo_14" name="No" sourceRef="P11_gm3" targetRef="P11_ovr" />
    <bpmn:sequenceFlow id="P11_flujo_15" sourceRef="P11_ovr" targetRef="P11_gmA" />
    <bpmn:sequenceFlow id="P11_flujo_16" sourceRef="P11_ib" targetRef="P11_fb" />
    <bpmn:sequenceFlow id="P11_flujo_17" sourceRef="P11_fb" targetRef="P11_gu" />
    <bpmn:sequenceFlow id="P11_flujo_18" name="No" sourceRef="P11_gu" targetRef="P11_mov" />
    <bpmn:sequenceFlow id="P11_flujo_19" name="Sí" sourceRef="P11_gu" targetRef="P11_apf" />
    <bpmn:sequenceFlow id="P11_flujo_20" sourceRef="P11_apf" targetRef="P11_gap" />
    <bpmn:sequenceFlow id="P11_flujo_21" name="Sí" sourceRef="P11_gap" targetRef="P11_mov" />
    <bpmn:sequenceFlow id="P11_flujo_22" name="No" sourceRef="P11_gap" targetRef="P11_rjb" />
    <bpmn:sequenceFlow id="P11_flujo_23" sourceRef="P11_mov" targetRef="P11_gmA" />
    <bpmn:sequenceFlow id="P11_flujo_24" sourceRef="P11_gmA" targetRef="P11_asi" />
    <bpmn:sequenceFlow id="P11_flujo_25" sourceRef="P11_asi" targetRef="P11_lote" />
    <bpmn:sequenceFlow id="P11_flujo_26" sourceRef="P11_lote" targetRef="P11_pag" />
    <bpmn:sequenceFlow id="P11_flujo_27" sourceRef="P11_pag" targetRef="P11_con" />
    <bpmn:sequenceFlow id="P11_flujo_28" sourceRef="P11_con" targetRef="P11_fp" />
    <bpmn:textAnnotation id="P11_nota_n1"><bpmn:text>Sin OC y sobre el umbral, la factura no mueve stock ni PMP hasta aprobarse. Con OC, el control es el matching.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P11_diagrama" name="P11 Abastecimiento: de la solicitud al pago">
    <bpmndi:BPMNPlane id="P11_plano" bpmnElement="P11_colaboracion">
      <bpmndi:BPMNShape id="P11_pool_prov_di" bpmnElement="P11_pool_prov" isHorizontal="true" bioc:stroke="#5f6368" bioc:fill="#f6f6f6" color:border-color="#5f6368" color:background-color="#f6f6f6"><dc:Bounds x="20" y="20" width="3490" height="72" /></bpmndi:BPMNShape>
