<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P13_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P13_colaboracion">
    <bpmn:documentation>P13 Cierre mensual y F29. El cron del día 5 calcula el F29 del mes anterior y las cuadraturas; el contador corrige, declara en el SII y cierra.</bpmn:documentation>
    <bpmn:participant id="P13_pool_sii" name="SII"></bpmn:participant>
    <bpmn:participant id="P13_pool_ae" name="Aether ERP" processRef="P13_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P13_mensaje_1" name="Formulario 29" sourceRef="P13_decl" targetRef="P13_pool_sii" />
  </bpmn:collaboration>
  <bpmn:process id="P13_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P13_carriles_ae">
      <bpmn:lane id="P13_carril_cron" name="Cron de Vercel">
        <bpmn:flowNodeRef>P13_i</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P13_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P13_emp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_f29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_gpc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_cua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_mail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P13_carril_con" name="Contador">
        <bpmn:flowNodeRef>P13_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_gdif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_aj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_dep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_decl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_cer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P13_i" name="Día 5 de cada mes, 08:00">
      <bpmn:outgoing>P13_flujo_1</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 8 5 * *</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P13_emp" name="Tomar las empresas con facturación electrónica">
      <bpmn:incoming>P13_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P13_f29" name="Calcular el F29 del mes anterior">
      <bpmn:incoming>P13_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P13_gpc" name="¿Plan de cuentas mapeado?">
      <bpmn:incoming>P13_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_4</bpmn:outgoing>
      <bpmn:outgoing>P13_flujo_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P13_cua" name="Correr cuadraturas contra el F29">
      <bpmn:incoming>P13_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P13_gm" name="">
      <bpmn:incoming>P13_flujo_5</bpmn:incoming>
      <bpmn:incoming>P13_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P13_mail" name="Enviar resumen a Dueños, Administradores y Contador">
      <bpmn:incoming>P13_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="P13_rev" name="Revisar F29 y cuadraturas">
      <bpmn:incoming>P13_flujo_8</bpmn:incoming>
      <bpmn:incoming>P13_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P13_gdif" name="¿Hay diferencias?">
      <bpmn:incoming>P13_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_10</bpmn:outgoing>
      <bpmn:outgoing>P13_flujo_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P13_aj" name="Corregir: asientos manuales, notas o documentos faltantes">
      <bpmn:incoming>P13_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P13_rec" name="Recalcular la conciliación">
      <bpmn:incoming>P13_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P13_dep" name="Asiento de depreciación (si hay activo fijo)">
      <bpmn:documentation>Cuentas 6105 / 1202.</bpmn:documentation>
      <bpmn:incoming>P13_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="P13_decl" name="Declarar y pagar el F29 en el SII">
      <bpmn:incoming>P13_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P13_cer" name="Cerrar el período contable">
      <bpmn:incoming>P13_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P13_flujo_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P13_fin" name="Mes cerrado">
      <bpmn:incoming>P13_flujo_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P13_flujo_1" sourceRef="P13_i" targetRef="P13_emp" />
    <bpmn:sequenceFlow id="P13_flujo_2" sourceRef="P13_emp" targetRef="P13_f29" />
    <bpmn:sequenceFlow id="P13_flujo_3" sourceRef="P13_f29" targetRef="P13_gpc" />
    <bpmn:sequenceFlow id="P13_flujo_4" name="Sí" sourceRef="P13_gpc" targetRef="P13_cua" />
    <bpmn:sequenceFlow id="P13_flujo_5" name="No" sourceRef="P13_gpc" targetRef="P13_gm" />
    <bpmn:sequenceFlow id="P13_flujo_6" sourceRef="P13_cua" targetRef="P13_gm" />
    <bpmn:sequenceFlow id="P13_flujo_7" sourceRef="P13_gm" targetRef="P13_mail" />
    <bpmn:sequenceFlow id="P13_flujo_8" sourceRef="P13_mail" targetRef="P13_rev" />
    <bpmn:sequenceFlow id="P13_flujo_9" sourceRef="P13_rev" targetRef="P13_gdif" />
    <bpmn:sequenceFlow id="P13_flujo_10" name="Sí" sourceRef="P13_gdif" targetRef="P13_aj" />
    <bpmn:sequenceFlow id="P13_flujo_11" sourceRef="P13_aj" targetRef="P13_rec" />
    <bpmn:sequenceFlow id="P13_flujo_12" sourceRef="P13_rec" targetRef="P13_rev" />
    <bpmn:sequenceFlow id="P13_flujo_13" name="No" sourceRef="P13_gdif" targetRef="P13_dep" />
    <bpmn:sequenceFlow id="P13_flujo_14" sourceRef="P13_dep" targetRef="P13_decl" />
    <bpmn:sequenceFlow id="P13_flujo_15" sourceRef="P13_decl" targetRef="P13_cer" />
    <bpmn:sequenceFlow id="P13_flujo_16" sourceRef="P13_cer" targetRef="P13_fin" />
    <bpmn:textAnnotation id="P13_nota_n1"><bpmn:text>F29 real: débito, crédito, remanente, PPM e impuesto determinado.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P13_asoc_n1" associationDirection="None" sourceRef="P13_nota_n1" targetRef="P13_f29" />
    <bpmn:textAnnotation id="P13_nota_nb"><bpmn:text>Brecha: el permiso existe, pero ninguna acción cambia el período a CLOSED o LOCKED.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P13_asoc_nb" associationDirection="None" sourceRef="P13_nota_nb" targetRef="P13_cer" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P13_diagrama" name="P13 Cierre mensual y F29">
    <bpmndi:BPMNPlane id="P13_plano" bpmnElement="P13_colaboracion">
