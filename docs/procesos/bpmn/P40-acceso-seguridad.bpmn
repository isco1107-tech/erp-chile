<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P40_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P40_colaboracion">
    <bpmn:documentation>P40 Acceso y seguridad. Ingreso con límites y Turnstile, bloqueo por intentos, empresa suspendida, 2FA, lista de IPs, sesión de 8 horas, elección de empresa y cambio de clave.</bpmn:documentation>
    <bpmn:participant id="P40_pool_ae" name="Aether ERP" processRef="P40_proc_ae"></bpmn:participant>
  </bpmn:collaboration>
  <bpmn:process id="P40_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P40_carriles_ae">
      <bpmn:lane id="P40_carril_usr" name="Usuario">
        <bpmn:flowNodeRef>P40_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_cred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_totp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_sel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_chg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P40_carril_sis" name="Aether: ingreso y guards">
        <bpmn:flowNodeRef>P40_rl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_vc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_gb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_bad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_blk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_sus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_vt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_ip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_gip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_ipx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_ses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_gmc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_gm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_gpw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_gm3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_pan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P40_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P40_i" name="Abre /login">
      <bpmn:outgoing>P40_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P40_cred" name="Escribir correo y clave">
      <bpmn:incoming>P40_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P40_rl" name="Límite por IP y Turnstile">
      <bpmn:incoming>P40_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P40_vc" name="Verificar la clave (bcrypt, mismo tiempo de respuesta)">
      <bpmn:incoming>P40_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P40_gb" name="¿Resultado?">
      <bpmn:incoming>P40_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_5</bpmn:outgoing>
      <bpmn:outgoing>P40_flujo_6</bpmn:outgoing>
      <bpmn:outgoing>P40_flujo_7</bpmn:outgoing>
      <bpmn:outgoing>P40_flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P40_bad" name="401 sin revelar si el correo existe">
      <bpmn:incoming>P40_flujo_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P40_blk" name="Bloqueada 15 min y aviso a los Dueños">
      <bpmn:incoming>P40_flujo_7</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:endEvent id="P40_sus" name="Aviso: empresa suspendida">
      <bpmn:incoming>P40_flujo_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P40_g2" name="¿Tiene 2FA?">
      <bpmn:incoming>P40_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_9</bpmn:outgoing>
      <bpmn:outgoing>P40_flujo_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P40_totp" name="Ingresar el código TOTP">
      <bpmn:incoming>P40_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P40_vt" name="Verificar el TOTP (5 intentos, 15 min)">
      <bpmn:incoming>P40_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P40_gm" name="">
      <bpmn:incoming>P40_flujo_10</bpmn:incoming>
      <bpmn:incoming>P40_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="P40_ip" name="Revisar la lista de IPs de la empresa">
      <bpmn:incoming>P40_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="P40_gip" name="¿IP permitida?">
      <bpmn:incoming>P40_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_15</bpmn:outgoing>
      <bpmn:outgoing>P40_flujo_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P40_ipx" name="Acceso denegado por IP">
      <bpmn:incoming>P40_flujo_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P40_ses" name="Crear la sesión: JWT cifrado en cookie, 8 h">
      <bpmn:incoming>P40_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P40_gmc" name="¿Varias empresas?">
      <bpmn:incoming>P40_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_18</bpmn:outgoing>
      <bpmn:outgoing>P40_flujo_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P40_sel" name="Elegir la empresa">
      <bpmn:incoming>P40_flujo_18</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P40_gm2" name="">
      <bpmn:incoming>P40_flujo_19</bpmn:incoming>
      <bpmn:incoming>P40_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P40_gpw" name="¿Clave pendiente de cambio?">
      <bpmn:incoming>P40_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_22</bpmn:outgoing>
      <bpmn:outgoing>P40_flujo_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P40_chg" name="Cambiar la clave">
      <bpmn:incoming>P40_flujo_22</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P40_gm3" name="">
      <bpmn:incoming>P40_flujo_23</bpmn:incoming>
      <bpmn:incoming>P40_flujo_24</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P40_pan" name="Panel: cada request relee empresa y usuario">
      <bpmn:incoming>P40_flujo_25</bpmn:incoming>
      <bpmn:outgoing>P40_flujo_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P40_fin" name="Sesión activa">
      <bpmn:incoming>P40_flujo_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P40_flujo_1" sourceRef="P40_i" targetRef="P40_cred" />
    <bpmn:sequenceFlow id="P40_flujo_2" sourceRef="P40_cred" targetRef="P40_rl" />
    <bpmn:sequenceFlow id="P40_flujo_3" sourceRef="P40_rl" targetRef="P40_vc" />
    <bpmn:sequenceFlow id="P40_flujo_4" sourceRef="P40_vc" targetRef="P40_gb" />
    <bpmn:sequenceFlow id="P40_flujo_5" name="Correcta" sourceRef="P40_gb" targetRef="P40_g2" />
    <bpmn:sequenceFlow id="P40_flujo_6" name="Incorrecta" sourceRef="P40_gb" targetRef="P40_bad" />
    <bpmn:sequenceFlow id="P40_flujo_7" name="Demasiados intentos" sourceRef="P40_gb" targetRef="P40_blk" />
    <bpmn:sequenceFlow id="P40_flujo_8" name="Empresa suspendida" sourceRef="P40_gb" targetRef="P40_sus" />
    <bpmn:sequenceFlow id="P40_flujo_9" name="Sí" sourceRef="P40_g2" targetRef="P40_totp" />
    <bpmn:sequenceFlow id="P40_flujo_10" name="No" sourceRef="P40_g2" targetRef="P40_gm" />
    <bpmn:sequenceFlow id="P40_flujo_11" sourceRef="P40_totp" targetRef="P40_vt" />
    <bpmn:sequenceFlow id="P40_flujo_12" sourceRef="P40_vt" targetRef="P40_gm" />
    <bpmn:sequenceFlow id="P40_flujo_13" sourceRef="P40_gm" targetRef="P40_ip" />
    <bpmn:sequenceFlow id="P40_flujo_14" sourceRef="P40_ip" targetRef="P40_gip" />
    <bpmn:sequenceFlow id="P40_flujo_15" name="Sí" sourceRef="P40_gip" targetRef="P40_ses" />
    <bpmn:sequenceFlow id="P40_flujo_16" name="No" sourceRef="P40_gip" targetRef="P40_ipx" />
    <bpmn:sequenceFlow id="P40_flujo_17" sourceRef="P40_ses" targetRef="P40_gmc" />
    <bpmn:sequenceFlow id="P40_flujo_18" name="Sí" sourceRef="P40_gmc" targetRef="P40_sel" />
    <bpmn:sequenceFlow id="P40_flujo_19" name="No" sourceRef="P40_gmc" targetRef="P40_gm2" />
    <bpmn:sequenceFlow id="P40_flujo_20" sourceRef="P40_sel" targetRef="P40_gm2" />
    <bpmn:sequenceFlow id="P40_flujo_21" sourceRef="P40_gm2" targetRef="P40_gpw" />
    <bpmn:sequenceFlow id="P40_flujo_22" name="Sí" sourceRef="P40_gpw" targetRef="P40_chg" />
    <bpmn:sequenceFlow id="P40_flujo_23" name="No" sourceRef="P40_gpw" targetRef="P40_gm3" />
    <bpmn:sequenceFlow id="P40_flujo_24" sourceRef="P40_chg" targetRef="P40_gm3" />
    <bpmn:sequenceFlow id="P40_flujo_25" sourceRef="P40_gm3" targetRef="P40_pan" />
    <bpmn:sequenceFlow id="P40_flujo_26" sourceRef="P40_pan" targetRef="P40_fin" />
    <bpmn:textAnnotation id="P40_nota_n1"><bpmn:text>Sin excepción por superusuario: una empresa suspendida no entra ni para reactivarse.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P40_asoc_n1" associationDirection="None" sourceRef="P40_nota_n1" targetRef="P40_sus" />
    <bpmn:textAnnotation id="P40_nota_n2"><bpmn:text>Suspender o desactivar corta el acceso de inmediato, no al vencer el token.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P40_asoc_n2" associationDirection="None" sourceRef="P40_nota_n2" targetRef="P40_pan" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P40_diagrama" name="P40 Acceso y seguridad">
    <bpmndi:BPMNPlane id="P40_plano" bpmnElement="P40_colaboracion">
