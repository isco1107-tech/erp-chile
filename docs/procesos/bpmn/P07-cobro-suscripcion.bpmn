      <bpmndi:BPMNShape id="P07_pool_ae_di" bpmnElement="P07_pool_ae" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="20" y="1388" width="2956" height="264" /></bpmndi:BPMNShape>
