      <bpmndi:BPMNShape id="P07_pool_ss_di" bpmnElement="P07_pool_ss" isHorizontal="true" bioc:stroke="#284a7e" bioc:fill="#f5f8fd" color:border-color="#284a7e" color:background-color="#f5f8fd"><dc:Bounds x="20" y="276" width="2956" height="1056" /></bpmndi:BPMNShape>
