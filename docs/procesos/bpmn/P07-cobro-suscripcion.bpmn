      <bpmndi:BPMNShape id="P07_i_di" bpmnElement="P07_i" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="175" y="324" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="133" y="366" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
