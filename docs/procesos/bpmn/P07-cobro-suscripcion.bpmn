      <bpmndi:BPMNShape id="P07_gp_di" bpmnElement="P07_gp" isMarkerVisible="true" bioc:stroke="#8a6a00" bioc:fill="#fff1bf" color:border-color="#8a6a00" color:background-color="#fff1bf"><dc:Bounds x="524" y="317" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="485" y="283" width="128" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_ign_di" bpmnElement="P07_ign" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="709" y="456" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="667" y="498" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
