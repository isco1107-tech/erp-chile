      <bpmndi:BPMNShape id="P07_carril_wk_di" bpmnElement="P07_carril_wk" isHorizontal="true" bioc:stroke="#284a7e" bioc:fill="#f5f8fd" color:border-color="#284a7e" color:background-color="#f5f8fd"><dc:Bounds x="50" y="672" width="2926" height="264" /></bpmndi:BPMNShape>
