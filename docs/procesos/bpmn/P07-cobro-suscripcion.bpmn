<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P07_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P07_colaboracion">
    <bpmn:documentation>P07 Cobro de la suscripción y morosidad. Pagos por Flow, Khipu o a mano; alertas de morosidad y suspensión o reactivación de la cuenta por orden.</bpmn:documentation>
    <bpmn:participant id="P07_pool_emp" name="Empresa cliente"></bpmn:participant>
    <bpmn:participant id="P07_pool_pas" name="Flow / Khipu"></bpmn:participant>
    <bpmn:participant id="P07_pool_ss" name="Supersuite" processRef="P07_proc_ss"></bpmn:participant>
    <bpmn:participant id="P07_pool_ae" name="Aether ERP" processRef="P07_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P07_mensaje_1" name="Paga la suscripción" sourceRef="P07_pool_emp" targetRef="P07_pool_pas" />
    <bpmn:messageFlow id="P07_mensaje_2" name="payment_id o token" sourceRef="P07_pool_pas" targetRef="P07_i" />
    <bpmn:messageFlow id="P07_mensaje_3" name="Consulta del cobro" sourceRef="P07_cons" targetRef="P07_pool_pas" />
    <bpmn:messageFlow id="P07_mensaje_4" name="Orden firmada" sourceRef="P07_sus" targetRef="P07_os" />
    <bpmn:messageFlow id="P07_mensaje_5" name="Orden firmada" sourceRef="P07_rea" targetRef="P07_or" />
  </bpmn:collaboration>
  <bpmn:process id="P07_proc_ss" name="Supersuite" isExecutable="false">
    <bpmn:laneSet id="P07_carriles_ss">
      <bpmn:lane id="P07_carril_api" name="API de la Supersuite">
        <bpmn:flowNodeRef>P07_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_cons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_gp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_ign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_mrr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_fp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_carril_wk" name="Worker (reglas)">
        <bpmn:flowNodeRef>P07_wi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_mor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_wf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_al</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_carril_opr" name="Operador o admin">
        <bpmn:flowNodeRef>P07_pm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_rpm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_rv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_cob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_fc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_sus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_fsu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_pi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_rea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_fre</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P07_i" name="Notificación de pago">
      <bpmn:outgoing>P07_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P07_cons" name="Consultar el pago a la API del proveedor">
      <bpmn:incoming>P07_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P07_gp" name="¿Pagado y con orden válida?">
      <bpmn:incoming>P07_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P07_flujo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P07_ign" name="Se ignora">
      <bpmn:incoming>P07_flujo_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P07_reg" name="Registrar el pago sin duplicar">
      <bpmn:incoming>P07_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P07_mrr" name="Actualizar MRR y cerrar la alerta de morosidad">
      <bpmn:incoming>P07_flujo_5</bpmn:incoming>
      <bpmn:incoming>P07_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P07_fp" name="Pago al día">
      <bpmn:incoming>P07_flujo_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P07_pm" name="Pago por transferencia o efectivo">
      <bpmn:outgoing>P07_flujo_7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P07_rpm" name="Registrar el pago en la ficha">
      <bpmn:incoming>P07_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="P07_wi" name="Cada 5 minutos">
      <bpmn:outgoing>P07_flujo_9</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">*/5 * * * *</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="P07_mor" name="Revisar días sin pagar">
      <bpmn:incoming>P07_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="P07_gm" name="¿Más de 35 días?">
      <bpmn:incoming>P07_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_11</bpmn:outgoing>
      <bpmn:outgoing>P07_flujo_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P07_wf" name="Sin acción">
      <bpmn:incoming>P07_flujo_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P07_al" name="Abrir alerta: alta &gt; 35 días, crítica &gt; 60">
      <bpmn:incoming>P07_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P07_rv" name="Revisar la empresa morosa">
      <bpmn:incoming>P07_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P07_gd" name="¿Qué decide?">
      <bpmn:incoming>P07_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_15</bpmn:outgoing>
      <bpmn:outgoing>P07_flujo_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="P07_cob" name="Contactar y cobrar">
      <bpmn:incoming>P07_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="P07_fc" name="En gestión de cobro">
      <bpmn:incoming>P07_flujo_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P07_sus" name="Transmitir cuenta.suspender">
      <bpmn:incoming>P07_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P07_fsu" name="Suspendida hasta que pague">
      <bpmn:incoming>P07_flujo_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P07_pi" name="Paga una empresa suspendida">
      <bpmn:outgoing>P07_flujo_19</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P07_rea" name="Transmitir cuenta.reactivar">
      <bpmn:incoming>P07_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P07_fre" name="Reactivación pedida">
      <bpmn:incoming>P07_flujo_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P07_flujo_1" sourceRef="P07_i" targetRef="P07_cons" />
    <bpmn:sequenceFlow id="P07_flujo_2" sourceRef="P07_cons" targetRef="P07_gp" />
    <bpmn:sequenceFlow id="P07_flujo_3" name="Sí" sourceRef="P07_gp" targetRef="P07_reg" />
    <bpmn:sequenceFlow id="P07_flujo_4" name="No" sourceRef="P07_gp" targetRef="P07_ign" />
    <bpmn:sequenceFlow id="P07_flujo_5" sourceRef="P07_reg" targetRef="P07_mrr" />
    <bpmn:sequenceFlow id="P07_flujo_6" sourceRef="P07_mrr" targetRef="P07_fp" />
    <bpmn:sequenceFlow id="P07_flujo_7" sourceRef="P07_pm" targetRef="P07_rpm" />
    <bpmn:sequenceFlow id="P07_flujo_8" sourceRef="P07_rpm" targetRef="P07_mrr" />
    <bpmn:sequenceFlow id="P07_flujo_9" sourceRef="P07_wi" targetRef="P07_mor" />
    <bpmn:sequenceFlow id="P07_flujo_10" sourceRef="P07_mor" targetRef="P07_gm" />
    <bpmn:sequenceFlow id="P07_flujo_11" name="Sí" sourceRef="P07_gm" targetRef="P07_al" />
    <bpmn:sequenceFlow id="P07_flujo_12" name="No" sourceRef="P07_gm" targetRef="P07_wf" />
    <bpmn:sequenceFlow id="P07_flujo_13" sourceRef="P07_al" targetRef="P07_rv" />
    <bpmn:sequenceFlow id="P07_flujo_14" sourceRef="P07_rv" targetRef="P07_gd" />
    <bpmn:sequenceFlow id="P07_flujo_15" name="Cobrar" sourceRef="P07_gd" targetRef="P07_cob" />
    <bpmn:sequenceFlow id="P07_flujo_16" sourceRef="P07_cob" targetRef="P07_fc" />
    <bpmn:sequenceFlow id="P07_flujo_17" name="Suspender" sourceRef="P07_gd" targetRef="P07_sus" />
    <bpmn:sequenceFlow id="P07_flujo_18" sourceRef="P07_sus" targetRef="P07_fsu" />
    <bpmn:sequenceFlow id="P07_flujo_19" sourceRef="P07_pi" targetRef="P07_rea" />
    <bpmn:sequenceFlow id="P07_flujo_20" sourceRef="P07_rea" targetRef="P07_fre" />
    <bpmn:textAnnotation id="P07_nota_n1"><bpmn:text>Es la misma regla que usa Aether con Khipu en sus cuotas: el estado siempre se pide al proveedor.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P07_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P07_carriles_ae">
      <bpmn:lane id="P07_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P07_os</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_st</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_cut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_fs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_or</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_ac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_fr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P07_os" name="Llega cuenta.suspender">
      <bpmn:outgoing>P07_flujo_21</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P07_st" name="Estado SUSPENDED">
      <bpmn:documentation>setTenantStatus. Una CANCELLED no se toca.</bpmn:documentation>
      <bpmn:incoming>P07_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P07_cut" name="Login y cada request rechazan a sus usuarios">
      <bpmn:documentation>getAuthContext relee la base en cada request: el corte es inmediato.</bpmn:documentation>
      <bpmn:incoming>P07_flujo_22</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P07_fs" name="Sin acceso">
      <bpmn:incoming>P07_flujo_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P07_or" name="Llega cuenta.reactivar">
      <bpmn:outgoing>P07_flujo_24</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P07_ac" name="Estado ACTIVE">
      <bpmn:incoming>P07_flujo_24</bpmn:incoming>
      <bpmn:outgoing>P07_flujo_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P07_fr" name="Acceso restablecido">
      <bpmn:incoming>P07_flujo_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P07_flujo_21" sourceRef="P07_os" targetRef="P07_st" />
    <bpmn:sequenceFlow id="P07_flujo_22" sourceRef="P07_st" targetRef="P07_cut" />
    <bpmn:sequenceFlow id="P07_flujo_23" sourceRef="P07_cut" targetRef="P07_fs" />
    <bpmn:sequenceFlow id="P07_flujo_24" sourceRef="P07_or" targetRef="P07_ac" />
    <bpmn:sequenceFlow id="P07_flujo_25" sourceRef="P07_ac" targetRef="P07_fr" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P07_diagrama" name="P07 Cobro de la suscripción y morosidad">
    <bpmndi:BPMNPlane id="P07_plano" bpmnElement="P07_colaboracion">
      <bpmndi:BPMNShape id="P07_pool_emp_di" bpmnElement="P07_pool_emp" isHorizontal="true" bioc:stroke="#5f6368" bioc:fill="#f6f6f6" color:border-color="#5f6368" color:background-color="#f6f6f6"><dc:Bounds x="20" y="20" width="2956" height="72" /></bpmndi:BPMNShape>
