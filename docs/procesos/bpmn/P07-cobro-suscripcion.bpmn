      <bpmndi:BPMNShape id="P07_fp_di" bpmnElement="P07_fp" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="1065" y="324" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1023" y="366" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_pm_di" bpmnElement="P07_pm" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="175" y="984" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="133" y="1026" width="120" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_rpm_di" bpmnElement="P07_rpm" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="305" y="960" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_wi_di" bpmnElement="P07_wi" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="887" y="720" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="845" y="762" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07_mor_di" bpmnElement="P07_mor" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="1017" y="696" width="132" height="84" /></bpmndi:BPMNShape>
