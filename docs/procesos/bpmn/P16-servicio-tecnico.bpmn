      <bpmndi:BPMNShape id="P16_carril_sis_di" bpmnElement="P16_carril_sis" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="412" width="2392" height="264" /></bpmndi:BPMNShape>
