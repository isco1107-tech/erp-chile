<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P16_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P16_colaboracion">
    <bpmn:documentation>P16 Servicio técnico. Recepción del equipo, diagnóstico, presupuesto aprobado por el cliente en su enlace, reparación y entrega facturada.</bpmn:documentation>
    <bpmn:participant id="P16_pool_cli" name="Cliente"></bpmn:participant>
    <bpmn:participant id="P16_pool_ae" name="Aether ERP" processRef="P16_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P16_mensaje_1" name="Equipo" sourceRef="P16_pool_cli" targetRef="P16_i" />
    <bpmn:messageFlow id="P16_mensaje_2" name="Comprobante con enlace" sourceRef="P16_ord" targetRef="P16_pool_cli" />
    <bpmn:messageFlow id="P16_mensaje_3" name="Aprueba o rechaza" sourceRef="P16_pool_cli" targetRef="P16_resp" />
    <bpmn:messageFlow id="P16_mensaje_4" name="Equipo reparado" sourceRef="P16_ent" targetRef="P16_pool_cli" />
  </bpmn:collaboration>
  <bpmn:process id="P16_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P16_carriles_ae">
      <bpmn:lane id="P16_carril_rec" name="Recepción">
        <bpmn:flowNodeRef>P16_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_ord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_emi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P16_carril_tec" name="Técnico">
        <bpmn:flowNodeRef>P16_diag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_pres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_lis</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P16_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P16_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_resp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_gap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_can</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_fc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_nv</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P16_i" name="Cliente deja un equipo">
      <bpmn:outgoing>P16_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="P16_ord" name="Crear la orden y entregar el comprobante">
      <bpmn:incoming>P16_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P16_diag" name="Diagnosticar">
      <bpmn:incoming>P16_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P16_pres" name="Cargar presupuesto: repuestos y mano de obra">
      <bpmn:incoming>P16_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P16_esp" name="Presupuesto visible en el enlace (WAITING_APPROVAL)">
      <bpmn:incoming>P16_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="P16_resp" name="Cliente responde en su enlace">
      <bpmn:incoming>P16_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P16_gap" name="¿Aprueba?">
      <bpmn:incoming>P16_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_7</bpmn:outgoing>
      <bpmn:outgoing>P16_flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P16_can" name="Orden cancelada; retira su equipo">
      <bpmn:incoming>P16_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P16_fc" name="Orden cancelada">
      <bpmn:incoming>P16_flujo_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P16_rep" name="Reparar (IN_REPAIR)">
      <bpmn:incoming>P16_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P16_lis" name="Marcar lista (READY)">
      <bpmn:incoming>P16_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P16_nv" name="Generar nota de venta y reservar repuestos">
      <bpmn:incoming>P16_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P16_emi" name="Emitir boleta o factura (P10)">
      <bpmn:incoming>P16_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P16_ent" name="Entregar el equipo (DELIVERED)">
      <bpmn:incoming>P16_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P16_flujo_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P16_fin" name="Equipo entregado">
      <bpmn:incoming>P16_flujo_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P16_flujo_1" sourceRef="P16_i" targetRef="P16_ord" />
    <bpmn:sequenceFlow id="P16_flujo_2" sourceRef="P16_ord" targetRef="P16_diag" />
    <bpmn:sequenceFlow id="P16_flujo_3" sourceRef="P16_diag" targetRef="P16_pres" />
    <bpmn:sequenceFlow id="P16_flujo_4" sourceRef="P16_pres" targetRef="P16_esp" />
    <bpmn:sequenceFlow id="P16_flujo_5" sourceRef="P16_esp" targetRef="P16_resp" />
    <bpmn:sequenceFlow id="P16_flujo_6" sourceRef="P16_resp" targetRef="P16_gap" />
    <bpmn:sequenceFlow id="P16_flujo_7" name="Sí" sourceRef="P16_gap" targetRef="P16_rep" />
    <bpmn:sequenceFlow id="P16_flujo_8" name="No" sourceRef="P16_gap" targetRef="P16_can" />
    <bpmn:sequenceFlow id="P16_flujo_9" sourceRef="P16_can" targetRef="P16_fc" />
    <bpmn:sequenceFlow id="P16_flujo_10" sourceRef="P16_rep" targetRef="P16_lis" />
    <bpmn:sequenceFlow id="P16_flujo_11" sourceRef="P16_lis" targetRef="P16_nv" />
    <bpmn:sequenceFlow id="P16_flujo_12" sourceRef="P16_nv" targetRef="P16_emi" />
    <bpmn:sequenceFlow id="P16_flujo_13" sourceRef="P16_emi" targetRef="P16_ent" />
    <bpmn:sequenceFlow id="P16_flujo_14" sourceRef="P16_ent" targetRef="P16_fin" />
    <bpmn:textAnnotation id="P16_nota_n1"><bpmn:text>El enlace no muestra RUT, notas internas ni el técnico.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P16_diagrama" name="P16 Servicio técnico">
    <bpmndi:BPMNPlane id="P16_plano" bpmnElement="P16_colaboracion">
      <bpmndi:BPMNShape id="P16_pool_cli_di" bpmnElement="P16_pool_cli" isHorizontal="true" bioc:stroke="#5f6368" bioc:fill="#f6f6f6" color:border-color="#5f6368" color:background-color="#f6f6f6"><dc:Bounds x="20" y="20" width="2422" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P16_pool_ae_di" bpmnElement="P16_pool_ae" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="20" y="148" width="2422" height="528" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P16_carril_rec_di" bpmnElement="P16_carril_rec" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="148" width="2392" height="132" /></bpmndi:BPMNShape>
