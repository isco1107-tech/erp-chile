      <bpmndi:BPMNShape id="P16_fc_di" bpmnElement="P16_fc" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="1599" y="592" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1557" y="634" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
