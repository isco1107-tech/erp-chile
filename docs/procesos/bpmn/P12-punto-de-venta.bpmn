<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P12_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P12_colaboracion">
    <bpmn:documentation>P12 Punto de venta: turno de caja. Apertura del turno, ventas con boleta, movimientos de efectivo y cierre con arqueo; la caja reporta su estado a la Supersuite.</bpmn:documentation>
    <bpmn:participant id="P12_pool_cli" name="Cliente en el local"></bpmn:participant>
    <bpmn:participant id="P12_pool_ae" name="Aether POS" processRef="P12_proc_ae"></bpmn:participant>
    <bpmn:participant id="P12_pool_ss" name="Supersuite"></bpmn:participant>
    <bpmn:messageFlow id="P12_mensaje_1" name="Productos y pago" sourceRef="P12_pool_cli" targetRef="P12_ven" />
    <bpmn:messageFlow id="P12_mensaje_2" name="Boleta o ticket" sourceRef="P12_tk" targetRef="P12_pool_cli" />
    <bpmn:messageFlow id="P12_mensaje_3" name="Latido: caja en línea" sourceRef="P12_lat" targetRef="P12_pool_ss" />
    <bpmn:messageFlow id="P12_mensaje_4" name="Apagado (sin alertas de noche)" sourceRef="P12_apg" targetRef="P12_pool_ss" />
  </bpmn:collaboration>
  <bpmn:process id="P12_proc_ae" name="Aether POS" isExecutable="false">
    <bpmn:laneSet id="P12_carriles_ae">
      <bpmn:lane id="P12_carril_caj" name="Cajero">
        <bpmn:flowNodeRef>P12_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_ab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_gm0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_ven</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_tk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_gmas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_mov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_arq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P12_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P12_lat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_em</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_cie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_gdif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_apg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P12_carril_sup" name="Supervisor">
        <bpmn:flowNodeRef>P12_rev</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P12_i" name="Comienza la jornada">
      <bpmn:outgoing>P12_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P12_ab" name="Abrir turno con fondo inicial">
      <bpmn:incoming>P12_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P12_lat" name="Turno abierto y latido de la caja">
      <bpmn:incoming>P12_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P12_gm0" name="">
      <bpmn:incoming>P12_flujo_3</bpmn:incoming>
      <bpmn:incoming>P12_flujo_8</bpmn:incoming>
      <bpmn:incoming>P12_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P12_ven" name="Registrar la venta y el medio de pago">
      <bpmn:incoming>P12_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P12_em" name="Emitir boleta: stock al PMP, cobro y asiento">
      <bpmn:incoming>P12_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P12_tk" name="Entregar boleta o ticket">
      <bpmn:incoming>P12_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P12_gmas" name="¿Qué sigue?">
      <bpmn:incoming>P12_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_8</bpmn:outgoing>
      <bpmn:outgoing>P12_flujo_9</bpmn:outgoing>
      <bpmn:outgoing>P12_flujo_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P12_mov" name="Registrar ingreso o retiro de efectivo">
      <bpmn:incoming>P12_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P12_arq" name="Contar el efectivo (arqueo)">
      <bpmn:incoming>P12_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P12_cie" name="Cerrar turno: contado frente a esperado">
      <bpmn:incoming>P12_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P12_gdif" name="¿Hay diferencia?">
      <bpmn:incoming>P12_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_14</bpmn:outgoing>
      <bpmn:outgoing>P12_flujo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P12_rev" name="Revisar y justificar la diferencia">
      <bpmn:incoming>P12_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P12_gm" name="">
      <bpmn:incoming>P12_flujo_15</bpmn:incoming>
      <bpmn:incoming>P12_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P12_apg" name="Avisar apagado de la caja">
      <bpmn:incoming>P12_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P12_flujo_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P12_fin" name="Turno cerrado">
      <bpmn:incoming>P12_flujo_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P12_flujo_1" sourceRef="P12_i" targetRef="P12_ab" />
    <bpmn:sequenceFlow id="P12_flujo_2" sourceRef="P12_ab" targetRef="P12_lat" />
    <bpmn:sequenceFlow id="P12_flujo_3" sourceRef="P12_lat" targetRef="P12_gm0" />
    <bpmn:sequenceFlow id="P12_flujo_4" sourceRef="P12_gm0" targetRef="P12_ven" />
    <bpmn:sequenceFlow id="P12_flujo_5" sourceRef="P12_ven" targetRef="P12_em" />
    <bpmn:sequenceFlow id="P12_flujo_6" sourceRef="P12_em" targetRef="P12_tk" />
    <bpmn:sequenceFlow id="P12_flujo_7" sourceRef="P12_tk" targetRef="P12_gmas" />
    <bpmn:sequenceFlow id="P12_flujo_8" name="Otra venta" sourceRef="P12_gmas" targetRef="P12_gm0" />
    <bpmn:sequenceFlow id="P12_flujo_9" name="Movimiento de caja" sourceRef="P12_gmas" targetRef="P12_mov" />
    <bpmn:sequenceFlow id="P12_flujo_10" sourceRef="P12_mov" targetRef="P12_gm0" />
    <bpmn:sequenceFlow id="P12_flujo_11" name="Cerrar caja" sourceRef="P12_gmas" targetRef="P12_arq" />
    <bpmn:sequenceFlow id="P12_flujo_12" sourceRef="P12_arq" targetRef="P12_cie" />
    <bpmn:sequenceFlow id="P12_flujo_13" sourceRef="P12_cie" targetRef="P12_gdif" />
    <bpmn:sequenceFlow id="P12_flujo_14" name="Sí" sourceRef="P12_gdif" targetRef="P12_rev" />
    <bpmn:sequenceFlow id="P12_flujo_15" name="No" sourceRef="P12_gdif" targetRef="P12_gm" />
    <bpmn:sequenceFlow id="P12_flujo_16" sourceRef="P12_rev" targetRef="P12_gm" />
    <bpmn:sequenceFlow id="P12_flujo_17" sourceRef="P12_gm" targetRef="P12_apg" />
    <bpmn:sequenceFlow id="P12_flujo_18" sourceRef="P12_apg" targetRef="P12_fin" />
    <bpmn:textAnnotation id="P12_nota_n1"><bpmn:text>Cada venta lleva idempotencyKey: un reintento no duplica la boleta.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P12_asoc_n1" associationDirection="None" sourceRef="P12_nota_n1" targetRef="P12_em" />
    <bpmn:textAnnotation id="P12_nota_n2"><bpmn:text>Con la pantalla del POS abierta, Aether manda un latido por minuto.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
