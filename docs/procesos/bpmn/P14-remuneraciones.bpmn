<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P14_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P14_colaboracion">
    <bpmn:documentation>P14 Remuneraciones. Período del mes con parámetros confirmados contra Previred, cálculo de liquidaciones, cierre con asiento y portal del trabajador.</bpmn:documentation>
    <bpmn:participant id="P14_pool_trab" name="Trabajadores"></bpmn:participant>
    <bpmn:participant id="P14_pool_ae" name="Aether ERP" processRef="P14_proc_ae"></bpmn:participant>
    <bpmn:participant id="P14_pool_prv" name="Previred"></bpmn:participant>
    <bpmn:messageFlow id="P14_mensaje_1" name="Liquidación de sueldo" sourceRef="P14_pub" targetRef="P14_pool_trab" />
    <bpmn:messageFlow id="P14_mensaje_2" name="Planilla de cotizaciones" sourceRef="P14_decl" targetRef="P14_pool_prv" />
  </bpmn:collaboration>
  <bpmn:process id="P14_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P14_carriles_ae">
      <bpmn:lane id="P14_carril_rrhh" name="Encargado de remuneraciones">
        <bpmn:flowNodeRef>P14_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_per</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_nov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_gok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_decl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P14_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P14_calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_gch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_cl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_pub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P14_carril_due" name="Dueño o Contador (payroll:close)">
        <bpmn:flowNodeRef>P14_cie</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P14_i" name="Cierre de mes">
      <bpmn:outgoing>P14_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P14_per" name="Crear el período del mes">
      <bpmn:incoming>P14_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P14_par" name="Confirmar UF, UTM, topes y tasas">
      <bpmn:incoming>P14_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P14_nov" name="Registrar ausencias, anticipos y préstamos">
      <bpmn:incoming>P14_flujo_3</bpmn:incoming>
      <bpmn:incoming>P14_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P14_calc" name="Calcular las liquidaciones">
      <bpmn:incoming>P14_flujo_4</bpmn:incoming>
      <bpmn:incoming>P14_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P14_rev" name="Revisar liquidaciones y planilla Excel">
      <bpmn:incoming>P14_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P14_gok" name="¿Correctas?">
      <bpmn:incoming>P14_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_7</bpmn:outgoing>
      <bpmn:outgoing>P14_flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P14_cie" name="Cerrar el período">
      <bpmn:incoming>P14_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P14_gch" name="¿Cambiaron anticipos o préstamos?">
      <bpmn:incoming>P14_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_10</bpmn:outgoing>
      <bpmn:outgoing>P14_flujo_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P14_cl" name="CLOSED, cuotas de préstamos y asiento contable">
      <bpmn:incoming>P14_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P14_pub" name="Liquidaciones en el portal del trabajador">
      <bpmn:incoming>P14_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P14_decl" name="Declarar y pagar cotizaciones">
      <bpmn:incoming>P14_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P14_pago" name="Pagar sueldos">
      <bpmn:incoming>P14_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P14_flujo_15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="P14_fin" name="Mes de remuneraciones cerrado">
      <bpmn:incoming>P14_flujo_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P14_flujo_1" sourceRef="P14_i" targetRef="P14_per" />
    <bpmn:sequenceFlow id="P14_flujo_2" sourceRef="P14_per" targetRef="P14_par" />
    <bpmn:sequenceFlow id="P14_flujo_3" sourceRef="P14_par" targetRef="P14_nov" />
    <bpmn:sequenceFlow id="P14_flujo_4" sourceRef="P14_nov" targetRef="P14_calc" />
    <bpmn:sequenceFlow id="P14_flujo_5" sourceRef="P14_calc" targetRef="P14_rev" />
    <bpmn:sequenceFlow id="P14_flujo_6" sourceRef="P14_rev" targetRef="P14_gok" />
    <bpmn:sequenceFlow id="P14_flujo_7" name="No" sourceRef="P14_gok" targetRef="P14_nov" />
    <bpmn:sequenceFlow id="P14_flujo_8" name="Sí" sourceRef="P14_gok" targetRef="P14_cie" />
    <bpmn:sequenceFlow id="P14_flujo_9" sourceRef="P14_cie" targetRef="P14_gch" />
    <bpmn:sequenceFlow id="P14_flujo_10" name="Sí: recalcular" sourceRef="P14_gch" targetRef="P14_calc" />
    <bpmn:sequenceFlow id="P14_flujo_11" name="No" sourceRef="P14_gch" targetRef="P14_cl" />
    <bpmn:sequenceFlow id="P14_flujo_12" sourceRef="P14_cl" targetRef="P14_pub" />
    <bpmn:sequenceFlow id="P14_flujo_13" sourceRef="P14_pub" targetRef="P14_decl" />
    <bpmn:sequenceFlow id="P14_flujo_14" sourceRef="P14_decl" targetRef="P14_pago" />
    <bpmn:sequenceFlow id="P14_flujo_15" sourceRef="P14_pago" targetRef="P14_fin" />
    <bpmn:textAnnotation id="P14_nota_n1"><bpmn:text>Los parámetros legales entran por pantalla cada mes: nunca están en el código.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P14_asoc_n1" associationDirection="None" sourceRef="P14_nota_n1" targetRef="P14_par" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P14_diagrama" name="P14 Remuneraciones">
    <bpmndi:BPMNPlane id="P14_plano" bpmnElement="P14_colaboracion">
      <bpmndi:BPMNShape id="P14_pool_trab_di" bpmnElement="P14_pool_trab" isHorizontal="true" bioc:stroke="#5f6368" bioc:fill="#f6f6f6" color:border-color="#5f6368" color:background-color="#f6f6f6"><dc:Bounds x="20" y="20" width="2600" height="72" /></bpmndi:BPMNShape>
