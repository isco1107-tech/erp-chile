      <bpmndi:BPMNEdge id="P01_flujo_11_di" bpmnElement="P01_flujo_11"><di:waypoint x="1617" y="503" /><di:waypoint x="1617" y="610" /><di:waypoint x="1777" y="610" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P01_flujo_12_di" bpmnElement="P01_flujo_12"><di:waypoint x="1813" y="478" /><di:waypoint x="1907" y="478" /></bpmndi:BPMNEdge>
