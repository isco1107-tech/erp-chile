      <bpmndi:BPMNShape id="P01_i_di" bpmnElement="P01_i" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="175" y="196" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="133" y="238" width="120" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
