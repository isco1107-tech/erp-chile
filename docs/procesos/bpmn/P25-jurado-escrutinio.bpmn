<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P25_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P25_colaboracion">
    <bpmn:documentation>P25 Evaluación del jurado y escrutinio. Rondas con criterios ponderados, votación del jurado por enlace, resultado recalculado, cortes y acta de escrutinio.</bpmn:documentation>
    <bpmn:participant id="P25_pool_ae" name="Aether ERP" processRef="P25_proc_ae"></bpmn:participant>
  </bpmn:collaboration>
  <bpmn:process id="P25_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P25_carriles_ae">
      <bpmn:lane id="P25_carril_dir" name="Director del certamen">
        <bpmn:flowNodeRef>P25_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_ron</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_asig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_abr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_cer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_gc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_reo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_gcor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_gsig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_win</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_pubr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P25_carril_jur" name="Jurado (acceso por enlace)">
        <bpmn:flowNodeRef>P25_pun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_env</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P25_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P25_bal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_cut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_acta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P25_i" name="Hay candidatas oficiales">
      <bpmn:outgoing>P25_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P25_ron" name="Crear la ronda y sus criterios">
      <bpmn:incoming>P25_flujo_1</bpmn:incoming>
      <bpmn:incoming>P25_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P25_asig" name="Asignar jurados (enlace propio)">
      <bpmn:incoming>P25_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P25_abr" name="Votar ahora: abrir la ronda">
      <bpmn:incoming>P25_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P25_bal" name="Equilibrar a 100 % y dejar la ronda en VOTING">
      <bpmn:incoming>P25_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P25_pun" name="Puntuar a cada candidata">
      <bpmn:incoming>P25_flujo_5</bpmn:incoming>
      <bpmn:incoming>P25_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P25_env" name="Enviar la planilla (SUBMITTED)">
      <bpmn:incoming>P25_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P25_cer" name="Cerrar la votación">
      <bpmn:incoming>P25_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P25_res" name="Calcular el resultado ponderado">
      <bpmn:incoming>P25_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P25_gc" name="¿Hay que corregir?">
      <bpmn:incoming>P25_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_10</bpmn:outgoing>
      <bpmn:outgoing>P25_flujo_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P25_reo" name="Reabrir la ronda">
      <bpmn:incoming>P25_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P25_gcor" name="¿Corte a N clasificadas?">
      <bpmn:incoming>P25_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_13</bpmn:outgoing>
      <bpmn:outgoing>P25_flujo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P25_cut" name="Avanzan las N mejores (FINALIST)">
      <bpmn:incoming>P25_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P25_gsig" name="¿Otra ronda?">
      <bpmn:incoming>P25_flujo_14</bpmn:incoming>
      <bpmn:incoming>P25_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_16</bpmn:outgoing>
      <bpmn:outgoing>P25_flujo_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P25_win" name="Proclamar a la ganadora (WINNER)">
      <bpmn:incoming>P25_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P25_acta" name="Acta de escrutinio en PDF">
      <bpmn:incoming>P25_flujo_18</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P25_pubr" name="Publicar resultados: micrositio, afiche y salón de la fama">
      <bpmn:incoming>P25_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P25_flujo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P25_fin" name="Certamen con ganadora">
      <bpmn:incoming>P25_flujo_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P25_flujo_1" sourceRef="P25_i" targetRef="P25_ron" />
    <bpmn:sequenceFlow id="P25_flujo_2" sourceRef="P25_ron" targetRef="P25_asig" />
    <bpmn:sequenceFlow id="P25_flujo_3" sourceRef="P25_asig" targetRef="P25_abr" />
    <bpmn:sequenceFlow id="P25_flujo_4" sourceRef="P25_abr" targetRef="P25_bal" />
    <bpmn:sequenceFlow id="P25_flujo_5" sourceRef="P25_bal" targetRef="P25_pun" />
    <bpmn:sequenceFlow id="P25_flujo_6" sourceRef="P25_pun" targetRef="P25_env" />
    <bpmn:sequenceFlow id="P25_flujo_7" sourceRef="P25_env" targetRef="P25_cer" />
    <bpmn:sequenceFlow id="P25_flujo_8" sourceRef="P25_cer" targetRef="P25_res" />
    <bpmn:sequenceFlow id="P25_flujo_9" sourceRef="P25_res" targetRef="P25_gc" />
    <bpmn:sequenceFlow id="P25_flujo_10" name="Sí" sourceRef="P25_gc" targetRef="P25_reo" />
    <bpmn:sequenceFlow id="P25_flujo_11" sourceRef="P25_reo" targetRef="P25_pun" />
    <bpmn:sequenceFlow id="P25_flujo_12" name="No" sourceRef="P25_gc" targetRef="P25_gcor" />
    <bpmn:sequenceFlow id="P25_flujo_13" name="Sí" sourceRef="P25_gcor" targetRef="P25_cut" />
    <bpmn:sequenceFlow id="P25_flujo_14" name="No" sourceRef="P25_gcor" targetRef="P25_gsig" />
    <bpmn:sequenceFlow id="P25_flujo_15" sourceRef="P25_cut" targetRef="P25_gsig" />
    <bpmn:sequenceFlow id="P25_flujo_16" name="Sí" sourceRef="P25_gsig" targetRef="P25_ron" />
    <bpmn:sequenceFlow id="P25_flujo_17" name="No" sourceRef="P25_gsig" targetRef="P25_win" />
    <bpmn:sequenceFlow id="P25_flujo_18" sourceRef="P25_win" targetRef="P25_acta" />
    <bpmn:sequenceFlow id="P25_flujo_19" sourceRef="P25_acta" targetRef="P25_pubr" />
    <bpmn:sequenceFlow id="P25_flujo_20" sourceRef="P25_pubr" targetRef="P25_fin" />
    <bpmn:textAnnotation id="P25_nota_n1"><bpmn:text>El resultado se recalcula en cada consulta; nunca se guarda.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P25_asoc_n1" associationDirection="None" sourceRef="P25_nota_n1" targetRef="P25_res" />
    <bpmn:textAnnotation id="P25_nota_n2"><bpmn:text>Una ronda que ya entró en votación no se borra: se reabre para corregir.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
