<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P32_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P32_colaboracion">
    <bpmn:documentation>P32 Academia: inscripción, clases y material. Inscripción por link público, aprobación, grupo, calendario semanal, lista de asistencia, material por correo y mensualidades.</bpmn:documentation>
    <bpmn:participant id="P32_pool_apod" name="Apoderada o alumna"></bpmn:participant>
    <bpmn:participant id="P32_pool_ae" name="Aether ERP" processRef="P32_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P32_mensaje_1" name="Formulario de inscripción" sourceRef="P32_pool_apod" targetRef="P32_i" />
    <bpmn:messageFlow id="P32_mensaje_2" name="Correo con botón de descarga" sourceRef="P32_res" targetRef="P32_pool_apod" />
  </bpmn:collaboration>
  <bpmn:process id="P32_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P32_carriles_ae">
      <bpmn:lane id="P32_carril_dir" name="Dirección de la academia">
        <bpmn:flowNodeRef>P32_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_rj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_alu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_cal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mens</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P32_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P32_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_ses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_res</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P32_carril_prof" name="Profesora">
        <bpmn:flowNodeRef>P32_tc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_lis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_env</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P32_i" name="Inscripción por el link público">
      <bpmn:outgoing>P32_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P32_val" name="Validar y crear la solicitud PENDING">
      <bpmn:incoming>P32_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P32_rev" name="Revisar la solicitud">
      <bpmn:incoming>P32_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P32_gd" name="¿Aprueba?">
      <bpmn:incoming>P32_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_4</bpmn:outgoing>
      <bpmn:outgoing>P32_flujo_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P32_rj" name="Solicitud rechazada">
      <bpmn:incoming>P32_flujo_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P32_alu" name="Crear la ficha de la alumna y asignarle un grupo">
      <bpmn:incoming>P32_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P32_cal" name="Programar clases: serie semanal (hasta 60)">
      <bpmn:incoming>P32_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P32_ses" name="Crear las clases: una por grupo y día">
      <bpmn:incoming>P32_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="P32_tc" name="Día de la clase">
      <bpmn:incoming>P32_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_9</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P32_lis" name="Pasar lista">
      <bpmn:incoming>P32_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P32_mat" name="Subir material: archivo de hasta 4 MB o enlace">
      <bpmn:incoming>P32_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P32_env" name="Enviar el material al grupo">
      <bpmn:incoming>P32_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P32_res" name="Reservar el envío y mandarlo sin repetir direcciones">
      <bpmn:incoming>P32_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P32_mens" name="Registrar las mensualidades pagadas">
      <bpmn:incoming>P32_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P32_flujo_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P32_fin" name="Mes de clases al día">
      <bpmn:incoming>P32_flujo_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P32_flujo_1" sourceRef="P32_i" targetRef="P32_val" />
    <bpmn:sequenceFlow id="P32_flujo_2" sourceRef="P32_val" targetRef="P32_rev" />
    <bpmn:sequenceFlow id="P32_flujo_3" sourceRef="P32_rev" targetRef="P32_gd" />
    <bpmn:sequenceFlow id="P32_flujo_4" name="Sí" sourceRef="P32_gd" targetRef="P32_alu" />
    <bpmn:sequenceFlow id="P32_flujo_5" name="No" sourceRef="P32_gd" targetRef="P32_rj" />
    <bpmn:sequenceFlow id="P32_flujo_6" sourceRef="P32_alu" targetRef="P32_cal" />
    <bpmn:sequenceFlow id="P32_flujo_7" sourceRef="P32_cal" targetRef="P32_ses" />
    <bpmn:sequenceFlow id="P32_flujo_8" sourceRef="P32_ses" targetRef="P32_tc" />
    <bpmn:sequenceFlow id="P32_flujo_9" sourceRef="P32_tc" targetRef="P32_lis" />
    <bpmn:sequenceFlow id="P32_flujo_10" sourceRef="P32_lis" targetRef="P32_mat" />
    <bpmn:sequenceFlow id="P32_flujo_11" sourceRef="P32_mat" targetRef="P32_env" />
    <bpmn:sequenceFlow id="P32_flujo_12" sourceRef="P32_env" targetRef="P32_res" />
    <bpmn:sequenceFlow id="P32_flujo_13" sourceRef="P32_res" targetRef="P32_mens" />
    <bpmn:sequenceFlow id="P32_flujo_14" sourceRef="P32_mens" targetRef="P32_fin" />
    <bpmn:textAnnotation id="P32_nota_n1"><bpmn:text>Los días se guardan como YYYY-MM-DD a las 12:00 UTC; &quot;hoy&quot; lo manda el navegador.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P32_asoc_n1" associationDirection="None" sourceRef="P32_nota_n1" targetRef="P32_lis" />
    <bpmn:textAnnotation id="P32_nota_n2"><bpmn:text>El sitio público de la academia nunca muestra RUT, contactos, asistencia ni pagos.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P32_nota_n3"><bpmn:text>Una clase cancelada no admite lista; borrar una clase no borra la asistencia.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P32_diagrama" name="P32 Academia: inscripción, clases y material">
    <bpmndi:BPMNPlane id="P32_plano" bpmnElement="P32_colaboracion">
      <bpmndi:BPMNShape id="P32_pool_apod_di" bpmnElement="P32_pool_apod" isHorizontal="true" bioc:stroke="#5f6368" bioc:fill="#f6f6f6" color:border-color="#5f6368" color:background-color="#f6f6f6"><dc:Bounds x="20" y="20" width="2600" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P32_pool_ae_di" bpmnElement="P32_pool_ae" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="20" y="148" width="2600" height="792" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P32_carril_dir_di" bpmnElement="P32_carril_dir" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="148" width="2570" height="264" /></bpmndi:BPMNShape>
