<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P26_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P26_colaboracion">
    <bpmn:documentation>P26 Gala final en vivo (escaleta). Escaleta, vestuario, acreditación y ensayo en paralelo; luego el modo show recorre los segmentos e intercala las rondas del jurado.</bpmn:documentation>
    <bpmn:participant id="P26_pool_ae" name="Aether ERP" processRef="P26_proc_ae"></bpmn:participant>
  </bpmn:collaboration>
  <bpmn:process id="P26_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P26_carriles_ae">
      <bpmn:lane id="P26_carril_dir" name="Director de show">
        <bpmn:flowNodeRef>P26_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_gp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_ens</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_gj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_gt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_dn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_sk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_gm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_gq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_cor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P26_carril_back" name="Backstage: vestuario y acreditación">
        <bpmn:flowNodeRef>P26_ves</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_acr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P26_carril_sis" name="Sistema Aether (modo show)">
        <bpmn:flowNodeRef>P26_seg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P26_carril_jur" name="Jurado">
        <bpmn:flowNodeRef>P26_pun</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P26_i" name="Se acerca la gala">
      <bpmn:outgoing>P26_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P26_esc" name="Armar la escaleta: segmentos, tiempos y responsables">
      <bpmn:incoming>P26_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P26_gp" name="">
      <bpmn:incoming>P26_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P26_flujo_4</bpmn:outgoing>
      <bpmn:outgoing>P26_flujo_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="P26_ves" name="Asignar vestuario por segmento">
      <bpmn:incoming>P26_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P26_acr" name="Acreditar staff, prensa e invitados">
      <bpmn:incoming>P26_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P26_ens" name="Ensayo general">
      <bpmn:incoming>P26_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P26_gj" name="">
      <bpmn:incoming>P26_flujo_6</bpmn:incoming>
      <bpmn:incoming>P26_flujo_7</bpmn:incoming>
      <bpmn:incoming>P26_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="P26_show" name="Activar el modo show">
      <bpmn:incoming>P26_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P26_seg" name="Mostrar el segmento actual y el siguiente">
      <bpmn:incoming>P26_flujo_10</bpmn:incoming>
      <bpmn:incoming>P26_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P26_gt" name="¿Cómo termina?">
      <bpmn:incoming>P26_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_12</bpmn:outgoing>
      <bpmn:outgoing>P26_flujo_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P26_dn" name="Marcar DONE">
      <bpmn:incoming>P26_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P26_sk" name="Marcar SKIPPED">
      <bpmn:incoming>P26_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P26_gm" name="">
      <bpmn:incoming>P26_flujo_14</bpmn:incoming>
      <bpmn:incoming>P26_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P26_gr" name="¿Segmento de jurado?">
      <bpmn:incoming>P26_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_17</bpmn:outgoing>
      <bpmn:outgoing>P26_flujo_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="P26_pun" name="P25 Ronda de jurado" triggeredByEvent="false">
      <bpmn:incoming>P26_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_19</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="P26_gm2" name="">
      <bpmn:incoming>P26_flujo_18</bpmn:incoming>
      <bpmn:incoming>P26_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P26_gq" name="¿Quedan segmentos?">
      <bpmn:incoming>P26_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_21</bpmn:outgoing>
      <bpmn:outgoing>P26_flujo_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P26_cor" name="Coronación y cierre">
      <bpmn:incoming>P26_flujo_22</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P26_fin" name="Gala terminada">
      <bpmn:incoming>P26_flujo_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P26_flujo_1" sourceRef="P26_i" targetRef="P26_esc" />
    <bpmn:sequenceFlow id="P26_flujo_2" sourceRef="P26_esc" targetRef="P26_gp" />
    <bpmn:sequenceFlow id="P26_flujo_3" sourceRef="P26_gp" targetRef="P26_ves" />
    <bpmn:sequenceFlow id="P26_flujo_4" sourceRef="P26_gp" targetRef="P26_acr" />
    <bpmn:sequenceFlow id="P26_flujo_5" sourceRef="P26_gp" targetRef="P26_ens" />
    <bpmn:sequenceFlow id="P26_flujo_6" sourceRef="P26_ves" targetRef="P26_gj" />
    <bpmn:sequenceFlow id="P26_flujo_7" sourceRef="P26_acr" targetRef="P26_gj" />
    <bpmn:sequenceFlow id="P26_flujo_8" sourceRef="P26_ens" targetRef="P26_gj" />
    <bpmn:sequenceFlow id="P26_flujo_9" sourceRef="P26_gj" targetRef="P26_show" />
    <bpmn:sequenceFlow id="P26_flujo_10" sourceRef="P26_show" targetRef="P26_seg" />
    <bpmn:sequenceFlow id="P26_flujo_11" sourceRef="P26_seg" targetRef="P26_gt" />
    <bpmn:sequenceFlow id="P26_flujo_12" name="Se hizo" sourceRef="P26_gt" targetRef="P26_dn" />
    <bpmn:sequenceFlow id="P26_flujo_13" name="Se salta" sourceRef="P26_gt" targetRef="P26_sk" />
    <bpmn:sequenceFlow id="P26_flujo_14" sourceRef="P26_dn" targetRef="P26_gm" />
    <bpmn:sequenceFlow id="P26_flujo_15" sourceRef="P26_sk" targetRef="P26_gm" />
    <bpmn:sequenceFlow id="P26_flujo_16" sourceRef="P26_gm" targetRef="P26_gr" />
    <bpmn:sequenceFlow id="P26_flujo_17" name="Sí" sourceRef="P26_gr" targetRef="P26_pun" />
    <bpmn:sequenceFlow id="P26_flujo_18" name="No" sourceRef="P26_gr" targetRef="P26_gm2" />
    <bpmn:sequenceFlow id="P26_flujo_19" sourceRef="P26_pun" targetRef="P26_gm2" />
    <bpmn:sequenceFlow id="P26_flujo_20" sourceRef="P26_gm2" targetRef="P26_gq" />
    <bpmn:sequenceFlow id="P26_flujo_21" name="Sí" sourceRef="P26_gq" targetRef="P26_seg" />
    <bpmn:sequenceFlow id="P26_flujo_22" name="No" sourceRef="P26_gq" targetRef="P26_cor" />
    <bpmn:sequenceFlow id="P26_flujo_23" sourceRef="P26_cor" targetRef="P26_fin" />
    <bpmn:textAnnotation id="P26_nota_n1"><bpmn:text>Cada segmento: PENDING → IN_PROGRESS → DONE o SKIPPED.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P26_nota_n2"><bpmn:text>En la puerta, el público entra con el QR de su entrada (P23).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
