<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P31_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P31_colaboracion">
    <bpmn:documentation>P31 Formularios del sitio con destino en el ERP. Cada envío se valida contra el formulario publicado, queda siempre en la bandeja y además llega al CRM, la academia o las tareas.</bpmn:documentation>
    <bpmn:participant id="P31_pool_vis" name="Visitante"></bpmn:participant>
    <bpmn:participant id="P31_pool_ae" name="Aether ERP" processRef="P31_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P31_mensaje_1" name="Envío del formulario" sourceRef="P31_pool_vis" targetRef="P31_i" />
    <bpmn:messageFlow id="P31_mensaje_2" name="Confirmación" sourceRef="P31_ok" targetRef="P31_pool_vis" />
  </bpmn:collaboration>
  <bpmn:process id="P31_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P31_carriles_ae">
      <bpmn:lane id="P31_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P31_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_lim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_fnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_vld</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_gv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_gdest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_gmD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_ntf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P31_carril_dest" name="Módulo de destino">
        <bpmn:flowNodeRef>P31_lead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_aca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_tsk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P31_carril_eq" name="Equipo de la empresa">
        <bpmn:flowNodeRef>P31_bi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_man</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_arc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P31_fe</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P31_i" name="Llega { formId, answers }">
      <bpmn:outgoing>P31_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P31_lim" name="Límite por IP y por sitio; señuelo">
      <bpmn:incoming>P31_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P31_fnd" name="Buscar el formulario publicado del sitio">
      <bpmn:incoming>P31_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="P31_vld" name="Validar las respuestas contra sus preguntas">
      <bpmn:incoming>P31_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="P31_gv" name="¿Válido?">
      <bpmn:incoming>P31_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_5</bpmn:outgoing>
      <bpmn:outgoing>P31_flujo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P31_rech" name="Rechazado con el error">
      <bpmn:incoming>P31_flujo_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P31_msg" name="Guardar siempre en la bandeja">
      <bpmn:incoming>P31_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P31_gdest" name="¿Destino del formulario?">
      <bpmn:documentation>Sin el módulo del destino, queda solo en la bandeja con routeNote.</bpmn:documentation>
      <bpmn:incoming>P31_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_8</bpmn:outgoing>
      <bpmn:outgoing>P31_flujo_9</bpmn:outgoing>
      <bpmn:outgoing>P31_flujo_10</bpmn:outgoing>
      <bpmn:outgoing>P31_flujo_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P31_lead" name="CRM: persona, oportunidad Prospecto y recordatorio">
      <bpmn:incoming>P31_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P31_aca" name="Academia: postulación validada">
      <bpmn:incoming>P31_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P31_tsk" name="Tareas: tarea sin responsable">
      <bpmn:incoming>P31_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P31_gmD" name="">
      <bpmn:incoming>P31_flujo_8</bpmn:incoming>
      <bpmn:incoming>P31_flujo_12</bpmn:incoming>
      <bpmn:incoming>P31_flujo_13</bpmn:incoming>
      <bpmn:incoming>P31_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P31_link" name="Enlazar el mensaje con lo creado">
      <bpmn:incoming>P31_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P31_ntf" name="Campanita y disparador WEB_SITE_MESSAGE_RECEIVED">
      <bpmn:incoming>P31_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P31_ok" name="Gracias al visitante">
      <bpmn:incoming>P31_flujo_17</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:startEvent id="P31_bi" name="Revisa la bandeja">
      <bpmn:outgoing>P31_flujo_18</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="P31_gr" name="¿Qué hace?">
      <bpmn:incoming>P31_flujo_18</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_19</bpmn:outgoing>
      <bpmn:outgoing>P31_flujo_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P31_man" name="Llevarlo a un destino a mano">
      <bpmn:incoming>P31_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P31_arc" name="Archivar o exportar a Excel">
      <bpmn:incoming>P31_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P31_gm" name="">
      <bpmn:incoming>P31_flujo_21</bpmn:incoming>
      <bpmn:incoming>P31_flujo_22</bpmn:incoming>
      <bpmn:outgoing>P31_flujo_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P31_fe" name="Bandeja al día">
      <bpmn:incoming>P31_flujo_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P31_flujo_1" sourceRef="P31_i" targetRef="P31_lim" />
    <bpmn:sequenceFlow id="P31_flujo_2" sourceRef="P31_lim" targetRef="P31_fnd" />
    <bpmn:sequenceFlow id="P31_flujo_3" sourceRef="P31_fnd" targetRef="P31_vld" />
    <bpmn:sequenceFlow id="P31_flujo_4" sourceRef="P31_vld" targetRef="P31_gv" />
    <bpmn:sequenceFlow id="P31_flujo_5" name="Sí" sourceRef="P31_gv" targetRef="P31_msg" />
    <bpmn:sequenceFlow id="P31_flujo_6" name="No" sourceRef="P31_gv" targetRef="P31_rech" />
    <bpmn:sequenceFlow id="P31_flujo_7" sourceRef="P31_msg" targetRef="P31_gdest" />
    <bpmn:sequenceFlow id="P31_flujo_8" name="Solo bandeja" sourceRef="P31_gdest" targetRef="P31_gmD" />
    <bpmn:sequenceFlow id="P31_flujo_9" name="CRM" sourceRef="P31_gdest" targetRef="P31_lead" />
    <bpmn:sequenceFlow id="P31_flujo_10" name="Academia" sourceRef="P31_gdest" targetRef="P31_aca" />
    <bpmn:sequenceFlow id="P31_flujo_11" name="Tareas" sourceRef="P31_gdest" targetRef="P31_tsk" />
    <bpmn:sequenceFlow id="P31_flujo_12" sourceRef="P31_lead" targetRef="P31_gmD" />
    <bpmn:sequenceFlow id="P31_flujo_13" sourceRef="P31_aca" targetRef="P31_gmD" />
    <bpmn:sequenceFlow id="P31_flujo_14" sourceRef="P31_tsk" targetRef="P31_gmD" />
    <bpmn:sequenceFlow id="P31_flujo_15" sourceRef="P31_gmD" targetRef="P31_link" />
    <bpmn:sequenceFlow id="P31_flujo_16" sourceRef="P31_link" targetRef="P31_ntf" />
    <bpmn:sequenceFlow id="P31_flujo_17" sourceRef="P31_ntf" targetRef="P31_ok" />
    <bpmn:sequenceFlow id="P31_flujo_18" sourceRef="P31_bi" targetRef="P31_gr" />
    <bpmn:sequenceFlow id="P31_flujo_19" name="Mover" sourceRef="P31_gr" targetRef="P31_man" />
    <bpmn:sequenceFlow id="P31_flujo_20" name="Archivar o exportar" sourceRef="P31_gr" targetRef="P31_arc" />
    <bpmn:sequenceFlow id="P31_flujo_21" sourceRef="P31_man" targetRef="P31_gm" />
    <bpmn:sequenceFlow id="P31_flujo_22" sourceRef="P31_arc" targetRef="P31_gm" />
    <bpmn:sequenceFlow id="P31_flujo_23" sourceRef="P31_gm" targetRef="P31_fe" />
    <bpmn:textAnnotation id="P31_nota_n1"><bpmn:text>La empresa sale del sitio, nunca del cuerpo. Al navegador nunca viaja el rol de cada pregunta.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P31_nota_n2"><bpmn:text>Si el destino falla o no está contratado, el envío queda en la bandeja: nunca se pierde.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P31_nota_n3"><bpmn:text>A mano exige routePermission y reserva el mensaje con un updateMany condicionado.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P31_asoc_n3" associationDirection="None" sourceRef="P31_nota_n3" targetRef="P31_man" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P31_diagrama" name="P31 Formularios del sitio con destino en el ERP">
    <bpmndi:BPMNPlane id="P31_plano" bpmnElement="P31_colaboracion">
      <bpmndi:BPMNShape id="P31_pool_vis_di" bpmnElement="P31_pool_vis" isHorizontal="true" bioc:stroke="#5f6368" bioc:fill="#f6f6f6" color:border-color="#5f6368" color:background-color="#f6f6f6"><dc:Bounds x="20" y="20" width="2600" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P31_pool_ae_di" bpmnElement="P31_pool_ae" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="20" y="148" width="2600" height="1056" /></bpmndi:BPMNShape>
