<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P20_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P20_colaboracion">
    <bpmn:documentation>P20 Preparación y lanzamiento del certamen. Proyecto con presupuesto, convocatoria, micrositio, auspicios, entradas y jurado en paralelo, checklist del centro de mando y campaña.</bpmn:documentation>
    <bpmn:participant id="P20_pool_gente" name="Público"></bpmn:participant>
    <bpmn:participant id="P20_pool_ae" name="Aether ERP" processRef="P20_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P20_mensaje_1" name="Link y QR de postulación" sourceRef="P20_abr" targetRef="P20_pool_gente" />
    <bpmn:messageFlow id="P20_mensaje_2" name="/certamen/[slug]" sourceRef="P20_pub" targetRef="P20_pool_gente" />
    <bpmn:messageFlow id="P20_mensaje_3" name="Afiches en redes" sourceRef="P20_afi" targetRef="P20_pool_gente" />
  </bpmn:collaboration>
  <bpmn:process id="P20_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P20_carriles_ae">
      <bpmn:lane id="P20_carril_prod" name="Productora (projects:write)">
        <bpmn:flowNodeRef>P20_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_cre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_gp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_conv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_abr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_site</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_dom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_tick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_jur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_gj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_falt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_afi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P20_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P20_chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P20_gl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P20_i" name="Se decide hacer un certamen">
      <bpmn:outgoing>P20_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P20_cre" name="Crear el proyecto certamen con presupuesto">
      <bpmn:incoming>P20_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P20_gp" name="">
      <bpmn:incoming>P20_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P20_flujo_6</bpmn:outgoing>
      <bpmn:outgoing>P20_flujo_9</bpmn:outgoing>
      <bpmn:outgoing>P20_flujo_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="P20_conv" name="Configurar la convocatoria y el contacto público">
      <bpmn:incoming>P20_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P20_abr" name="Abrir postulaciones (link y QR)">
      <bpmn:incoming>P20_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P20_site" name="Armar el micrositio y el salón de la fama">
      <bpmn:incoming>P20_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="P20_dom" name="P33 Dominio propio (opcional)" triggeredByEvent="false">
      <bpmn:incoming>P20_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_8</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:userTask id="P20_pack" name="Copiar paquetes de auspicio al certamen">
      <bpmn:incoming>P20_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P20_tick" name="Tipos de entrada y link de votación">
      <bpmn:incoming>P20_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P20_jur" name="Definir rondas, criterios y jurado">
      <bpmn:incoming>P20_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P20_gj" name="">
      <bpmn:incoming>P20_flujo_5</bpmn:incoming>
      <bpmn:incoming>P20_flujo_8</bpmn:incoming>
      <bpmn:incoming>P20_flujo_11</bpmn:incoming>
      <bpmn:incoming>P20_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="P20_chk" name="Checklist del centro de mando">
      <bpmn:incoming>P20_flujo_14</bpmn:incoming>
      <bpmn:incoming>P20_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="P20_gl" name="¿Listo para lanzar?">
      <bpmn:incoming>P20_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_16</bpmn:outgoing>
      <bpmn:outgoing>P20_flujo_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P20_falt" name="Completar lo que indica el checklist">
      <bpmn:incoming>P20_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P20_pub" name="Publicar el micrositio">
      <bpmn:incoming>P20_flujo_18</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P20_afi" name="Generar los afiches de la campaña (ZIP)">
      <bpmn:documentation>10 piezas × 3 estilos × 5 formatos; QR al enlace real.</bpmn:documentation>
      <bpmn:incoming>P20_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P20_flujo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P20_fin" name="Certamen lanzado">
      <bpmn:incoming>P20_flujo_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P20_flujo_1" sourceRef="P20_i" targetRef="P20_cre" />
    <bpmn:sequenceFlow id="P20_flujo_2" sourceRef="P20_cre" targetRef="P20_gp" />
    <bpmn:sequenceFlow id="P20_flujo_3" sourceRef="P20_gp" targetRef="P20_conv" />
    <bpmn:sequenceFlow id="P20_flujo_4" sourceRef="P20_conv" targetRef="P20_abr" />
    <bpmn:sequenceFlow id="P20_flujo_5" sourceRef="P20_abr" targetRef="P20_gj" />
    <bpmn:sequenceFlow id="P20_flujo_6" sourceRef="P20_gp" targetRef="P20_site" />
    <bpmn:sequenceFlow id="P20_flujo_7" sourceRef="P20_site" targetRef="P20_dom" />
    <bpmn:sequenceFlow id="P20_flujo_8" sourceRef="P20_dom" targetRef="P20_gj" />
    <bpmn:sequenceFlow id="P20_flujo_9" sourceRef="P20_gp" targetRef="P20_pack" />
    <bpmn:sequenceFlow id="P20_flujo_10" sourceRef="P20_pack" targetRef="P20_tick" />
    <bpmn:sequenceFlow id="P20_flujo_11" sourceRef="P20_tick" targetRef="P20_gj" />
    <bpmn:sequenceFlow id="P20_flujo_12" sourceRef="P20_gp" targetRef="P20_jur" />
    <bpmn:sequenceFlow id="P20_flujo_13" sourceRef="P20_jur" targetRef="P20_gj" />
    <bpmn:sequenceFlow id="P20_flujo_14" sourceRef="P20_gj" targetRef="P20_chk" />
    <bpmn:sequenceFlow id="P20_flujo_15" sourceRef="P20_chk" targetRef="P20_gl" />
    <bpmn:sequenceFlow id="P20_flujo_16" name="No" sourceRef="P20_gl" targetRef="P20_falt" />
    <bpmn:sequenceFlow id="P20_flujo_17" sourceRef="P20_falt" targetRef="P20_chk" />
    <bpmn:sequenceFlow id="P20_flujo_18" name="Sí" sourceRef="P20_gl" targetRef="P20_pub" />
    <bpmn:sequenceFlow id="P20_flujo_19" sourceRef="P20_pub" targetRef="P20_afi" />
    <bpmn:sequenceFlow id="P20_flujo_20" sourceRef="P20_afi" targetRef="P20_fin" />
    <bpmn:textAnnotation id="P20_nota_n1"><bpmn:text>De una candidata solo sale nombre artístico, número, representación, foto y bio pública.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P20_nota_n2"><bpmn:text>Los afiches nunca inventan un dato: una pieza sin su dato no está disponible.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P20_asoc_n2" associationDirection="None" sourceRef="P20_nota_n2" targetRef="P20_afi" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P20_diagrama" name="P20 Preparación y lanzamiento del certamen">
