<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P15_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P15_colaboracion">
    <bpmn:documentation>P15 Rendición de gastos. El colaborador rinde lo que pagó, un aprobador decide y Tesorería reembolsa; lo rechazado vuelve a corregirse.</bpmn:documentation>
    <bpmn:participant id="P15_pool_ae" name="Aether ERP" processRef="P15_proc_ae"></bpmn:participant>
  </bpmn:collaboration>
  <bpmn:process id="P15_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P15_carriles_ae">
      <bpmn:lane id="P15_carril_col" name="Colaborador">
        <bpmn:flowNodeRef>P15_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_cre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_gmc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_env</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_corr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P15_carril_apr" name="Aprobador">
        <bpmn:flowNodeRef>P15_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_gd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P15_carril_tes" name="Tesorería">
        <bpmn:flowNodeRef>P15_rei</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P15_i" name="Pagó un gasto de la empresa">
      <bpmn:outgoing>P15_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P15_cre" name="Crear la rendición y agregar los gastos">
      <bpmn:incoming>P15_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P15_gmc" name="">
      <bpmn:incoming>P15_flujo_2</bpmn:incoming>
      <bpmn:incoming>P15_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P15_env" name="Enviar a aprobación (SUBMITTED)">
      <bpmn:incoming>P15_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P15_rev" name="Revisar la rendición">
      <bpmn:incoming>P15_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P15_gd" name="¿Aprueba?">
      <bpmn:incoming>P15_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_6</bpmn:outgoing>
      <bpmn:outgoing>P15_flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P15_corr" name="Corregir según las notas">
      <bpmn:incoming>P15_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P15_rei" name="Reembolsar y registrar la referencia">
      <bpmn:incoming>P15_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P15_fin" name="Rendición reembolsada">
      <bpmn:incoming>P15_flujo_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P15_flujo_1" sourceRef="P15_i" targetRef="P15_cre" />
    <bpmn:sequenceFlow id="P15_flujo_2" sourceRef="P15_cre" targetRef="P15_gmc" />
    <bpmn:sequenceFlow id="P15_flujo_3" sourceRef="P15_gmc" targetRef="P15_env" />
    <bpmn:sequenceFlow id="P15_flujo_4" sourceRef="P15_env" targetRef="P15_rev" />
    <bpmn:sequenceFlow id="P15_flujo_5" sourceRef="P15_rev" targetRef="P15_gd" />
    <bpmn:sequenceFlow id="P15_flujo_6" name="No" sourceRef="P15_gd" targetRef="P15_corr" />
    <bpmn:sequenceFlow id="P15_flujo_7" sourceRef="P15_corr" targetRef="P15_gmc" />
    <bpmn:sequenceFlow id="P15_flujo_8" name="Sí" sourceRef="P15_gd" targetRef="P15_rei" />
    <bpmn:sequenceFlow id="P15_flujo_9" sourceRef="P15_rei" targetRef="P15_fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P15_diagrama" name="P15 Rendición de gastos">
    <bpmndi:BPMNPlane id="P15_plano" bpmnElement="P15_colaboracion">
      <bpmndi:BPMNShape id="P15_pool_ae_di" bpmnElement="P15_pool_ae" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="20" y="20" width="1532" height="528" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_carril_col_di" bpmnElement="P15_carril_col" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="20" width="1502" height="264" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_carril_apr_di" bpmnElement="P15_carril_apr" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="284" width="1502" height="132" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_carril_tes_di" bpmnElement="P15_carril_tes" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="416" width="1502" height="132" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_i_di" bpmnElement="P15_i" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="175" y="68" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="133" y="110" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_cre_di" bpmnElement="P15_cre" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="305" y="44" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_gmc_di" bpmnElement="P15_gmc" isMarkerVisible="true" bioc:stroke="#8a6a00" bioc:fill="#fff1bf" color:border-color="#8a6a00" color:background-color="#fff1bf"><dc:Bounds x="524" y="61" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_env_di" bpmnElement="P15_env" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="661" y="44" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_rev_di" bpmnElement="P15_rev" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="839" y="308" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_gd_di" bpmnElement="P15_gd" isMarkerVisible="true" bioc:stroke="#8a6a00" bioc:fill="#fff1bf" color:border-color="#8a6a00" color:background-color="#fff1bf"><dc:Bounds x="1058" y="325" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1091" y="305" width="128" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_corr_di" bpmnElement="P15_corr" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="1195" y="176" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_rei_di" bpmnElement="P15_rei" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="1195" y="440" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_fin_di" bpmnElement="P15_fin" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="1421" y="464" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1379" y="506" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P15_flujo_1_di" bpmnElement="P15_flujo_1"><di:waypoint x="211" y="86" /><di:waypoint x="305" y="86" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P15_flujo_2_di" bpmnElement="P15_flujo_2"><di:waypoint x="437" y="86" /><di:waypoint x="524" y="86" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P15_flujo_3_di" bpmnElement="P15_flujo_3"><di:waypoint x="574" y="86" /><di:waypoint x="661" y="86" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P15_flujo_4_di" bpmnElement="P15_flujo_4"><di:waypoint x="793" y="86" /><di:waypoint x="816" y="86" /><di:waypoint x="816" y="350" /><di:waypoint x="839" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P15_flujo_5_di" bpmnElement="P15_flujo_5"><di:waypoint x="971" y="350" /><di:waypoint x="1058" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P15_flujo_6_di" bpmnElement="P15_flujo_6"><di:waypoint x="1083" y="325" /><di:waypoint x="1083" y="218" /><di:waypoint x="1195" y="218" /><bpmndi:BPMNLabel><dc:Bounds x="1089" y="224" width="30" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P15_flujo_7_di" bpmnElement="P15_flujo_7"><di:waypoint x="1261" y="260" /><di:waypoint x="1261" y="274" /><di:waypoint x="549" y="274" /><di:waypoint x="549" y="111" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P15_flujo_8_di" bpmnElement="P15_flujo_8"><di:waypoint x="1083" y="375" /><di:waypoint x="1083" y="482" /><di:waypoint x="1195" y="482" /><bpmndi:BPMNLabel><dc:Bounds x="1089" y="383" width="30" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P15_flujo_9_di" bpmnElement="P15_flujo_9"><di:waypoint x="1327" y="482" /><di:waypoint x="1421" y="482" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
