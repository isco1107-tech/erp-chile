<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P33_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P33_colaboracion">
    <bpmn:documentation>P33 Dominio propio. Conectar un dominio ya comprado a un certamen, sitio web o academia, y darlo por verificado solo cuando de verdad muestra la plataforma.</bpmn:documentation>
    <bpmn:participant id="P33_pool_vc" name="Vercel"></bpmn:participant>
    <bpmn:participant id="P33_pool_ae" name="Aether ERP" processRef="P33_proc_ae"></bpmn:participant>
    <bpmn:participant id="P33_pool_dnsp" name="Proveedor del dominio (DNS)"></bpmn:participant>
    <bpmn:messageFlow id="P33_mensaje_1" name="Agregar dominio" sourceRef="P33_att" targetRef="P33_pool_vc" />
    <bpmn:messageFlow id="P33_mensaje_2" name="Registros DNS" sourceRef="P33_dns" targetRef="P33_pool_dnsp" />
  </bpmn:collaboration>
  <bpmn:process id="P33_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P33_carriles_ae">
      <bpmn:lane id="P33_carril_adm" name="Administrador del sitio">
        <bpmn:flowNodeRef>P33_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_ing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_dns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_ver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_esp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P33_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P33_gt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_rch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_gtk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_att</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_avi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_inst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_ping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_gok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_okv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_red</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P33_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P33_i" name="Tiene un dominio comprado">
      <bpmn:outgoing>P33_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P33_ing" name="Ingresar el dominio (al crear el sitio o después)">
      <bpmn:incoming>P33_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P33_gt" name="¿Es de otro destino?">
      <bpmn:incoming>P33_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P33_flujo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P33_rch" name="Rechazado: un dominio es de un solo destino">
      <bpmn:incoming>P33_flujo_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P33_gtk" name="¿Hay VERCEL_API_TOKEN?">
      <bpmn:incoming>P33_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_5</bpmn:outgoing>
      <bpmn:outgoing>P33_flujo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P33_att" name="Agregar el dominio al proyecto en Vercel">
      <bpmn:incoming>P33_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P33_avi" name="Avisar: el administrador debe agregarlo en Vercel">
      <bpmn:incoming>P33_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P33_gm" name="">
      <bpmn:incoming>P33_flujo_7</bpmn:incoming>
      <bpmn:incoming>P33_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P33_inst" name="Mostrar los registros DNS a configurar">
      <bpmn:incoming>P33_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P33_dns" name="Configurar los DNS en su proveedor">
      <bpmn:incoming>P33_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P33_ver" name="Verificar">
      <bpmn:incoming>P33_flujo_11</bpmn:incoming>
      <bpmn:incoming>P33_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P33_ping" name="Pedir https://dominio/api/hosting/ping">
      <bpmn:incoming>P33_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P33_gok" name="¿Responde app: aether-erp?">
      <bpmn:incoming>P33_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_14</bpmn:outgoing>
      <bpmn:outgoing>P33_flujo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P33_esp" name="Revisar los DNS o el alta en Vercel">
      <bpmn:incoming>P33_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P33_okv" name="Marcar verificado">
      <bpmn:incoming>P33_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P33_red" name="El enlace de la plataforma redirige al dominio">
      <bpmn:incoming>P33_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P33_flujo_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P33_fin" name="Sitio en su dominio">
      <bpmn:incoming>P33_flujo_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P33_flujo_1" sourceRef="P33_i" targetRef="P33_ing" />
    <bpmn:sequenceFlow id="P33_flujo_2" sourceRef="P33_ing" targetRef="P33_gt" />
    <bpmn:sequenceFlow id="P33_flujo_3" name="No" sourceRef="P33_gt" targetRef="P33_gtk" />
    <bpmn:sequenceFlow id="P33_flujo_4" name="Sí" sourceRef="P33_gt" targetRef="P33_rch" />
    <bpmn:sequenceFlow id="P33_flujo_5" name="Sí" sourceRef="P33_gtk" targetRef="P33_att" />
    <bpmn:sequenceFlow id="P33_flujo_6" name="No" sourceRef="P33_gtk" targetRef="P33_avi" />
    <bpmn:sequenceFlow id="P33_flujo_7" sourceRef="P33_att" targetRef="P33_gm" />
    <bpmn:sequenceFlow id="P33_flujo_8" sourceRef="P33_avi" targetRef="P33_gm" />
    <bpmn:sequenceFlow id="P33_flujo_9" sourceRef="P33_gm" targetRef="P33_inst" />
    <bpmn:sequenceFlow id="P33_flujo_10" sourceRef="P33_inst" targetRef="P33_dns" />
    <bpmn:sequenceFlow id="P33_flujo_11" sourceRef="P33_dns" targetRef="P33_ver" />
    <bpmn:sequenceFlow id="P33_flujo_12" sourceRef="P33_ver" targetRef="P33_ping" />
    <bpmn:sequenceFlow id="P33_flujo_13" sourceRef="P33_ping" targetRef="P33_gok" />
    <bpmn:sequenceFlow id="P33_flujo_14" name="Sí" sourceRef="P33_gok" targetRef="P33_okv" />
    <bpmn:sequenceFlow id="P33_flujo_15" name="No" sourceRef="P33_gok" targetRef="P33_esp" />
    <bpmn:sequenceFlow id="P33_flujo_16" sourceRef="P33_esp" targetRef="P33_ver" />
    <bpmn:sequenceFlow id="P33_flujo_17" sourceRef="P33_okv" targetRef="P33_red" />
    <bpmn:sequenceFlow id="P33_flujo_18" sourceRef="P33_red" targetRef="P33_fin" />
    <bpmn:textAnnotation id="P33_nota_n1"><bpmn:text>Que los DNS apunten bien no basta: si el dominio no está agregado en Vercel, no muestra la plataforma.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P33_asoc_n1" associationDirection="None" sourceRef="P33_nota_n1" targetRef="P33_ping" />
  </bpmn:process>
