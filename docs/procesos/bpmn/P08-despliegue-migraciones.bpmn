<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P08_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P08_colaboracion">
    <bpmn:documentation>P08 Despliegue y migraciones. De la rama al aire: CI, revisión, migraciones aplicadas en el build de Vercel y la Supersuite en Render.</bpmn:documentation>
    <bpmn:participant id="P08_pool_ent" name="Entrega de Aether a producción" processRef="P08_proc_ent"></bpmn:participant>
    <bpmn:participant id="P08_pool_neon" name="Neon PostgreSQL (misma base que producción)"></bpmn:participant>
    <bpmn:participant id="P08_pool_rs" name="Supersuite en Render" processRef="P08_proc_rs"></bpmn:participant>
    <bpmn:messageFlow id="P08_mensaje_1" name="Leer esquema (sin aplicar)" sourceRef="P08_diff" targetRef="P08_pool_neon" />
    <bpmn:messageFlow id="P08_mensaje_2" name="SQL idempotente" sourceRef="P08_mg" targetRef="P08_pool_neon" />
  </bpmn:collaboration>
  <bpmn:process id="P08_proc_ent" name="Entrega de Aether a producción" isExecutable="false">
    <bpmn:laneSet id="P08_carriles_ent">
      <bpmn:lane id="P08_carril_dv" name="Desarrollador">
        <bpmn:flowNodeRef>P08_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_loc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_gmig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_diff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_pr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rev</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P08_carril_ci" name="GitHub Actions (CI)">
        <bpmn:flowNodeRef>P08_ci1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_ci2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_gci</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P08_carril_vc" name="Vercel: build de producción">
        <bpmn:flowNodeRef>P08_vb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_mg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_gmo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_falla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_ff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_cmp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_fok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P08_i" name="Cambio listo en una rama">
      <bpmn:outgoing>P08_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P08_loc" name="Correr npm run ci">
      <bpmn:incoming>P08_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P08_gmig" name="¿Cambia el esquema?">
      <bpmn:incoming>P08_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P08_flujo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P08_diff" name="Revisar el SQL con migrate diff (aditivo, idempotente)">
      <bpmn:incoming>P08_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P08_gm" name="">
      <bpmn:incoming>P08_flujo_4</bpmn:incoming>
      <bpmn:incoming>P08_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P08_pr" name="Abrir PR">
      <bpmn:incoming>P08_flujo_6</bpmn:incoming>
      <bpmn:incoming>P08_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P08_ci1" name="Validar Prisma, tipos, lint y pruebas">
      <bpmn:incoming>P08_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P08_ci2" name="Migrar desde cero, sin drift, semilla, build y E2E">
      <bpmn:incoming>P08_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P08_gci" name="¿Todo verde?">
      <bpmn:incoming>P08_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_10</bpmn:outgoing>
      <bpmn:outgoing>P08_flujo_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P08_fix" name="Corregir y subir">
      <bpmn:incoming>P08_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P08_rev" name="Revisar y fusionar a main">
      <bpmn:incoming>P08_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P08_vb" name="Build: prisma generate">
      <bpmn:incoming>P08_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P08_mg" name="Aplicar migraciones pendientes">
      <bpmn:documentation>scripts/migrate-deploy.mjs. Una marcada como fallida (P3009) se marca revertida y se reintenta.</bpmn:documentation>
      <bpmn:incoming>P08_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P08_gmo" name="¿Migraciones aplicadas?">
      <bpmn:incoming>P08_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_16</bpmn:outgoing>
      <bpmn:outgoing>P08_flujo_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P08_falla" name="El build falla: sigue la versión anterior">
      <bpmn:incoming>P08_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P08_ff" name="Despliegue rechazado">
      <bpmn:incoming>P08_flujo_18</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="P08_cmp" name="Compilar Next.js">
      <bpmn:incoming>P08_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P08_pub" name="Publicar en aetherp.online y activar crons">
      <bpmn:incoming>P08_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P08_fok" name="Producción actualizada">
      <bpmn:incoming>P08_flujo_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P08_flujo_1" sourceRef="P08_i" targetRef="P08_loc" />
    <bpmn:sequenceFlow id="P08_flujo_2" sourceRef="P08_loc" targetRef="P08_gmig" />
    <bpmn:sequenceFlow id="P08_flujo_3" name="Sí" sourceRef="P08_gmig" targetRef="P08_diff" />
    <bpmn:sequenceFlow id="P08_flujo_4" name="No" sourceRef="P08_gmig" targetRef="P08_gm" />
    <bpmn:sequenceFlow id="P08_flujo_5" sourceRef="P08_diff" targetRef="P08_gm" />
    <bpmn:sequenceFlow id="P08_flujo_6" sourceRef="P08_gm" targetRef="P08_pr" />
    <bpmn:sequenceFlow id="P08_flujo_7" sourceRef="P08_pr" targetRef="P08_ci1" />
    <bpmn:sequenceFlow id="P08_flujo_8" sourceRef="P08_ci1" targetRef="P08_ci2" />
    <bpmn:sequenceFlow id="P08_flujo_9" sourceRef="P08_ci2" targetRef="P08_gci" />
    <bpmn:sequenceFlow id="P08_flujo_10" name="No" sourceRef="P08_gci" targetRef="P08_fix" />
    <bpmn:sequenceFlow id="P08_flujo_11" sourceRef="P08_fix" targetRef="P08_pr" />
    <bpmn:sequenceFlow id="P08_flujo_12" name="Sí" sourceRef="P08_gci" targetRef="P08_rev" />
    <bpmn:sequenceFlow id="P08_flujo_13" sourceRef="P08_rev" targetRef="P08_vb" />
    <bpmn:sequenceFlow id="P08_flujo_14" sourceRef="P08_vb" targetRef="P08_mg" />
    <bpmn:sequenceFlow id="P08_flujo_15" sourceRef="P08_mg" targetRef="P08_gmo" />
    <bpmn:sequenceFlow id="P08_flujo_16" name="Sí" sourceRef="P08_gmo" targetRef="P08_cmp" />
    <bpmn:sequenceFlow id="P08_flujo_17" name="No" sourceRef="P08_gmo" targetRef="P08_falla" />
    <bpmn:sequenceFlow id="P08_flujo_18" sourceRef="P08_falla" targetRef="P08_ff" />
    <bpmn:sequenceFlow id="P08_flujo_19" sourceRef="P08_cmp" targetRef="P08_pub" />
    <bpmn:sequenceFlow id="P08_flujo_20" sourceRef="P08_pub" targetRef="P08_fok" />
    <bpmn:textAnnotation id="P08_nota_n1"><bpmn:text>La base local es la de producción: aplicar una migración obliga a desplegar enseguida.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P08_asoc_n1" associationDirection="None" sourceRef="P08_nota_n1" targetRef="P08_diff" />
  </bpmn:process>
  <bpmn:process id="P08_proc_rs" name="Supersuite en Render" isExecutable="false">
    <bpmn:laneSet id="P08_carriles_rs">
      <bpmn:lane id="P08_carril_rd" name="Blueprint render.yaml">
        <bpmn:flowNodeRef>P08_ri</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rpre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rgm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rfin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P08_ri" name="Push a main de la Supersuite">
      <bpmn:outgoing>P08_flujo_21</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P08_rpre" name="preDeploy: npm run db:migrar">
      <bpmn:incoming>P08_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P08_rgm" name="¿Migró?">
      <bpmn:incoming>P08_flujo_22</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_23</bpmn:outgoing>
      <bpmn:outgoing>P08_flujo_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P08_rf" name="Despliegue detenido">
      <bpmn:incoming>P08_flujo_24</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="P08_rup" name="Levantar API, worker y panel">
      <bpmn:incoming>P08_flujo_23</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P08_rfin" name="Supersuite actualizada">
      <bpmn:incoming>P08_flujo_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P08_flujo_21" sourceRef="P08_ri" targetRef="P08_rpre" />
    <bpmn:sequenceFlow id="P08_flujo_22" sourceRef="P08_rpre" targetRef="P08_rgm" />
    <bpmn:sequenceFlow id="P08_flujo_23" name="Sí" sourceRef="P08_rgm" targetRef="P08_rup" />
    <bpmn:sequenceFlow id="P08_flujo_24" name="No" sourceRef="P08_rgm" targetRef="P08_rf" />
    <bpmn:sequenceFlow id="P08_flujo_25" sourceRef="P08_rup" targetRef="P08_rfin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P08_diagrama" name="P08 Despliegue y migraciones">
    <bpmndi:BPMNPlane id="P08_plano" bpmnElement="P08_colaboracion">
      <bpmndi:BPMNShape id="P08_pool_ent_di" bpmnElement="P08_pool_ent" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="20" y="20" width="2956" height="792" /></bpmndi:BPMNShape>
