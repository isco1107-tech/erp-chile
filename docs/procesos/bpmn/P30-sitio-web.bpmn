<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P30_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P30_colaboracion">
    <bpmn:documentation>P30 Sitio web: de la plantilla a la publicación. Plantilla por propósito, edición guiada o HTML propio en borrador, lista de lo que falta y publicación revalidada en el servidor.</bpmn:documentation>
    <bpmn:participant id="P30_pool_vis" name="Visitantes"></bpmn:participant>
    <bpmn:participant id="P30_pool_ae" name="Aether ERP" processRef="P30_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P30_mensaje_1" name="/web/[slug] o su dominio" sourceRef="P30_cp" targetRef="P30_pool_vis" />
  </bpmn:collaboration>
  <bpmn:process id="P30_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P30_carriles_ae">
      <bpmn:lane id="P30_carril_ed" name="Editor del sitio">
        <bpmn:flowNodeRef>P30_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_pla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_gmo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_blo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_htm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_gm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_pub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P30_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P30_rdy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_gp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_cp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_dom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_gm3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_live</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P30_i" name="Necesita un sitio">
      <bpmn:outgoing>P30_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P30_pla" name="Elegir el propósito y la plantilla">
      <bpmn:incoming>P30_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P30_gmo" name="¿Qué modo?">
      <bpmn:incoming>P30_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P30_flujo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P30_blo" name="Editar secciones y diseños en el borrador">
      <bpmn:incoming>P30_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P30_htm" name="Pegar HTML propio">
      <bpmn:incoming>P30_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P30_gm2" name="">
      <bpmn:incoming>P30_flujo_5</bpmn:incoming>
      <bpmn:incoming>P30_flujo_6</bpmn:incoming>
      <bpmn:incoming>P30_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="P30_rdy" name="Calcular en vivo lo que le falta">
      <bpmn:incoming>P30_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="P30_pub" name="Publicar">
      <bpmn:incoming>P30_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P30_val" name="Revalidar en el servidor: lo que falta y los permisos">
      <bpmn:incoming>P30_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P30_gp" name="¿Se puede publicar?">
      <bpmn:incoming>P30_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_11</bpmn:outgoing>
      <bpmn:outgoing>P30_flujo_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P30_cp" name="Copiar el borrador a publicado (PUBLISHED)">
      <bpmn:incoming>P30_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P30_gd" name="¿Dominio propio?">
      <bpmn:incoming>P30_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_14</bpmn:outgoing>
      <bpmn:outgoing>P30_flujo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="P30_dom" name="P33 Dominio propio" triggeredByEvent="false">
      <bpmn:incoming>P30_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_16</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="P30_gm3" name="">
      <bpmn:incoming>P30_flujo_14</bpmn:incoming>
      <bpmn:incoming>P30_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P30_live" name="Sitio en línea">
      <bpmn:incoming>P30_flujo_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P30_flujo_1" sourceRef="P30_i" targetRef="P30_pla" />
    <bpmn:sequenceFlow id="P30_flujo_2" sourceRef="P30_pla" targetRef="P30_gmo" />
    <bpmn:sequenceFlow id="P30_flujo_3" name="Guiado" sourceRef="P30_gmo" targetRef="P30_blo" />
    <bpmn:sequenceFlow id="P30_flujo_4" name="HTML propio" sourceRef="P30_gmo" targetRef="P30_htm" />
    <bpmn:sequenceFlow id="P30_flujo_5" sourceRef="P30_blo" targetRef="P30_gm2" />
    <bpmn:sequenceFlow id="P30_flujo_6" sourceRef="P30_htm" targetRef="P30_gm2" />
    <bpmn:sequenceFlow id="P30_flujo_7" sourceRef="P30_gm2" targetRef="P30_rdy" />
    <bpmn:sequenceFlow id="P30_flujo_8" sourceRef="P30_rdy" targetRef="P30_pub" />
    <bpmn:sequenceFlow id="P30_flujo_9" sourceRef="P30_pub" targetRef="P30_val" />
    <bpmn:sequenceFlow id="P30_flujo_10" sourceRef="P30_val" targetRef="P30_gp" />
    <bpmn:sequenceFlow id="P30_flujo_11" name="Sí" sourceRef="P30_gp" targetRef="P30_cp" />
    <bpmn:sequenceFlow id="P30_flujo_12" name="No" sourceRef="P30_gp" targetRef="P30_gm2" />
    <bpmn:sequenceFlow id="P30_flujo_13" sourceRef="P30_cp" targetRef="P30_gd" />
    <bpmn:sequenceFlow id="P30_flujo_14" name="No" sourceRef="P30_gd" targetRef="P30_gm3" />
    <bpmn:sequenceFlow id="P30_flujo_15" name="Sí" sourceRef="P30_gd" targetRef="P30_dom" />
    <bpmn:sequenceFlow id="P30_flujo_16" sourceRef="P30_dom" targetRef="P30_gm3" />
    <bpmn:sequenceFlow id="P30_flujo_17" sourceRef="P30_gm3" targetRef="P30_live" />
    <bpmn:textAnnotation id="P30_nota_n1"><bpmn:text>El HTML propio solo se sirve con CSP sandbox, sin scripts, dentro de un iframe sandbox.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P30_nota_n2"><bpmn:text>Borrador y publicado son copias distintas: el público nunca ve el borrador.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P30_asoc_n2" associationDirection="None" sourceRef="P30_nota_n2" targetRef="P30_cp" />
  </bpmn:process>
