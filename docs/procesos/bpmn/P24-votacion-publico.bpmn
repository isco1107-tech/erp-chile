<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P24_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P24_colaboracion">
    <bpmn:documentation>P24 Votación del público. Orden de votos con el precio del link, pago confirmado por el staff y ranking en vivo solo con órdenes pagadas.</bpmn:documentation>
    <bpmn:participant id="P24_pool_vot" name="Votante"></bpmn:participant>
    <bpmn:participant id="P24_pool_ae" name="Aether ERP" processRef="P24_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P24_mensaje_1" name="Candidata y cantidad" sourceRef="P24_pool_vot" targetRef="P24_i" />
    <bpmn:messageFlow id="P24_mensaje_2" name="Instrucciones" sourceRef="P24_ins" targetRef="P24_pool_vot" />
    <bpmn:messageFlow id="P24_mensaje_3" name="Transferencia" sourceRef="P24_pool_vot" targetRef="P24_pago" />
    <bpmn:messageFlow id="P24_mensaje_4" name="Confirmación" sourceRef="P24_mail" targetRef="P24_pool_vot" />
  </bpmn:collaboration>
  <bpmn:process id="P24_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P24_carriles_ae">
      <bpmn:lane id="P24_carril_pub" name="Portal público de votación">
        <bpmn:flowNodeRef>P24_i</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P24_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P24_ord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P24_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P24_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P24_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P24_rk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P24_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P24_carril_staff" name="Staff del certamen">
        <bpmn:flowNodeRef>P24_ge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P24_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P24_nop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P24_elim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P24_fe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P24_conf</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P24_i" name="Elige candidata y cantidad de votos">
      <bpmn:outgoing>P24_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P24_ord" name="Crear la orden UNPAID con el precio del link">
      <bpmn:incoming>P24_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P24_flujo_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P24_ins" name="Mostrar datos para transferir">
      <bpmn:incoming>P24_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P24_flujo_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="P24_ge" name="">
      <bpmn:incoming>P24_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P24_flujo_4</bpmn:outgoing>
      <bpmn:outgoing>P24_flujo_5</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P24_pago" name="Llega la transferencia">
      <bpmn:incoming>P24_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P24_flujo_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P24_nop" name="No paga">
      <bpmn:incoming>P24_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P24_flujo_6</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P24_elim" name="Eliminar la orden">
      <bpmn:incoming>P24_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P24_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P24_fe" name="Orden descartada">
      <bpmn:incoming>P24_flujo_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P24_conf" name="Confirmar el pago">
      <bpmn:incoming>P24_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P24_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P24_paid" name="PAID: los votos cuentan">
      <bpmn:incoming>P24_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P24_flujo_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P24_mail" name="Confirmación al comprador">
      <bpmn:incoming>P24_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P24_flujo_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="P24_rk" name="Actualizar el ranking en vivo">
      <bpmn:incoming>P24_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P24_flujo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P24_fin" name="Votos contados">
      <bpmn:incoming>P24_flujo_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P24_flujo_1" sourceRef="P24_i" targetRef="P24_ord" />
    <bpmn:sequenceFlow id="P24_flujo_2" sourceRef="P24_ord" targetRef="P24_ins" />
    <bpmn:sequenceFlow id="P24_flujo_3" sourceRef="P24_ins" targetRef="P24_ge" />
    <bpmn:sequenceFlow id="P24_flujo_4" sourceRef="P24_ge" targetRef="P24_pago" />
    <bpmn:sequenceFlow id="P24_flujo_5" sourceRef="P24_ge" targetRef="P24_nop" />
    <bpmn:sequenceFlow id="P24_flujo_6" sourceRef="P24_nop" targetRef="P24_elim" />
    <bpmn:sequenceFlow id="P24_flujo_7" sourceRef="P24_elim" targetRef="P24_fe" />
    <bpmn:sequenceFlow id="P24_flujo_8" sourceRef="P24_pago" targetRef="P24_conf" />
    <bpmn:sequenceFlow id="P24_flujo_9" sourceRef="P24_conf" targetRef="P24_paid" />
    <bpmn:sequenceFlow id="P24_flujo_10" sourceRef="P24_paid" targetRef="P24_mail" />
    <bpmn:sequenceFlow id="P24_flujo_11" sourceRef="P24_mail" targetRef="P24_rk" />
    <bpmn:sequenceFlow id="P24_flujo_12" sourceRef="P24_rk" targetRef="P24_fin" />
    <bpmn:textAnnotation id="P24_nota_n1"><bpmn:text>El precio sale del link, nunca del formulario. Una orden sin pagar no es un voto.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P24_asoc_n1" associationDirection="None" sourceRef="P24_nota_n1" targetRef="P24_ord" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P24_diagrama" name="P24 Votación del público">
    <bpmndi:BPMNPlane id="P24_plano" bpmnElement="P24_colaboracion">
      <bpmndi:BPMNShape id="P24_pool_vot_di" bpmnElement="P24_pool_vot" isHorizontal="true" bioc:stroke="#5f6368" bioc:fill="#f6f6f6" color:border-color="#5f6368" color:background-color="#f6f6f6"><dc:Bounds x="20" y="20" width="1888" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_pool_ae_di" bpmnElement="P24_pool_ae" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="20" y="148" width="1888" height="660" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_carril_pub_di" bpmnElement="P24_carril_pub" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="148" width="1858" height="132" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_carril_sis_di" bpmnElement="P24_carril_sis" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="280" width="1858" height="264" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_carril_staff_di" bpmnElement="P24_carril_staff" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="544" width="1858" height="264" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_i_di" bpmnElement="P24_i" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="175" y="196" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="133" y="238" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
