      <bpmndi:BPMNShape id="P24_elim_di" bpmnElement="P24_elim" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="1017" y="700" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_fe_di" bpmnElement="P24_fe" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="1243" y="724" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1201" y="766" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_conf_di" bpmnElement="P24_conf" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="1017" y="568" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_paid_di" bpmnElement="P24_paid" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="1195" y="304" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_mail_di" bpmnElement="P24_mail" bioc:stroke="#5b3a9e" bioc:fill="#efe9fa" color:border-color="#5b3a9e" color:background-color="#efe9fa"><dc:Bounds x="1373" y="304" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_rk_di" bpmnElement="P24_rk" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="1551" y="304" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_fin_di" bpmnElement="P24_fin" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="1777" y="328" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1735" y="370" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
