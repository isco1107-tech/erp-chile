      <bpmndi:BPMNShape id="P24_ins_di" bpmnElement="P24_ins" bioc:stroke="#5b3a9e" bioc:fill="#efe9fa" color:border-color="#5b3a9e" color:background-color="#efe9fa"><dc:Bounds x="483" y="304" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_ge_di" bpmnElement="P24_ge" bioc:stroke="#8a6a00" bioc:fill="#fff1bf" color:border-color="#8a6a00" color:background-color="#fff1bf"><dc:Bounds x="702" y="585" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P24_pago_di" bpmnElement="P24_pago" bioc:stroke="#9a5b00" bioc:fill="#fff4dc" color:border-color="#9a5b00" color:background-color="#fff4dc"><dc:Bounds x="887" y="592" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="845" y="634" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
