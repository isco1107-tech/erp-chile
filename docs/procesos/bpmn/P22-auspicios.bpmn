<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P22_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P22_colaboracion">
    <bpmn:documentation>P22 Auspicios. De la propuesta con un paquete del tarifario al convenio firmado, los pagos y el cumplimiento de contraprestaciones.</bpmn:documentation>
    <bpmn:participant id="P22_pool_spo" name="Auspiciador"></bpmn:participant>
    <bpmn:participant id="P22_pool_ae" name="Aether ERP" processRef="P22_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P22_mensaje_1" name="Interés" sourceRef="P22_pool_spo" targetRef="P22_i" />
    <bpmn:messageFlow id="P22_mensaje_2" name="Propuesta" sourceRef="P22_ofr" targetRef="P22_pool_spo" />
    <bpmn:messageFlow id="P22_mensaje_3" name="Convenio para firmar" sourceRef="P22_fir" targetRef="P22_pool_spo" />
    <bpmn:messageFlow id="P22_mensaje_4" name="Pago" sourceRef="P22_pool_spo" targetRef="P22_cob" />
  </bpmn:collaboration>
  <bpmn:process id="P22_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P22_carriles_ae">
      <bpmn:lane id="P22_carril_com" name="Comercial del certamen">
        <bpmn:flowNodeRef>P22_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_ofr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_can</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_fcan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_fir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_cob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_cer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P22_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P22_prop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_pdf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_est</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_gp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P22_carril_prod" name="Producción">
        <bpmn:flowNodeRef>P22_cump</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P22_i" name="Interés de una marca">
      <bpmn:outgoing>P22_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="P22_ofr" name="Ofrecer un paquete del tarifario del certamen">
      <bpmn:incoming>P22_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P22_prop" name="Registrar el contrato en PROPOSAL">
      <bpmn:incoming>P22_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P22_neg" name="Negociar monto y contraprestaciones">
      <bpmn:incoming>P22_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P22_gd" name="¿Acepta?">
      <bpmn:incoming>P22_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_5</bpmn:outgoing>
      <bpmn:outgoing>P22_flujo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P22_can" name="Cancelar la propuesta">
      <bpmn:incoming>P22_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P22_fcan" name="Sin acuerdo">
      <bpmn:incoming>P22_flujo_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P22_conf" name="Confirmar el auspicio (CONFIRMED)">
      <bpmn:incoming>P22_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P22_pdf" name="Generar el convenio en PDF">
      <bpmn:incoming>P22_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P22_fir" name="Enviar el convenio y registrar la firma">
      <bpmn:incoming>P22_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P22_cob" name="Registrar un pago del auspicio">
      <bpmn:incoming>P22_flujo_10</bpmn:incoming>
      <bpmn:incoming>P22_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P22_est" name="Recalcular el estado de pago">
      <bpmn:incoming>P22_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P22_gp" name="¿Pagado completo?">
      <bpmn:incoming>P22_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_13</bpmn:outgoing>
      <bpmn:outgoing>P22_flujo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P22_cump" name="Cumplir contraprestaciones: logos, menciones y presencia">
      <bpmn:incoming>P22_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P22_cer" name="Cerrar el auspicio (COMPLETED)">
      <bpmn:incoming>P22_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P22_flujo_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P22_fin" name="Auspicio cumplido">
      <bpmn:incoming>P22_flujo_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P22_flujo_1" sourceRef="P22_i" targetRef="P22_ofr" />
    <bpmn:sequenceFlow id="P22_flujo_2" sourceRef="P22_ofr" targetRef="P22_prop" />
    <bpmn:sequenceFlow id="P22_flujo_3" sourceRef="P22_prop" targetRef="P22_neg" />
    <bpmn:sequenceFlow id="P22_flujo_4" sourceRef="P22_neg" targetRef="P22_gd" />
    <bpmn:sequenceFlow id="P22_flujo_5" name="Sí" sourceRef="P22_gd" targetRef="P22_conf" />
    <bpmn:sequenceFlow id="P22_flujo_6" name="No" sourceRef="P22_gd" targetRef="P22_can" />
    <bpmn:sequenceFlow id="P22_flujo_7" sourceRef="P22_can" targetRef="P22_fcan" />
    <bpmn:sequenceFlow id="P22_flujo_8" sourceRef="P22_conf" targetRef="P22_pdf" />
    <bpmn:sequenceFlow id="P22_flujo_9" sourceRef="P22_pdf" targetRef="P22_fir" />
    <bpmn:sequenceFlow id="P22_flujo_10" sourceRef="P22_fir" targetRef="P22_cob" />
    <bpmn:sequenceFlow id="P22_flujo_11" sourceRef="P22_cob" targetRef="P22_est" />
    <bpmn:sequenceFlow id="P22_flujo_12" sourceRef="P22_est" targetRef="P22_gp" />
    <bpmn:sequenceFlow id="P22_flujo_13" name="No: esperar el siguiente pago" sourceRef="P22_gp" targetRef="P22_cob" />
    <bpmn:sequenceFlow id="P22_flujo_14" name="Sí" sourceRef="P22_gp" targetRef="P22_cump" />
    <bpmn:sequenceFlow id="P22_flujo_15" sourceRef="P22_cump" targetRef="P22_cer" />
    <bpmn:sequenceFlow id="P22_flujo_16" sourceRef="P22_cer" targetRef="P22_fin" />
    <bpmn:textAnnotation id="P22_nota_n1"><bpmn:text>Un plan sin certamen es plantilla: no se publica ni se ofrece hasta copiarlo a un certamen.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P22_asoc_n1" associationDirection="None" sourceRef="P22_nota_n1" targetRef="P22_ofr" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P22_diagrama" name="P22 Auspicios">
    <bpmndi:BPMNPlane id="P22_plano" bpmnElement="P22_colaboracion">
      <bpmndi:BPMNShape id="P22_pool_spo_di" bpmnElement="P22_pool_spo" isHorizontal="true" bioc:stroke="#5f6368" bioc:fill="#f6f6f6" color:border-color="#5f6368" color:background-color="#f6f6f6"><dc:Bounds x="20" y="20" width="2600" height="72" /></bpmndi:BPMNShape>
