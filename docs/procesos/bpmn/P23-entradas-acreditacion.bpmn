<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P23_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P23_colaboracion">
    <bpmn:documentation>P23 Venta de entradas y control de acceso. Orden pública que reserva cupo, pago por transferencia confirmado por el staff, entrada con QR y lectura en la puerta.</bpmn:documentation>
    <bpmn:participant id="P23_pool_comp" name="Comprador"></bpmn:participant>
    <bpmn:participant id="P23_pool_ae" name="Aether ERP" processRef="P23_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P23_mensaje_1" name="Pedido" sourceRef="P23_pool_comp" targetRef="P23_i" />
    <bpmn:messageFlow id="P23_mensaje_2" name="Instrucciones de pago" sourceRef="P23_ins" targetRef="P23_pool_comp" />
    <bpmn:messageFlow id="P23_mensaje_3" name="Transferencia" sourceRef="P23_pool_comp" targetRef="P23_pago" />
    <bpmn:messageFlow id="P23_mensaje_4" name="Entrada con QR" sourceRef="P23_qr" targetRef="P23_pool_comp" />
  </bpmn:collaboration>
  <bpmn:process id="P23_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P23_carriles_ae">
      <bpmn:lane id="P23_carril_pub" name="Portal público de entradas">
        <bpmn:flowNodeRef>P23_i</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P23_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P23_lock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_gc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_agot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_st</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_qr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_wf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_gin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_ya</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P23_carril_staff" name="Staff del certamen">
        <bpmn:flowNodeRef>P23_ge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_nop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_lib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_flib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_dia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_chk</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P23_i" name="Elige tipo y cantidad">
      <bpmn:outgoing>P23_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P23_lock" name="Bloquear el cupo y crear la orden UNPAID">
      <bpmn:incoming>P23_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P23_gc" name="¿Queda cupo?">
      <bpmn:incoming>P23_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P23_flujo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P23_agot" name="Cupo agotado">
      <bpmn:incoming>P23_flujo_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="P23_ins" name="Mostrar datos para transferir">
      <bpmn:incoming>P23_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="P23_ge" name="">
      <bpmn:incoming>P23_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_6</bpmn:outgoing>
      <bpmn:outgoing>P23_flujo_7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P23_pago" name="Llega la transferencia">
      <bpmn:incoming>P23_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P23_nop" name="No paga">
      <bpmn:incoming>P23_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_8</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P23_lib" name="Cancelar la orden y liberar el cupo">
      <bpmn:incoming>P23_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P23_flib" name="Cupo liberado">
      <bpmn:incoming>P23_flujo_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P23_conf" name="Confirmar el pago en el panel">
      <bpmn:incoming>P23_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P23_st" name="Estado PAID, recalculado en el servidor">
      <bpmn:incoming>P23_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P23_qr" name="Enviar la entrada con QR">
      <bpmn:incoming>P23_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="P23_wf" name="Disparar la automatización de entrada pagada">
      <bpmn:incoming>P23_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="P23_dia" name="Día del evento">
      <bpmn:incoming>P23_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_15</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P23_chk" name="Escanear el QR en la puerta">
      <bpmn:incoming>P23_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P23_gin" name="¿Ya había ingresado?">
      <bpmn:incoming>P23_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_17</bpmn:outgoing>
      <bpmn:outgoing>P23_flujo_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P23_ya" name="Avisar: QR ya usado">
      <bpmn:incoming>P23_flujo_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P23_ok" name="Registrar el ingreso">
      <bpmn:incoming>P23_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P23_flujo_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P23_fin" name="Asistente adentro">
      <bpmn:incoming>P23_flujo_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P23_flujo_1" sourceRef="P23_i" targetRef="P23_lock" />
    <bpmn:sequenceFlow id="P23_flujo_2" sourceRef="P23_lock" targetRef="P23_gc" />
    <bpmn:sequenceFlow id="P23_flujo_3" name="Sí" sourceRef="P23_gc" targetRef="P23_ins" />
    <bpmn:sequenceFlow id="P23_flujo_4" name="No" sourceRef="P23_gc" targetRef="P23_agot" />
    <bpmn:sequenceFlow id="P23_flujo_5" sourceRef="P23_ins" targetRef="P23_ge" />
    <bpmn:sequenceFlow id="P23_flujo_6" sourceRef="P23_ge" targetRef="P23_pago" />
    <bpmn:sequenceFlow id="P23_flujo_7" sourceRef="P23_ge" targetRef="P23_nop" />
    <bpmn:sequenceFlow id="P23_flujo_8" sourceRef="P23_nop" targetRef="P23_lib" />
    <bpmn:sequenceFlow id="P23_flujo_9" sourceRef="P23_lib" targetRef="P23_flib" />
    <bpmn:sequenceFlow id="P23_flujo_10" sourceRef="P23_pago" targetRef="P23_conf" />
    <bpmn:sequenceFlow id="P23_flujo_11" sourceRef="P23_conf" targetRef="P23_st" />
    <bpmn:sequenceFlow id="P23_flujo_12" sourceRef="P23_st" targetRef="P23_qr" />
    <bpmn:sequenceFlow id="P23_flujo_13" sourceRef="P23_qr" targetRef="P23_wf" />
    <bpmn:sequenceFlow id="P23_flujo_14" sourceRef="P23_wf" targetRef="P23_dia" />
    <bpmn:sequenceFlow id="P23_flujo_15" sourceRef="P23_dia" targetRef="P23_chk" />
    <bpmn:sequenceFlow id="P23_flujo_16" sourceRef="P23_chk" targetRef="P23_gin" />
    <bpmn:sequenceFlow id="P23_flujo_17" name="No" sourceRef="P23_gin" targetRef="P23_ok" />
    <bpmn:sequenceFlow id="P23_flujo_18" name="Sí" sourceRef="P23_gin" targetRef="P23_ya" />
    <bpmn:sequenceFlow id="P23_flujo_19" sourceRef="P23_ok" targetRef="P23_fin" />
    <bpmn:textAnnotation id="P23_nota_n1"><bpmn:text>Sin pasarela de pago: el staff confirma a mano. Una orden sin pagar reserva el cupo hasta cancelarla.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
