<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P21_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P21_colaboracion">
    <bpmn:documentation>P21 Postulación y casting de candidatas. Formulario público con controles antibots, ficha con número de postulación, revisión, casting y nombramiento como candidata oficial.</bpmn:documentation>
    <bpmn:participant id="P21_pool_post" name="Postulante"></bpmn:participant>
    <bpmn:participant id="P21_pool_ae" name="Aether ERP" processRef="P21_proc_ae"></bpmn:participant>
    <bpmn:messageFlow id="P21_mensaje_1" name="Formulario y foto" sourceRef="P21_pool_post" targetRef="P21_i" />
    <bpmn:messageFlow id="P21_mensaje_2" name="Confirmación con número" sourceRef="P21_mail" targetRef="P21_pool_post" />
    <bpmn:messageFlow id="P21_mensaje_3" name="Citación al casting" sourceRef="P21_cit" targetRef="P21_pool_post" />
  </bpmn:collaboration>
  <bpmn:process id="P21_proc_ae" name="Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P21_carriles_ae">
      <bpmn:lane id="P21_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P21_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_gv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_ntf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_fd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P21_carril_cast" name="Equipo de casting">
        <bpmn:flowNodeRef>P21_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_cit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_cas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_of</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_gmr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_rj</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P21_carril_prod" name="Producción">
        <bpmn:flowNodeRef>P21_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_pres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P21_i" name="Llega la postulación por el link">
      <bpmn:outgoing>P21_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P21_val" name="Límites por IP, señuelo, Turnstile y datos">
      <bpmn:incoming>P21_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P21_gv" name="¿Pasa los controles?">
      <bpmn:incoming>P21_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P21_flujo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P21_desc" name="Descartada">
      <bpmn:incoming>P21_flujo_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P21_reg" name="Crear la ficha con número de postulación">
      <bpmn:incoming>P21_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P21_mail" name="Correo de confirmación y aviso a los Dueños">
      <bpmn:incoming>P21_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="P21_ntf" name="Campanita y disparador CANDIDATE_REGISTERED">
      <bpmn:incoming>P21_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P21_rev" name="Revisar ficha y fotos (UNDER_REVIEW)">
      <bpmn:incoming>P21_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P21_g1" name="¿Avanza?">
      <bpmn:incoming>P21_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_9</bpmn:outgoing>
      <bpmn:outgoing>P21_flujo_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P21_cit" name="Convocar a casting">
      <bpmn:incoming>P21_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="P21_cas" name="Hacer el casting presencial">
      <bpmn:incoming>P21_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="P21_g2" name="¿Seleccionada?">
      <bpmn:incoming>P21_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_13</bpmn:outgoing>
      <bpmn:outgoing>P21_flujo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P21_of" name="Nombrarla candidata oficial">
      <bpmn:incoming>P21_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P21_gmr" name="">
      <bpmn:incoming>P21_flujo_10</bpmn:incoming>
      <bpmn:incoming>P21_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P21_rj" name="Marcar como no seleccionada">
      <bpmn:incoming>P21_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P21_ret" name="Vence la retención (cron mensual)">
      <bpmn:incoming>P21_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_17</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 4 1 * *</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P21_del" name="Purgar los datos personales">
      <bpmn:incoming>P21_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P21_fd" name="Datos purgados">
      <bpmn:incoming>P21_flujo_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P21_con" name="Contrato, documentos y plan de cuotas">
      <bpmn:incoming>P21_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P21_pres" name="Cargar la presentación pública: foto y bio">
      <bpmn:incoming>P21_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P21_flujo_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P21_fin" name="Candidata en el micrositio">
      <bpmn:incoming>P21_flujo_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P21_flujo_1" sourceRef="P21_i" targetRef="P21_val" />
    <bpmn:sequenceFlow id="P21_flujo_2" sourceRef="P21_val" targetRef="P21_gv" />
    <bpmn:sequenceFlow id="P21_flujo_3" name="Sí" sourceRef="P21_gv" targetRef="P21_reg" />
    <bpmn:sequenceFlow id="P21_flujo_4" name="No" sourceRef="P21_gv" targetRef="P21_desc" />
    <bpmn:sequenceFlow id="P21_flujo_5" sourceRef="P21_reg" targetRef="P21_mail" />
    <bpmn:sequenceFlow id="P21_flujo_6" sourceRef="P21_mail" targetRef="P21_ntf" />
    <bpmn:sequenceFlow id="P21_flujo_7" sourceRef="P21_ntf" targetRef="P21_rev" />
    <bpmn:sequenceFlow id="P21_flujo_8" sourceRef="P21_rev" targetRef="P21_g1" />
    <bpmn:sequenceFlow id="P21_flujo_9" name="Sí" sourceRef="P21_g1" targetRef="P21_cit" />
    <bpmn:sequenceFlow id="P21_flujo_10" name="No" sourceRef="P21_g1" targetRef="P21_gmr" />
    <bpmn:sequenceFlow id="P21_flujo_11" sourceRef="P21_cit" targetRef="P21_cas" />
    <bpmn:sequenceFlow id="P21_flujo_12" sourceRef="P21_cas" targetRef="P21_g2" />
    <bpmn:sequenceFlow id="P21_flujo_13" name="Sí" sourceRef="P21_g2" targetRef="P21_of" />
    <bpmn:sequenceFlow id="P21_flujo_14" name="No" sourceRef="P21_g2" targetRef="P21_gmr" />
    <bpmn:sequenceFlow id="P21_flujo_15" sourceRef="P21_gmr" targetRef="P21_rj" />
    <bpmn:sequenceFlow id="P21_flujo_16" sourceRef="P21_rj" targetRef="P21_ret" />
    <bpmn:sequenceFlow id="P21_flujo_17" sourceRef="P21_ret" targetRef="P21_del" />
    <bpmn:sequenceFlow id="P21_flujo_18" sourceRef="P21_del" targetRef="P21_fd" />
    <bpmn:sequenceFlow id="P21_flujo_19" sourceRef="P21_of" targetRef="P21_con" />
    <bpmn:sequenceFlow id="P21_flujo_20" sourceRef="P21_con" targetRef="P21_pres" />
    <bpmn:sequenceFlow id="P21_flujo_21" sourceRef="P21_pres" targetRef="P21_fin" />
    <bpmn:textAnnotation id="P21_nota_n1"><bpmn:text>La empresa y el certamen salen del token del link, nunca del cuerpo.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P21_asoc_n1" associationDirection="None" sourceRef="P21_nota_n1" targetRef="P21_val" />
    <bpmn:textAnnotation id="P21_nota_n2"><bpmn:text>El formulario de postulación nunca puede escribir los campos públicos de la candidata.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P21_nota_n3"><bpmn:text>La postulante puede retirarse (WITHDRAWN) en cualquier etapa.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P21_diagrama" name="P21 Postulación y casting de candidatas">
    <bpmndi:BPMNPlane id="P21_plano" bpmnElement="P21_colaboracion">
      <bpmndi:BPMNShape id="P21_pool_post_di" bpmnElement="P21_pool_post" isHorizontal="true" bioc:stroke="#5f6368" bioc:fill="#f6f6f6" color:border-color="#5f6368" color:background-color="#f6f6f6"><dc:Bounds x="20" y="20" width="2778" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P21_pool_ae_di" bpmnElement="P21_pool_ae" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="20" y="148" width="2778" height="792" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P21_carril_sis_di" bpmnElement="P21_carril_sis" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="148" width="2748" height="264" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P21_carril_cast_di" bpmnElement="P21_carril_cast" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="412" width="2748" height="396" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P21_carril_prod_di" bpmnElement="P21_carril_prod" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="808" width="2748" height="132" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P21_i_di" bpmnElement="P21_i" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="175" y="196" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="133" y="238" width="120" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
