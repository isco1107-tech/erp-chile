      <bpmndi:BPMNShape id="P21_pres_di" bpmnElement="P21_pres" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="2441" y="832" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P21_fin_di" bpmnElement="P21_fin" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="2667" y="856" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2625" y="898" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
