      <bpmndi:BPMNEdge id="P21_flujo_1_di" bpmnElement="P21_flujo_1"><di:waypoint x="211" y="214" /><di:waypoint x="305" y="214" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P21_flujo_2_di" bpmnElement="P21_flujo_2"><di:waypoint x="437" y="214" /><di:waypoint x="524" y="214" /></bpmndi:BPMNEdge>
