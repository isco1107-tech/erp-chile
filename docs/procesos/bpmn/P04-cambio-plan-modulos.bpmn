<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="P04_definiciones" targetNamespace="https://aetherp.online/procesos" exporter="Aether · generador de procesos" exporterVersion="1.0">
  <bpmn:collaboration id="P04_colaboracion">
    <bpmn:documentation>P04 Cambio de plan o módulos. La empresa arma y pide módulos desde Aether; la Supersuite aprueba de un clic y transmite solo lo que falta.</bpmn:documentation>
    <bpmn:participant id="P04_pool_emp" name="Empresa cliente (Aether)" processRef="P04_proc_emp"></bpmn:participant>
    <bpmn:participant id="P04_pool_ss" name="Supersuite" processRef="P04_proc_ss"></bpmn:participant>
    <bpmn:messageFlow id="P04_mensaje_1" name="Alerta con { modulos, plan }" sourceRef="P04_al" targetRef="P04_rec" />
    <bpmn:messageFlow id="P04_mensaje_2" name="plan.cambiar / modulo.activar" sourceRef="P04_tx" targetRef="P04_os" />
    <bpmn:messageFlow id="P04_mensaje_3" name="Resultado" sourceRef="P04_resp" targetRef="P04_res" />
    <bpmn:messageFlow id="P04_mensaje_4" name="Respuesta a la empresa" sourceRef="P04_rech" targetRef="P04_pool_emp" />
  </bpmn:collaboration>
  <bpmn:process id="P04_proc_emp" name="Empresa cliente (Aether)" isExecutable="false">
    <bpmn:laneSet id="P04_carriles_emp">
      <bpmn:lane id="P04_carril_due" name="Dueño o Administrador">
        <bpmn:flowNodeRef>P04_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_sel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_usa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_fu</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P04_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_al</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_fs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_os</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_vf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_cerr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_resp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_av</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P04_i" name="Necesita otro módulo o plan">
      <bpmn:outgoing>P04_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P04_sel" name="Armar selección en Planes y módulos">
      <bpmn:incoming>P04_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P04_cot" name="Recalcular la cotización en el servidor">
      <bpmn:incoming>P04_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P04_rev" name="Revisar precio y enviar solicitud">
      <bpmn:incoming>P04_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P04_req" name="Avisar por correo a ventas">
      <bpmn:incoming>P04_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="P04_al" name="Abrir alerta solicitud-modulos">
      <bpmn:incoming>P04_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P04_fs" name="Solicitud enviada">
      <bpmn:incoming>P04_flujo_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P04_os" name="Llega una orden firmada">
      <bpmn:outgoing>P04_flujo_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P04_vf" name="Verificar firma y aplicar el cambio">
      <bpmn:documentation>updateTenantPlan con companyPlanUpdateSchema.</bpmn:documentation>
      <bpmn:incoming>P04_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P04_cerr" name="Bitácora, cerrar la alerta y reenviar la ficha">
      <bpmn:documentation>solicitudModulosAtendidaSupersuite + createAuditLog.</bpmn:documentation>
      <bpmn:incoming>P04_flujo_18</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P04_resp" name="Responder { ok, mensaje, tarifa }">
      <bpmn:incoming>P04_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="P04_av" name="Revalidar el menú de la empresa">
      <bpmn:incoming>P04_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P04_usa" name="Usar el módulo nuevo">
      <bpmn:incoming>P04_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P04_fu" name="Módulo en uso">
      <bpmn:incoming>P04_flujo_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P04_flujo_1" sourceRef="P04_i" targetRef="P04_sel" />
    <bpmn:sequenceFlow id="P04_flujo_2" sourceRef="P04_sel" targetRef="P04_cot" />
    <bpmn:sequenceFlow id="P04_flujo_3" sourceRef="P04_cot" targetRef="P04_rev" />
    <bpmn:sequenceFlow id="P04_flujo_4" sourceRef="P04_rev" targetRef="P04_req" />
    <bpmn:sequenceFlow id="P04_flujo_5" sourceRef="P04_req" targetRef="P04_al" />
    <bpmn:sequenceFlow id="P04_flujo_6" sourceRef="P04_al" targetRef="P04_fs" />
    <bpmn:sequenceFlow id="P04_flujo_17" sourceRef="P04_os" targetRef="P04_vf" />
    <bpmn:sequenceFlow id="P04_flujo_18" sourceRef="P04_vf" targetRef="P04_cerr" />
    <bpmn:sequenceFlow id="P04_flujo_19" sourceRef="P04_cerr" targetRef="P04_resp" />
    <bpmn:sequenceFlow id="P04_flujo_20" sourceRef="P04_resp" targetRef="P04_av" />
    <bpmn:sequenceFlow id="P04_flujo_21" sourceRef="P04_av" targetRef="P04_usa" />
    <bpmn:sequenceFlow id="P04_flujo_22" sourceRef="P04_usa" targetRef="P04_fu" />
    <bpmn:textAnnotation id="P04_nota_n1"><bpmn:text>Un plan nuevo suma módulos y topes; quitar es una orden aparte (modulo.desactivar).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P04_asoc_n1" associationDirection="None" sourceRef="P04_nota_n1" targetRef="P04_vf" />
  </bpmn:process>
  <bpmn:process id="P04_proc_ss" name="Supersuite" isExecutable="false">
    <bpmn:laneSet id="P04_carriles_ss">
      <bpmn:lane id="P04_carril_api" name="API y panel en vivo">
        <bpmn:flowNodeRef>P04_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_mos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_tx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_cie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_fap</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_carril_opr" name="Operador de la consola">
        <bpmn:flowNodeRef>P04_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_frech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_apr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P04_rec" name="Llega la solicitud con su detalle">
      <bpmn:outgoing>P04_flujo_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P04_mos" name="Mostrarla en Cobros, Alertas y la ficha">
      <bpmn:incoming>P04_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P04_dec" name="Revisar la solicitud">
      <bpmn:incoming>P04_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P04_gd" name="¿Se aprueba?">
      <bpmn:incoming>P04_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_10</bpmn:outgoing>
      <bpmn:outgoing>P04_flujo_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P04_rech" name="Responder a la empresa y cerrar la alerta">
      <bpmn:incoming>P04_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P04_frech" name="Cerrada sin cambios">
      <bpmn:incoming>P04_flujo_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P04_apr" name="Aprobar de un clic">
      <bpmn:incoming>P04_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P04_tx" name="Transmitir solo lo que falta">
      <bpmn:incoming>P04_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="P04_res" name="Recibe el resultado">
      <bpmn:incoming>P04_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P04_cie" name="Marcar aplicadas y cerrar la solicitud">
      <bpmn:incoming>P04_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P04_fap" name="Plan y módulos al día">
      <bpmn:incoming>P04_flujo_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P04_flujo_7" sourceRef="P04_rec" targetRef="P04_mos" />
    <bpmn:sequenceFlow id="P04_flujo_8" sourceRef="P04_mos" targetRef="P04_dec" />
    <bpmn:sequenceFlow id="P04_flujo_9" sourceRef="P04_dec" targetRef="P04_gd" />
    <bpmn:sequenceFlow id="P04_flujo_10" name="Sí" sourceRef="P04_gd" targetRef="P04_apr" />
    <bpmn:sequenceFlow id="P04_flujo_11" name="No" sourceRef="P04_gd" targetRef="P04_rech" />
    <bpmn:sequenceFlow id="P04_flujo_12" sourceRef="P04_rech" targetRef="P04_frech" />
    <bpmn:sequenceFlow id="P04_flujo_13" sourceRef="P04_apr" targetRef="P04_tx" />
    <bpmn:sequenceFlow id="P04_flujo_14" sourceRef="P04_tx" targetRef="P04_res" />
    <bpmn:sequenceFlow id="P04_flujo_15" sourceRef="P04_res" targetRef="P04_cie" />
    <bpmn:sequenceFlow id="P04_flujo_16" sourceRef="P04_cie" targetRef="P04_fap" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P04_diagrama" name="P04 Cambio de plan o módulos">
    <bpmndi:BPMNPlane id="P04_plano" bpmnElement="P04_colaboracion">
      <bpmndi:BPMNShape id="P04_pool_emp_di" bpmnElement="P04_pool_emp" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="20" y="20" width="3490" height="396" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_carril_due_di" bpmnElement="P04_carril_due" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="20" width="3460" height="132" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_carril_sis_di" bpmnElement="P04_carril_sis" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="152" width="3460" height="264" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_pool_ss_di" bpmnElement="P04_pool_ss" isHorizontal="true" bioc:stroke="#284a7e" bioc:fill="#f5f8fd" color:border-color="#284a7e" color:background-color="#f5f8fd"><dc:Bounds x="20" y="472" width="3490" height="396" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_carril_api_di" bpmnElement="P04_carril_api" isHorizontal="true" bioc:stroke="#284a7e" bioc:fill="#f5f8fd" color:border-color="#284a7e" color:background-color="#f5f8fd"><dc:Bounds x="50" y="472" width="3460" height="132" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_carril_opr_di" bpmnElement="P04_carril_opr" isHorizontal="true" bioc:stroke="#284a7e" bioc:fill="#f5f8fd" color:border-color="#284a7e" color:background-color="#f5f8fd"><dc:Bounds x="50" y="604" width="3460" height="264" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_i_di" bpmnElement="P04_i" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="175" y="68" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="133" y="110" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_sel_di" bpmnElement="P04_sel" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="305" y="44" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_cot_di" bpmnElement="P04_cot" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="483" y="176" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_rev_di" bpmnElement="P04_rev" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="661" y="44" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_req_di" bpmnElement="P04_req" bioc:stroke="#5b3a9e" bioc:fill="#efe9fa" color:border-color="#5b3a9e" color:background-color="#efe9fa"><dc:Bounds x="839" y="176" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_al_di" bpmnElement="P04_al" bioc:stroke="#5b3a9e" bioc:fill="#efe9fa" color:border-color="#5b3a9e" color:background-color="#efe9fa"><dc:Bounds x="1017" y="176" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_fs_di" bpmnElement="P04_fs" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="1243" y="200" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1201" y="242" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_rec_di" bpmnElement="P04_rec" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="1243" y="520" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1201" y="562" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_mos_di" bpmnElement="P04_mos" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="1373" y="496" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_dec_di" bpmnElement="P04_dec" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="1551" y="628" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_gd_di" bpmnElement="P04_gd" isMarkerVisible="true" bioc:stroke="#8a6a00" bioc:fill="#fff1bf" color:border-color="#8a6a00" color:background-color="#fff1bf"><dc:Bounds x="1770" y="645" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1731" y="625" width="128" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_rech_di" bpmnElement="P04_rech" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="1907" y="760" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_frech_di" bpmnElement="P04_frech" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="2133" y="784" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2091" y="826" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_apr_di" bpmnElement="P04_apr" bioc:stroke="#1d4f91" bioc:fill="#e6eefb" color:border-color="#1d4f91" color:background-color="#e6eefb"><dc:Bounds x="1907" y="628" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_tx_di" bpmnElement="P04_tx" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="2085" y="496" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_os_di" bpmnElement="P04_os" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="2311" y="332" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2269" y="298" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_vf_di" bpmnElement="P04_vf" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="2441" y="308" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_cerr_di" bpmnElement="P04_cerr" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="2619" y="308" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_resp_di" bpmnElement="P04_resp" bioc:stroke="#5b3a9e" bioc:fill="#efe9fa" color:border-color="#5b3a9e" color:background-color="#efe9fa"><dc:Bounds x="2797" y="308" width="132" height="84" /></bpmndi:BPMNShape>
