      <bpmndi:BPMNShape id="P27_ge_di" bpmnElement="P27_ge" bioc:stroke="#8a6a00" bioc:fill="#fff1bf" color:border-color="#8a6a00" color:background-color="#fff1bf"><dc:Bounds x="1058" y="321" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_not_di" bpmnElement="P27_not" bioc:stroke="#9a5b00" bioc:fill="#fff4dc" color:border-color="#9a5b00" color:background-color="#fff4dc"><dc:Bounds x="1243" y="328" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1201" y="294" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_ret_di" bpmnElement="P27_ret" bioc:stroke="#9a5b00" bioc:fill="#fff4dc" color:border-color="#9a5b00" color:background-color="#fff4dc"><dc:Bounds x="1421" y="460" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1379" y="502" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_exp_di" bpmnElement="P27_exp" bioc:stroke="#9a5b00" bioc:fill="#fff4dc" color:border-color="#9a5b00" color:background-color="#fff4dc"><dc:Bounds x="1599" y="592" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1557" y="634" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_fexp_di" bpmnElement="P27_fexp" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="1907" y="568" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_ffe_di" bpmnElement="P27_ffe" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="2133" y="592" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2091" y="634" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
