      <bpmndi:BPMNShape id="P27_syn_di" bpmnElement="P27_syn" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="1729" y="304" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_gx_di" bpmnElement="P27_gx" isMarkerVisible="true" bioc:stroke="#8a6a00" bioc:fill="#fff1bf" color:border-color="#8a6a00" color:background-color="#fff1bf"><dc:Bounds x="1948" y="321" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1909" y="273" width="128" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_pend_di" bpmnElement="P27_pend" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="2133" y="460" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2091" y="502" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_paid_di" bpmnElement="P27_paid" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="2085" y="304" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_num_di" bpmnElement="P27_num" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="2263" y="304" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_mail_di" bpmnElement="P27_mail" bioc:stroke="#5b3a9e" bioc:fill="#efe9fa" color:border-color="#5b3a9e" color:background-color="#efe9fa"><dc:Bounds x="2441" y="304" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_fin_di" bpmnElement="P27_fin" bioc:stroke="#b3261e" bioc:fill="#fbe7e5" color:border-color="#b3261e" color:background-color="#fbe7e5"><dc:Bounds x="2667" y="328" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2625" y="370" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_cr_di" bpmnElement="P27_cr" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="175" y="724" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="133" y="766" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
