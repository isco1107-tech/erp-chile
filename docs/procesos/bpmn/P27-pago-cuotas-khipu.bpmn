      <bpmndi:BPMNShape id="P27_carril_cob_di" bpmnElement="P27_carril_cob" isHorizontal="true" bioc:stroke="#6b5a24" bioc:fill="#fdfbf4" color:border-color="#6b5a24" color:background-color="#fdfbf4"><dc:Bounds x="50" y="676" width="2748" height="132" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_pool_kh_di" bpmnElement="P27_pool_kh" isHorizontal="true" bioc:stroke="#5f6368" bioc:fill="#f6f6f6" color:border-color="#5f6368" color:background-color="#f6f6f6"><dc:Bounds x="20" y="864" width="2778" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_i_di" bpmnElement="P27_i" bioc:stroke="#2e7d32" bioc:fill="#e3f3e5" color:border-color="#2e7d32" color:background-color="#e3f3e5"><dc:Bounds x="175" y="196" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="133" y="238" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P27_look_di" bpmnElement="P27_look" bioc:stroke="#3d4f5c" bioc:fill="#edf1f4" color:border-color="#3d4f5c" color:background-color="#edf1f4"><dc:Bounds x="305" y="304" width="132" height="84" /></bpmndi:BPMNShape>
