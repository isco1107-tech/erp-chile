      <bpmn:outgoing>P26_flujo_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="P26_ves" name="Asignar vestuario por segmento">
      <bpmn:incoming>P26_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P26_acr" name="Acreditar staff, prensa e invitados">
      <bpmn:incoming>P26_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P26_ens" name="Ensayo general">
      <bpmn:incoming>P26_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P26_gj" name="">
      <bpmn:incoming>P26_flujo_6</bpmn:incoming>
      <bpmn:incoming>P26_flujo_7</bpmn:incoming>
      <bpmn:incoming>P26_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P26_flujo_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="P26_show" name="Activar el modo show">
