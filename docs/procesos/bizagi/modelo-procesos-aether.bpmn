    <bpmn:sequenceFlow id="P26_flujo_13" name="Se salta" sourceRef="P26_gt" targetRef="P26_sk" />
    <bpmn:sequenceFlow id="P26_flujo_14" sourceRef="P26_dn" targetRef="P26_gm" />
    <bpmn:sequenceFlow id="P26_flujo_15" sourceRef="P26_sk" targetRef="P26_gm" />
    <bpmn:sequenceFlow id="P26_flujo_16" sourceRef="P26_gm" targetRef="P26_gr" />
    <bpmn:sequenceFlow id="P26_flujo_17" name="Sí" sourceRef="P26_gr" targetRef="P26_pun" />
    <bpmn:sequenceFlow id="P26_flujo_18" name="No" sourceRef="P26_gr" targetRef="P26_gm2" />
    <bpmn:sequenceFlow id="P26_flujo_19" sourceRef="P26_pun" targetRef="P26_gm2" />
    <bpmn:sequenceFlow id="P26_flujo_20" sourceRef="P26_gm2" targetRef="P26_gq" />
    <bpmn:sequenceFlow id="P26_flujo_21" name="Sí" sourceRef="P26_gq" targetRef="P26_seg" />
    <bpmn:sequenceFlow id="P26_flujo_22" name="No" sourceRef="P26_gq" targetRef="P26_cor" />
    <bpmn:sequenceFlow id="P26_flujo_23" sourceRef="P26_cor" targetRef="P26_fin" />
    <bpmn:textAnnotation id="P26_nota_n1"><bpmn:text>Cada segmento: PENDING → IN_PROGRESS → DONE o SKIPPED.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P26_nota_n2"><bpmn:text>En la puerta, el público entra con el QR de su entrada (P23).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P26_titulo"><bpmn:text>P26 · Gala final en vivo (escaleta). Escaleta, vestuario, acreditación y ensayo en paralelo; luego el modo show recorre los segmentos e intercala las rondas del jurado.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P27_proc_ae" name="P27 · Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P27_carriles_ae">
      <bpmn:lane id="P27_carril_por" name="Portal público /pagar">
