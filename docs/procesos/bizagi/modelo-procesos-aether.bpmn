    <bpmn:sequenceFlow id="P40_flujo_22" name="Sí" sourceRef="P40_gpw" targetRef="P40_chg" />
    <bpmn:sequenceFlow id="P40_flujo_23" name="No" sourceRef="P40_gpw" targetRef="P40_gm3" />
    <bpmn:sequenceFlow id="P40_flujo_24" sourceRef="P40_chg" targetRef="P40_gm3" />
    <bpmn:sequenceFlow id="P40_flujo_25" sourceRef="P40_gm3" targetRef="P40_pan" />
    <bpmn:sequenceFlow id="P40_flujo_26" sourceRef="P40_pan" targetRef="P40_fin" />
    <bpmn:textAnnotation id="P40_nota_n1"><bpmn:text>Sin excepción por superusuario: una empresa suspendida no entra ni para reactivarse.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P40_asoc_n1" associationDirection="None" sourceRef="P40_nota_n1" targetRef="P40_sus" />
    <bpmn:textAnnotation id="P40_nota_n2"><bpmn:text>Suspender o desactivar corta el acceso de inmediato, no al vencer el token.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P40_asoc_n2" associationDirection="None" sourceRef="P40_nota_n2" targetRef="P40_pan" />
    <bpmn:textAnnotation id="P40_titulo"><bpmn:text>P40 · Acceso y seguridad. Ingreso con límites y Turnstile, bloqueo por intentos, empresa suspendida, 2FA, lista de IPs, sesión de 8 horas, elección de empresa y cambio de clave.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P40_area_transversal"><bpmn:text>Transversales (P40, P41)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P41_proc_ae" name="P41 · Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P41_carriles_ae">
      <bpmn:lane id="P41_carril_adm" name="Administrador de la empresa">
        <bpmn:flowNodeRef>P41_ai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_fa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P41_carril_neg" name="Módulo de negocio">
        <bpmn:flowNodeRef>P41_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_tx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_emi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P41_carril_mot" name="Motor de automatizaciones">
        <bpmn:flowNodeRef>P41_bus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_gh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_fn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_gac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_noti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_url</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_whs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_gj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P41_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P41_ai" name="Quiere automatizar algo">
      <bpmn:outgoing>P41_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P41_reg" name="Crear la regla: disparador, condiciones y acciones">
      <bpmn:incoming>P41_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P41_fa" name="Regla activa">
      <bpmn:incoming>P41_flujo_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P41_i" name="Ocurre un hecho de negocio">
      <bpmn:outgoing>P41_flujo_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P41_tx" name="Confirmar la transacción de negocio">
      <bpmn:incoming>P41_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P41_emi" name="emitWorkflowEvent después del commit">
      <bpmn:incoming>P41_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P41_bus" name="Buscar las reglas activas de ese disparador">
      <bpmn:incoming>P41_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P41_gh" name="¿Cumple las condiciones?">
      <bpmn:incoming>P41_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_7</bpmn:outgoing>
      <bpmn:outgoing>P41_flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P41_fn" name="Sin acción">
      <bpmn:incoming>P41_flujo_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:inclusiveGateway id="P41_gac" name="">
      <bpmn:incoming>P41_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_9</bpmn:outgoing>
      <bpmn:outgoing>P41_flujo_10</bpmn:outgoing>
      <bpmn:outgoing>P41_flujo_11</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sendTask id="P41_mail" name="Enviar correo">
      <bpmn:incoming>P41_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="P41_noti" name="Notificación interna">
      <bpmn:incoming>P41_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="P41_url" name="Validar la URL: https, sin IP privada ni redirecciones">
      <bpmn:incoming>P41_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="P41_whs" name="Webhook firmado con HMAC">
      <bpmn:incoming>P41_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:inclusiveGateway id="P41_gj" name="">
      <bpmn:incoming>P41_flujo_13</bpmn:incoming>
      <bpmn:incoming>P41_flujo_14</bpmn:incoming>
      <bpmn:incoming>P41_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_16</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="P41_log" name="Registrar la ejecución">
      <bpmn:incoming>P41_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P41_flujo_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P41_fin" name="Automatización ejecutada">
      <bpmn:incoming>P41_flujo_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P41_flujo_1" sourceRef="P41_ai" targetRef="P41_reg" />
    <bpmn:sequenceFlow id="P41_flujo_2" sourceRef="P41_reg" targetRef="P41_fa" />
    <bpmn:sequenceFlow id="P41_flujo_3" sourceRef="P41_i" targetRef="P41_tx" />
    <bpmn:sequenceFlow id="P41_flujo_4" sourceRef="P41_tx" targetRef="P41_emi" />
    <bpmn:sequenceFlow id="P41_flujo_5" sourceRef="P41_emi" targetRef="P41_bus" />
    <bpmn:sequenceFlow id="P41_flujo_6" sourceRef="P41_bus" targetRef="P41_gh" />
    <bpmn:sequenceFlow id="P41_flujo_7" name="Sí" sourceRef="P41_gh" targetRef="P41_gac" />
    <bpmn:sequenceFlow id="P41_flujo_8" name="No" sourceRef="P41_gh" targetRef="P41_fn" />
    <bpmn:sequenceFlow id="P41_flujo_9" name="Correo" sourceRef="P41_gac" targetRef="P41_mail" />
    <bpmn:sequenceFlow id="P41_flujo_10" name="Notificación" sourceRef="P41_gac" targetRef="P41_noti" />
    <bpmn:sequenceFlow id="P41_flujo_11" name="Webhook" sourceRef="P41_gac" targetRef="P41_url" />
    <bpmn:sequenceFlow id="P41_flujo_12" sourceRef="P41_url" targetRef="P41_whs" />
    <bpmn:sequenceFlow id="P41_flujo_13" sourceRef="P41_mail" targetRef="P41_gj" />
    <bpmn:sequenceFlow id="P41_flujo_14" sourceRef="P41_noti" targetRef="P41_gj" />
    <bpmn:sequenceFlow id="P41_flujo_15" sourceRef="P41_whs" targetRef="P41_gj" />
    <bpmn:sequenceFlow id="P41_flujo_16" sourceRef="P41_gj" targetRef="P41_log" />
    <bpmn:sequenceFlow id="P41_flujo_17" sourceRef="P41_log" targetRef="P41_fin" />
    <bpmn:textAnnotation id="P41_nota_n1"><bpmn:text>Un correo o webhook es I/O externo: nunca decide si la venta se guarda.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P41_asoc_n1" associationDirection="None" sourceRef="P41_nota_n1" targetRef="P41_emi" />
    <bpmn:textAnnotation id="P41_nota_n2"><bpmn:text>El webhook se revalida antes de cada envío, no solo al guardar la regla.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P41_titulo"><bpmn:text>P41 · Automatizaciones de la empresa. Cada empresa arma reglas (disparador, condiciones, acciones); el motor las ejecuta después de que el hecho de negocio quedó guardado.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
