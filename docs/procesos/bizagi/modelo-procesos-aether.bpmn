    <bpmn:sequenceFlow id="P14_flujo_13" sourceRef="P14_pub" targetRef="P14_decl" />
    <bpmn:sequenceFlow id="P14_flujo_14" sourceRef="P14_decl" targetRef="P14_pago" />
    <bpmn:sequenceFlow id="P14_flujo_15" sourceRef="P14_pago" targetRef="P14_fin" />
    <bpmn:textAnnotation id="P14_nota_n1"><bpmn:text>Los parámetros legales entran por pantalla cada mes: nunca están en el código.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P14_asoc_n1" associationDirection="None" sourceRef="P14_nota_n1" targetRef="P14_par" />
    <bpmn:textAnnotation id="P14_titulo"><bpmn:text>P14 · Remuneraciones. Período del mes con parámetros confirmados contra Previred, cálculo de liquidaciones, cierre con asiento y portal del trabajador.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P15_proc_ae" name="P15 · Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P15_carriles_ae">
      <bpmn:lane id="P15_carril_col" name="Colaborador">
        <bpmn:flowNodeRef>P15_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_cre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_gmc</bpmn:flowNodeRef>
