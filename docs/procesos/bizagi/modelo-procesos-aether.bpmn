  <bpmn:process id="P00_proc_plat" name="P00 · Ciclo de vida de una empresa en Aether" isExecutable="false">
    <bpmn:laneSet id="P00_carriles_plat">
      <bpmn:lane id="P00_carril_cli" name="Empresa cliente">
        <bpmn:flowNodeRef>P00_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_p03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_gs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_erp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_ev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_dig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_p13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_gj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P00_carril_eq" name="Equipo Aether (ventas y soporte)">
        <bpmn:flowNodeRef>P00_p01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P00_carril_ss" name="Supersuite (consola SaaS)">
        <bpmn:flowNodeRef>P00_p02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_p06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_p07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_p04</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P00_i" name="Necesita ordenar su operación o producir un certamen">
      <bpmn:outgoing>P00_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="P00_p01" name="P01 Captación y contratación" triggeredByEvent="false">
      <bpmn:documentation>Ver P01.</bpmn:documentation>
      <bpmn:incoming>P00_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P00_p02" name="P02 Alta de la empresa por orden firmada" triggeredByEvent="false">
      <bpmn:documentation>Ver P02. Orden empresa.crear.</bpmn:documentation>
      <bpmn:incoming>P00_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P00_p03" name="P03 Puesta en marcha de la empresa" triggeredByEvent="false">
      <bpmn:documentation>Ver P03.</bpmn:documentation>
      <bpmn:incoming>P00_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="P00_gm" name="">
      <bpmn:incoming>P00_flujo_4</bpmn:incoming>
      <bpmn:incoming>P00_flujo_20</bpmn:incoming>
      <bpmn:incoming>P00_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="P00_gs" name="Ciclo de operación">
      <bpmn:incoming>P00_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_6</bpmn:outgoing>
      <bpmn:outgoing>P00_flujo_7</bpmn:outgoing>
      <bpmn:outgoing>P00_flujo_8</bpmn:outgoing>
      <bpmn:outgoing>P00_flujo_9</bpmn:outgoing>
      <bpmn:outgoing>P00_flujo_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="P00_erp" name="Operación ERP (P10–P12, P14–P16)" triggeredByEvent="false">
      <bpmn:documentation>Ventas, compras, punto de venta, remuneraciones, gastos y servicio técnico.</bpmn:documentation>
      <bpmn:incoming>P00_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_11</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P00_ev" name="Producción de certámenes (P20–P27)" triggeredByEvent="false">
      <bpmn:incoming>P00_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_13</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P00_dig" name="Canales digitales (P30–P33)" triggeredByEvent="false">
      <bpmn:incoming>P00_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_14</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P00_p06" name="P06 Telemetría, salud y alertas" triggeredByEvent="false">
      <bpmn:incoming>P00_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_15</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P00_p07" name="P07 Cobro de la suscripción" triggeredByEvent="false">
      <bpmn:incoming>P00_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_16</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="P00_p13" name="P13 Cierre mensual y F29" triggeredByEvent="false">
      <bpmn:incoming>P00_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_12</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:parallelGateway id="P00_gj" name="">
      <bpmn:incoming>P00_flujo_12</bpmn:incoming>
      <bpmn:incoming>P00_flujo_13</bpmn:incoming>
      <bpmn:incoming>P00_flujo_14</bpmn:incoming>
      <bpmn:incoming>P00_flujo_15</bpmn:incoming>
      <bpmn:incoming>P00_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="P00_gd" name="¿Cómo sigue la cuenta?">
      <bpmn:incoming>P00_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_18</bpmn:outgoing>
      <bpmn:outgoing>P00_flujo_19</bpmn:outgoing>
      <bpmn:outgoing>P00_flujo_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="P00_p04" name="P04 Cambio de plan o módulos" triggeredByEvent="false">
      <bpmn:incoming>P00_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P00_flujo_21</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="P00_fin" name="Cuenta cancelada">
      <bpmn:incoming>P00_flujo_18</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P00_flujo_1" sourceRef="P00_i" targetRef="P00_p01" />
    <bpmn:sequenceFlow id="P00_flujo_2" sourceRef="P00_p01" targetRef="P00_p02" />
    <bpmn:sequenceFlow id="P00_flujo_3" sourceRef="P00_p02" targetRef="P00_p03" />
    <bpmn:sequenceFlow id="P00_flujo_4" sourceRef="P00_p03" targetRef="P00_gm" />
    <bpmn:sequenceFlow id="P00_flujo_5" sourceRef="P00_gm" targetRef="P00_gs" />
    <bpmn:sequenceFlow id="P00_flujo_6" sourceRef="P00_gs" targetRef="P00_erp" />
    <bpmn:sequenceFlow id="P00_flujo_7" sourceRef="P00_gs" targetRef="P00_ev" />
    <bpmn:sequenceFlow id="P00_flujo_8" sourceRef="P00_gs" targetRef="P00_dig" />
    <bpmn:sequenceFlow id="P00_flujo_9" sourceRef="P00_gs" targetRef="P00_p06" />
    <bpmn:sequenceFlow id="P00_flujo_10" sourceRef="P00_gs" targetRef="P00_p07" />
    <bpmn:sequenceFlow id="P00_flujo_11" sourceRef="P00_erp" targetRef="P00_p13" />
    <bpmn:sequenceFlow id="P00_flujo_12" sourceRef="P00_p13" targetRef="P00_gj" />
    <bpmn:sequenceFlow id="P00_flujo_13" sourceRef="P00_ev" targetRef="P00_gj" />
    <bpmn:sequenceFlow id="P00_flujo_14" sourceRef="P00_dig" targetRef="P00_gj" />
    <bpmn:sequenceFlow id="P00_flujo_15" sourceRef="P00_p06" targetRef="P00_gj" />
    <bpmn:sequenceFlow id="P00_flujo_16" sourceRef="P00_p07" targetRef="P00_gj" />
    <bpmn:sequenceFlow id="P00_flujo_17" sourceRef="P00_gj" targetRef="P00_gd" />
    <bpmn:sequenceFlow id="P00_flujo_18" name="Se da de baja" sourceRef="P00_gd" targetRef="P00_fin" />
    <bpmn:sequenceFlow id="P00_flujo_19" name="Amplía o cambia de plan" sourceRef="P00_gd" targetRef="P00_p04" />
    <bpmn:sequenceFlow id="P00_flujo_20" name="Mantiene su plan" sourceRef="P00_gd" targetRef="P00_gm" />
    <bpmn:sequenceFlow id="P00_flujo_21" sourceRef="P00_p04" targetRef="P00_gm" />
    <bpmn:textAnnotation id="P00_nota_n1"><bpmn:text>Cada caja es un subproceso con su propio diagrama (P01–P41).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P00_nota_n2"><bpmn:text>La Supersuite nunca escribe en la base de Aether: transmite órdenes firmadas y Aether confirma.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P00_titulo"><bpmn:text>P00 · Macroproceso: ciclo de vida de una empresa en Aether. Vista de nivel 0: cómo una empresa llega, se da de alta, se pone en marcha, opera cada mes y renueva, amplía o se va.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P00_area_plataforma"><bpmn:text>Plataforma SaaS: Aether y Supersuite (P00, P01, P02, P03, P04, P05, P06, P07, P08, P09)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P01_proc_ae" name="P01 · Aether" isExecutable="false">
    <bpmn:laneSet id="P01_carriles_ae">
      <bpmn:lane id="P01_carril_web" name="Sitio público aetherp.online">
        <bpmn:flowNodeRef>P01_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_gv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_mail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P01_carril_ven" name="Ventas Aether">
        <bpmn:flowNodeRef>P01_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_demo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_env</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_ge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_acep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_seg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_gs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_perd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P01_i" name="Llega solicitud de demo o carrito de módulos">
      <bpmn:documentation>POST /api/public/leads (demo) o POST /api/public/module-quote (carrito de la vitrina).</bpmn:documentation>
      <bpmn:outgoing>P01_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P01_val" name="Validar límite por IP, señuelo y datos">
      <bpmn:documentation>rate-limiter por IP + honeypot + esquema Zod.</bpmn:documentation>
      <bpmn:incoming>P01_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P01_gv" name="¿Solicitud válida?">
      <bpmn:incoming>P01_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P01_flujo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P01_desc" name="Descartada sin aviso">
      <bpmn:incoming>P01_flujo_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="P01_mail" name="Enviar correo a ventas con replyTo">
      <bpmn:documentation>No toca la base de datos. El carrito incluye los módulos elegidos.</bpmn:documentation>
      <bpmn:incoming>P01_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="P01_rev" name="Revisar la solicitud y contactar">
      <bpmn:incoming>P01_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P01_demo" name="Hacer la demo sobre sus procesos">
      <bpmn:documentation>Paso 1 del método de la landing: &quot;Conversamos tu operación&quot;.</bpmn:documentation>
      <bpmn:incoming>P01_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P01_cot" name="Armar propuesta: plan, módulos, usuarios y bodegas">
      <bpmn:documentation>Precios de lista (CLP + IVA al mes) del catálogo. Planes vigentes: Base, Comercio, Gestión, Eventos y Total.</bpmn:documentation>
      <bpmn:incoming>P01_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P01_env" name="Enviar propuesta">
      <bpmn:incoming>P01_flujo_8</bpmn:incoming>
      <bpmn:incoming>P01_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="P01_ge" name="">
      <bpmn:incoming>P01_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_10</bpmn:outgoing>
      <bpmn:outgoing>P01_flujo_11</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P01_acep" name="Acepta la propuesta">
      <bpmn:incoming>P01_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P01_esp" name="Pasan días sin respuesta">
      <bpmn:incoming>P01_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_14</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P01_seg" name="Hacer seguimiento">
      <bpmn:incoming>P01_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P01_gs" name="¿Sigue interesado?">
      <bpmn:incoming>P01_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_16</bpmn:outgoing>
      <bpmn:outgoing>P01_flujo_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P01_perd" name="Oportunidad perdida">
      <bpmn:incoming>P01_flujo_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P01_datos" name="Reunir datos de alta y del Dueño">
      <bpmn:documentation>Campos de la orden empresa.crear: rut, razonSocial, correo, plan, modulos, usuariosMax, bodegasMax, adminNombre, adminCorreo, adminClave.</bpmn:documentation>
      <bpmn:incoming>P01_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P01_flujo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P01_fin" name="Lista para el alta (P02)">
      <bpmn:incoming>P01_flujo_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P01_flujo_1" sourceRef="P01_i" targetRef="P01_val" />
    <bpmn:sequenceFlow id="P01_flujo_2" sourceRef="P01_val" targetRef="P01_gv" />
    <bpmn:sequenceFlow id="P01_flujo_3" name="Sí" sourceRef="P01_gv" targetRef="P01_mail" />
    <bpmn:sequenceFlow id="P01_flujo_4" name="No" sourceRef="P01_gv" targetRef="P01_desc" />
    <bpmn:sequenceFlow id="P01_flujo_5" sourceRef="P01_mail" targetRef="P01_rev" />
    <bpmn:sequenceFlow id="P01_flujo_6" sourceRef="P01_rev" targetRef="P01_demo" />
    <bpmn:sequenceFlow id="P01_flujo_7" sourceRef="P01_demo" targetRef="P01_cot" />
    <bpmn:sequenceFlow id="P01_flujo_8" sourceRef="P01_cot" targetRef="P01_env" />
    <bpmn:sequenceFlow id="P01_flujo_9" sourceRef="P01_env" targetRef="P01_ge" />
    <bpmn:sequenceFlow id="P01_flujo_10" sourceRef="P01_ge" targetRef="P01_acep" />
    <bpmn:sequenceFlow id="P01_flujo_11" sourceRef="P01_ge" targetRef="P01_esp" />
    <bpmn:sequenceFlow id="P01_flujo_12" sourceRef="P01_acep" targetRef="P01_datos" />
    <bpmn:sequenceFlow id="P01_flujo_13" sourceRef="P01_datos" targetRef="P01_fin" />
    <bpmn:sequenceFlow id="P01_flujo_14" sourceRef="P01_esp" targetRef="P01_seg" />
    <bpmn:sequenceFlow id="P01_flujo_15" sourceRef="P01_seg" targetRef="P01_gs" />
    <bpmn:sequenceFlow id="P01_flujo_16" name="No" sourceRef="P01_gs" targetRef="P01_perd" />
    <bpmn:sequenceFlow id="P01_flujo_17" name="Sí" sourceRef="P01_gs" targetRef="P01_env" />
    <bpmn:textAnnotation id="P01_nota_n1"><bpmn:text>Ni la demo ni el carrito crean datos en Aether: todo llega por correo a ventas.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P01_titulo"><bpmn:text>P01 · Captación y contratación. Del formulario de demo o el carrito de módulos de la landing hasta los datos listos para dar de alta la empresa.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P02_proc_op" name="P02 · Supersuite" isExecutable="false">
    <bpmn:laneSet id="P02_carriles_op">
      <bpmn:lane id="P02_carril_opr" name="Operador de la consola">
        <bpmn:flowNodeRef>P02_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_cargar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_trans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P02_carril_api" name="API de la Supersuite">
        <bpmn:flowNodeRef>P02_enc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_okr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_apl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_fal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_ffal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_fic</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P02_i" name="Contrato aceptado">
      <bpmn:outgoing>P02_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P02_cargar" name="Cargar empresa.crear con los datos de alta">
      <bpmn:incoming>P02_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P02_trans" name="Revisar y transmitir">
      <bpmn:incoming>P02_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P02_enc" name="Guardar la orden en cola (pendiente)">
      <bpmn:incoming>P02_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P02_firm" name="Firmar y entregar por webhook">
      <bpmn:documentation>X-Supersuite-Firma: t=&lt;unix&gt;,v1=&lt;hmac&gt;. Ver P05 para reintentos.</bpmn:documentation>
      <bpmn:incoming>P02_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="P02_okr" name="Recibe el resultado">
      <bpmn:incoming>P02_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_25</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P02_gok" name="¿ok?">
      <bpmn:incoming>P02_flujo_25</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_26</bpmn:outgoing>
      <bpmn:outgoing>P02_flujo_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P02_apl" name="Marcar aplicada y avisar en vivo">
      <bpmn:incoming>P02_flujo_26</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P02_fal" name="Marcar fallida con el mensaje de Aether">
      <bpmn:incoming>P02_flujo_27</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P02_ffal" name="Se corrige y reintenta desde la bitácora">
      <bpmn:incoming>P02_flujo_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="P02_fic" name="Recibir la ficha: plan, módulos y tarifa">
      <bpmn:incoming>P02_flujo_29</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_30</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:manualTask id="P02_ent" name="Entregar el acceso al Dueño">
      <bpmn:incoming>P02_flujo_30</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_31</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="P02_fin" name="Empresa creada">
      <bpmn:incoming>P02_flujo_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P02_flujo_1" sourceRef="P02_i" targetRef="P02_cargar" />
    <bpmn:sequenceFlow id="P02_flujo_2" sourceRef="P02_cargar" targetRef="P02_trans" />
    <bpmn:sequenceFlow id="P02_flujo_3" sourceRef="P02_trans" targetRef="P02_enc" />
    <bpmn:sequenceFlow id="P02_flujo_4" sourceRef="P02_enc" targetRef="P02_firm" />
    <bpmn:sequenceFlow id="P02_flujo_5" sourceRef="P02_firm" targetRef="P02_okr" />
    <bpmn:sequenceFlow id="P02_flujo_25" sourceRef="P02_okr" targetRef="P02_gok" />
    <bpmn:sequenceFlow id="P02_flujo_26" name="Sí" sourceRef="P02_gok" targetRef="P02_apl" />
    <bpmn:sequenceFlow id="P02_flujo_27" name="No" sourceRef="P02_gok" targetRef="P02_fal" />
    <bpmn:sequenceFlow id="P02_flujo_28" sourceRef="P02_fal" targetRef="P02_ffal" />
    <bpmn:sequenceFlow id="P02_flujo_29" sourceRef="P02_apl" targetRef="P02_fic" />
    <bpmn:sequenceFlow id="P02_flujo_30" sourceRef="P02_fic" targetRef="P02_ent" />
    <bpmn:sequenceFlow id="P02_flujo_31" sourceRef="P02_ent" targetRef="P02_fin" />
    <bpmn:textAnnotation id="P02_nota_nb"><bpmn:text>Brecha: la consola todavía no ofrece empresa.crear (TIPOS_ORDEN). Aether ya la acepta.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P02_asoc_nb" associationDirection="None" sourceRef="P02_nota_nb" targetRef="P02_cargar" />
    <bpmn:textAnnotation id="P02_titulo"><bpmn:text>P02 · Alta de una empresa por orden firmada. La Supersuite transmite empresa.crear; Aether valida, crea la empresa con su Dueño en una transacción y confirma.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P02_proc_ae" name="P02 · Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P02_carriles_ae">
      <bpmn:lane id="P02_carril_wh" name="Webhook /api/supersuite/ordenes">
        <bpmn:flowNodeRef>P02_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_r401</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_resp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_fwh</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P02_carril_plat" name="Servicio de plataforma">
        <bpmn:flowNodeRef>P02_valp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_crear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_usr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_vinc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gmu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_aud</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P02_rec" name="Llega la orden">
      <bpmn:outgoing>P02_flujo_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P02_chk" name="Verificar firma y antigüedad">
      <bpmn:incoming>P02_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_gf" name="¿Firma válida?">
      <bpmn:incoming>P02_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_8</bpmn:outgoing>
      <bpmn:outgoing>P02_flujo_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P02_r401" name="Responder 401">
      <bpmn:incoming>P02_flujo_9</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="P02_valp" name="Validar plan, módulos y datos">
      <bpmn:documentation>planDeAether, flagsDeModulo y companyCreateSchema.</bpmn:documentation>
      <bpmn:incoming>P02_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_gv" name="¿Datos válidos?">
      <bpmn:incoming>P02_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_11</bpmn:outgoing>
      <bpmn:outgoing>P02_flujo_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P02_gr" name="¿RUT ya creado por esta vía?">
      <bpmn:incoming>P02_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_13</bpmn:outgoing>
      <bpmn:outgoing>P02_flujo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P02_crear" name="Crear empresa, módulos, ajustes y bodega principal">
      <bpmn:documentation>createTenant, dentro de prisma.$transaction.</bpmn:documentation>
      <bpmn:incoming>P02_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_gu" name="¿El Dueño ya tiene cuenta?">
      <bpmn:incoming>P02_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_16</bpmn:outgoing>
      <bpmn:outgoing>P02_flujo_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P02_usr" name="Crear Dueño con clave inicial (debe cambiarla)">
      <bpmn:incoming>P02_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P02_vinc" name="Vincular como Dueño y activar Multiempresa">
      <bpmn:incoming>P02_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_gmu" name="">
      <bpmn:incoming>P02_flujo_18</bpmn:incoming>
      <bpmn:incoming>P02_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P02_plan" name="Sembrar plan de cuentas si contrató Contabilidad">
      <bpmn:documentation>ensureChartOfAccounts.</bpmn:documentation>
      <bpmn:incoming>P02_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P02_aud" name="Registrar en bitácora como &quot;supersuite&quot;">
      <bpmn:documentation>createAuditLog: dispara el envío de la ficha a la Supersuite.</bpmn:documentation>
      <bpmn:incoming>P02_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_gres" name="">
      <bpmn:incoming>P02_flujo_12</bpmn:incoming>
      <bpmn:incoming>P02_flujo_14</bpmn:incoming>
      <bpmn:incoming>P02_flujo_22</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P02_resp" name="Responder 200 { ok, mensaje, empresaId }">
      <bpmn:incoming>P02_flujo_23</bpmn:incoming>
      <bpmn:outgoing>P02_flujo_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P02_fwh" name="Orden atendida">
      <bpmn:incoming>P02_flujo_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P02_flujo_6" sourceRef="P02_rec" targetRef="P02_chk" />
    <bpmn:sequenceFlow id="P02_flujo_7" sourceRef="P02_chk" targetRef="P02_gf" />
    <bpmn:sequenceFlow id="P02_flujo_8" name="Sí" sourceRef="P02_gf" targetRef="P02_valp" />
    <bpmn:sequenceFlow id="P02_flujo_9" name="No" sourceRef="P02_gf" targetRef="P02_r401" />
    <bpmn:sequenceFlow id="P02_flujo_10" sourceRef="P02_valp" targetRef="P02_gv" />
    <bpmn:sequenceFlow id="P02_flujo_11" name="Sí" sourceRef="P02_gv" targetRef="P02_gr" />
    <bpmn:sequenceFlow id="P02_flujo_12" name="No" sourceRef="P02_gv" targetRef="P02_gres" />
    <bpmn:sequenceFlow id="P02_flujo_13" name="No" sourceRef="P02_gr" targetRef="P02_crear" />
    <bpmn:sequenceFlow id="P02_flujo_14" name="Sí, reentrega" sourceRef="P02_gr" targetRef="P02_gres" />
    <bpmn:sequenceFlow id="P02_flujo_15" sourceRef="P02_crear" targetRef="P02_gu" />
    <bpmn:sequenceFlow id="P02_flujo_16" name="No" sourceRef="P02_gu" targetRef="P02_usr" />
    <bpmn:sequenceFlow id="P02_flujo_17" name="Sí" sourceRef="P02_gu" targetRef="P02_vinc" />
    <bpmn:sequenceFlow id="P02_flujo_18" sourceRef="P02_usr" targetRef="P02_gmu" />
    <bpmn:sequenceFlow id="P02_flujo_19" sourceRef="P02_vinc" targetRef="P02_gmu" />
    <bpmn:sequenceFlow id="P02_flujo_20" sourceRef="P02_gmu" targetRef="P02_plan" />
    <bpmn:sequenceFlow id="P02_flujo_21" sourceRef="P02_plan" targetRef="P02_aud" />
    <bpmn:sequenceFlow id="P02_flujo_22" sourceRef="P02_aud" targetRef="P02_gres" />
    <bpmn:sequenceFlow id="P02_flujo_23" sourceRef="P02_gres" targetRef="P02_resp" />
    <bpmn:sequenceFlow id="P02_flujo_24" sourceRef="P02_resp" targetRef="P02_fwh" />
    <bpmn:textAnnotation id="P02_nota_nt"><bpmn:text>Todo en una transacción: si algo falla no queda una empresa a medias.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P02_asoc_nt" associationDirection="None" sourceRef="P02_nota_nt" targetRef="P02_crear" />
  </bpmn:process>
  <bpmn:process id="P03_proc_emp" name="P03 · Puesta en marcha en Aether" isExecutable="false">
    <bpmn:laneSet id="P03_carriles_emp">
      <bpmn:lane id="P03_carril_due" name="Dueño o Administrador">
        <bpmn:flowNodeRef>P03_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_w1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_w2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_w3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_w4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_gp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_cafd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_cafs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_imp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_rol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_pc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_gj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_prueba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P03_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P03_forz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_wiz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_vcaf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_inv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P03_carril_col" name="Colaborador invitado">
        <bpmn:flowNodeRef>P03_ace</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P03_i" name="Recibe correo y clave inicial">
      <bpmn:outgoing>P03_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="P03_log" name="Iniciar sesión">
      <bpmn:documentation>Detalle del ingreso en P40.</bpmn:documentation>
      <bpmn:incoming>P03_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P03_forz" name="Exigir cambio de la clave inicial">
      <bpmn:incoming>P03_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P03_cc" name="Elegir su propia clave">
      <bpmn:incoming>P03_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P03_wiz" name="Abrir el asistente de inicio">
      <bpmn:incoming>P03_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P03_w1" name="Datos tributarios y tipo de industria">
      <bpmn:incoming>P03_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P03_w2" name="Bodega principal y caja POS">
      <bpmn:incoming>P03_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P03_w3" name="Primeros productos del catálogo">
      <bpmn:incoming>P03_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P03_w4" name="Invitar al equipo con su rol">
      <bpmn:incoming>P03_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P03_gp" name="">
      <bpmn:incoming>P03_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_10</bpmn:outgoing>
      <bpmn:outgoing>P03_flujo_14</bpmn:outgoing>
      <bpmn:outgoing>P03_flujo_17</bpmn:outgoing>
      <bpmn:outgoing>P03_flujo_19</bpmn:outgoing>
      <bpmn:outgoing>P03_flujo_21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="P03_cafd" name="Pedir y descargar el CAF en el SII">
      <bpmn:incoming>P03_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P03_cafs" name="Subir el CAF en Folios">
      <bpmn:incoming>P03_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P03_vcaf" name="Validar firma del SII y guardar cifrado">
      <bpmn:incoming>P03_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P03_imp" name="Importar contactos, stock e historial">
      <bpmn:documentation>Excel o CSV (exceljs + papaparse).</bpmn:documentation>
      <bpmn:incoming>P03_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P03_conf" name="Revisar la vista previa y confirmar">
      <bpmn:incoming>P03_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P03_rol" name="Ajustar roles, permisos y menú">
      <bpmn:documentation>Roles personalizados por empresa y Configuración → Módulos y menú.</bpmn:documentation>
      <bpmn:incoming>P03_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P03_pc" name="Revisar plan de cuentas y asientos automáticos">
      <bpmn:documentation>Solo con Contabilidad.</bpmn:documentation>
      <bpmn:incoming>P03_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P03_inv" name="Enviar invitaciones por correo">
      <bpmn:incoming>P03_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="P03_ace" name="Aceptar invitación y crear su clave">
      <bpmn:incoming>P03_flujo_22</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P03_gj" name="">
      <bpmn:incoming>P03_flujo_13</bpmn:incoming>
      <bpmn:incoming>P03_flujo_16</bpmn:incoming>
      <bpmn:incoming>P03_flujo_18</bpmn:incoming>
      <bpmn:incoming>P03_flujo_20</bpmn:incoming>
      <bpmn:incoming>P03_flujo_23</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_24</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="P03_prueba" name="Emitir un primer documento de prueba">
      <bpmn:incoming>P03_flujo_24</bpmn:incoming>
      <bpmn:outgoing>P03_flujo_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P03_fin" name="Empresa operando">
      <bpmn:incoming>P03_flujo_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P03_flujo_1" sourceRef="P03_i" targetRef="P03_log" />
    <bpmn:sequenceFlow id="P03_flujo_2" sourceRef="P03_log" targetRef="P03_forz" />
    <bpmn:sequenceFlow id="P03_flujo_3" sourceRef="P03_forz" targetRef="P03_cc" />
    <bpmn:sequenceFlow id="P03_flujo_4" sourceRef="P03_cc" targetRef="P03_wiz" />
    <bpmn:sequenceFlow id="P03_flujo_5" sourceRef="P03_wiz" targetRef="P03_w1" />
    <bpmn:sequenceFlow id="P03_flujo_6" sourceRef="P03_w1" targetRef="P03_w2" />
    <bpmn:sequenceFlow id="P03_flujo_7" sourceRef="P03_w2" targetRef="P03_w3" />
    <bpmn:sequenceFlow id="P03_flujo_8" sourceRef="P03_w3" targetRef="P03_w4" />
    <bpmn:sequenceFlow id="P03_flujo_9" sourceRef="P03_w4" targetRef="P03_gp" />
    <bpmn:sequenceFlow id="P03_flujo_10" sourceRef="P03_gp" targetRef="P03_cafd" />
    <bpmn:sequenceFlow id="P03_flujo_11" sourceRef="P03_cafd" targetRef="P03_cafs" />
    <bpmn:sequenceFlow id="P03_flujo_12" sourceRef="P03_cafs" targetRef="P03_vcaf" />
    <bpmn:sequenceFlow id="P03_flujo_13" sourceRef="P03_vcaf" targetRef="P03_gj" />
    <bpmn:sequenceFlow id="P03_flujo_14" sourceRef="P03_gp" targetRef="P03_imp" />
    <bpmn:sequenceFlow id="P03_flujo_15" sourceRef="P03_imp" targetRef="P03_conf" />
    <bpmn:sequenceFlow id="P03_flujo_16" sourceRef="P03_conf" targetRef="P03_gj" />
    <bpmn:sequenceFlow id="P03_flujo_17" sourceRef="P03_gp" targetRef="P03_rol" />
    <bpmn:sequenceFlow id="P03_flujo_18" sourceRef="P03_rol" targetRef="P03_gj" />
    <bpmn:sequenceFlow id="P03_flujo_19" sourceRef="P03_gp" targetRef="P03_pc" />
    <bpmn:sequenceFlow id="P03_flujo_20" sourceRef="P03_pc" targetRef="P03_gj" />
    <bpmn:sequenceFlow id="P03_flujo_21" sourceRef="P03_gp" targetRef="P03_inv" />
    <bpmn:sequenceFlow id="P03_flujo_22" sourceRef="P03_inv" targetRef="P03_ace" />
    <bpmn:sequenceFlow id="P03_flujo_23" sourceRef="P03_ace" targetRef="P03_gj" />
    <bpmn:sequenceFlow id="P03_flujo_24" sourceRef="P03_gj" targetRef="P03_prueba" />
    <bpmn:sequenceFlow id="P03_flujo_25" sourceRef="P03_prueba" targetRef="P03_fin" />
    <bpmn:textAnnotation id="P03_nota_n1"><bpmn:text>Aparece con ≤ 1 bodega, 0 productos y 0 invitaciones. Cada paso se puede omitir.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P03_asoc_n1" associationDirection="None" sourceRef="P03_nota_n1" targetRef="P03_wiz" />
    <bpmn:textAnnotation id="P03_nota_n2"><bpmn:text>Sin CAF se emite con numeración interna: sin timbre ni validez tributaria.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P03_asoc_n2" associationDirection="None" sourceRef="P03_nota_n2" targetRef="P03_vcaf" />
    <bpmn:textAnnotation id="P03_titulo"><bpmn:text>P03 · Puesta en marcha de la empresa. Primer ingreso del Dueño, asistente de inicio en cuatro pasos y la carga en paralelo de folios, datos, accesos y contabilidad.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P04_proc_emp" name="P04 · Empresa cliente (Aether)" isExecutable="false">
    <bpmn:laneSet id="P04_carriles_emp">
      <bpmn:lane id="P04_carril_due" name="Dueño o Administrador">
        <bpmn:flowNodeRef>P04_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_sel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_usa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_fu</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P04_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_al</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_fs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_os</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_vf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_cerr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_resp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_av</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P04_i" name="Necesita otro módulo o plan">
      <bpmn:outgoing>P04_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P04_sel" name="Armar selección en Planes y módulos">
      <bpmn:incoming>P04_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P04_cot" name="Recalcular la cotización en el servidor">
      <bpmn:incoming>P04_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P04_rev" name="Revisar precio y enviar solicitud">
      <bpmn:incoming>P04_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P04_req" name="Avisar por correo a ventas">
      <bpmn:incoming>P04_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="P04_al" name="Abrir alerta solicitud-modulos">
      <bpmn:incoming>P04_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P04_fs" name="Solicitud enviada">
      <bpmn:incoming>P04_flujo_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P04_os" name="Llega una orden firmada">
      <bpmn:outgoing>P04_flujo_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P04_vf" name="Verificar firma y aplicar el cambio">
      <bpmn:documentation>updateTenantPlan con companyPlanUpdateSchema.</bpmn:documentation>
      <bpmn:incoming>P04_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P04_cerr" name="Bitácora, cerrar la alerta y reenviar la ficha">
      <bpmn:documentation>solicitudModulosAtendidaSupersuite + createAuditLog.</bpmn:documentation>
      <bpmn:incoming>P04_flujo_18</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P04_resp" name="Responder { ok, mensaje, tarifa }">
      <bpmn:incoming>P04_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="P04_av" name="Revalidar el menú de la empresa">
      <bpmn:incoming>P04_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P04_usa" name="Usar el módulo nuevo">
      <bpmn:incoming>P04_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P04_fu" name="Módulo en uso">
      <bpmn:incoming>P04_flujo_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P04_flujo_1" sourceRef="P04_i" targetRef="P04_sel" />
    <bpmn:sequenceFlow id="P04_flujo_2" sourceRef="P04_sel" targetRef="P04_cot" />
    <bpmn:sequenceFlow id="P04_flujo_3" sourceRef="P04_cot" targetRef="P04_rev" />
    <bpmn:sequenceFlow id="P04_flujo_4" sourceRef="P04_rev" targetRef="P04_req" />
    <bpmn:sequenceFlow id="P04_flujo_5" sourceRef="P04_req" targetRef="P04_al" />
    <bpmn:sequenceFlow id="P04_flujo_6" sourceRef="P04_al" targetRef="P04_fs" />
    <bpmn:sequenceFlow id="P04_flujo_17" sourceRef="P04_os" targetRef="P04_vf" />
    <bpmn:sequenceFlow id="P04_flujo_18" sourceRef="P04_vf" targetRef="P04_cerr" />
    <bpmn:sequenceFlow id="P04_flujo_19" sourceRef="P04_cerr" targetRef="P04_resp" />
    <bpmn:sequenceFlow id="P04_flujo_20" sourceRef="P04_resp" targetRef="P04_av" />
    <bpmn:sequenceFlow id="P04_flujo_21" sourceRef="P04_av" targetRef="P04_usa" />
    <bpmn:sequenceFlow id="P04_flujo_22" sourceRef="P04_usa" targetRef="P04_fu" />
    <bpmn:textAnnotation id="P04_nota_n1"><bpmn:text>Un plan nuevo suma módulos y topes; quitar es una orden aparte (modulo.desactivar).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P04_asoc_n1" associationDirection="None" sourceRef="P04_nota_n1" targetRef="P04_vf" />
    <bpmn:textAnnotation id="P04_titulo"><bpmn:text>P04 · Cambio de plan o módulos. La empresa arma y pide módulos desde Aether; la Supersuite aprueba de un clic y transmite solo lo que falta.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P04_proc_ss" name="P04 · Supersuite" isExecutable="false">
    <bpmn:laneSet id="P04_carriles_ss">
      <bpmn:lane id="P04_carril_api" name="API y panel en vivo">
        <bpmn:flowNodeRef>P04_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_mos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_tx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_cie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_fap</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_carril_opr" name="Operador de la consola">
        <bpmn:flowNodeRef>P04_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_frech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_apr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P04_rec" name="Llega la solicitud con su detalle">
      <bpmn:outgoing>P04_flujo_7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P04_mos" name="Mostrarla en Cobros, Alertas y la ficha">
      <bpmn:incoming>P04_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P04_dec" name="Revisar la solicitud">
      <bpmn:incoming>P04_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P04_gd" name="¿Se aprueba?">
      <bpmn:incoming>P04_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_10</bpmn:outgoing>
      <bpmn:outgoing>P04_flujo_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P04_rech" name="Responder a la empresa y cerrar la alerta">
      <bpmn:incoming>P04_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P04_frech" name="Cerrada sin cambios">
      <bpmn:incoming>P04_flujo_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P04_apr" name="Aprobar de un clic">
      <bpmn:incoming>P04_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P04_tx" name="Transmitir solo lo que falta">
      <bpmn:incoming>P04_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="P04_res" name="Recibe el resultado">
      <bpmn:incoming>P04_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_15</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P04_cie" name="Marcar aplicadas y cerrar la solicitud">
      <bpmn:incoming>P04_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P04_flujo_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P04_fap" name="Plan y módulos al día">
      <bpmn:incoming>P04_flujo_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P04_flujo_7" sourceRef="P04_rec" targetRef="P04_mos" />
    <bpmn:sequenceFlow id="P04_flujo_8" sourceRef="P04_mos" targetRef="P04_dec" />
    <bpmn:sequenceFlow id="P04_flujo_9" sourceRef="P04_dec" targetRef="P04_gd" />
    <bpmn:sequenceFlow id="P04_flujo_10" name="Sí" sourceRef="P04_gd" targetRef="P04_apr" />
    <bpmn:sequenceFlow id="P04_flujo_11" name="No" sourceRef="P04_gd" targetRef="P04_rech" />
    <bpmn:sequenceFlow id="P04_flujo_12" sourceRef="P04_rech" targetRef="P04_frech" />
    <bpmn:sequenceFlow id="P04_flujo_13" sourceRef="P04_apr" targetRef="P04_tx" />
    <bpmn:sequenceFlow id="P04_flujo_14" sourceRef="P04_tx" targetRef="P04_res" />
    <bpmn:sequenceFlow id="P04_flujo_15" sourceRef="P04_res" targetRef="P04_cie" />
    <bpmn:sequenceFlow id="P04_flujo_16" sourceRef="P04_cie" targetRef="P04_fap" />
  </bpmn:process>
  <bpmn:process id="P05_proc_ss" name="P05 · Supersuite" isExecutable="false">
    <bpmn:laneSet id="P05_carriles_ss">
      <bpmn:lane id="P05_carril_opr" name="Operador de la consola">
        <bpmn:flowNodeRef>P05_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_rv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P05_carril_api" name="API: entregas">
        <bpmn:flowNodeRef>P05_enc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_gp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_tp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_ge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_to</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_gok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_apl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_sse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_fa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_gi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_esp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_gm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_fal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_avf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_ff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P05_carril_wk" name="Worker (limpieza)">
        <bpmn:flowNodeRef>P05_wi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_ven</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_fe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_wf</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P05_i" name="Cambios en borrador en la consola">
      <bpmn:outgoing>P05_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P05_rv" name="Revisar impacto en el ingreso y transmitir">
      <bpmn:incoming>P05_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P05_enc" name="Crear el lote (todas o ninguna): pendiente">
      <bpmn:incoming>P05_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P05_gp" name="¿Programada para después?">
      <bpmn:incoming>P05_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_4</bpmn:outgoing>
      <bpmn:outgoing>P05_flujo_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="P05_tp" name="Llega ejecutar_en">
      <bpmn:incoming>P05_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_6</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P05_gm" name="">
      <bpmn:incoming>P05_flujo_4</bpmn:incoming>
      <bpmn:incoming>P05_flujo_6</bpmn:incoming>
      <bpmn:incoming>P05_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P05_ent" name="Entregar por webhook firmado: entregado">
      <bpmn:incoming>P05_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="P05_ge" name="">
      <bpmn:incoming>P05_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_9</bpmn:outgoing>
      <bpmn:outgoing>P05_flujo_10</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P05_ok" name="Respuesta 200">
      <bpmn:incoming>P05_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P05_to" name="Error, 401 u 8 s sin respuesta">
      <bpmn:incoming>P05_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_17</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P05_gok" name="¿ok: true?">
      <bpmn:incoming>P05_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_12</bpmn:outgoing>
      <bpmn:outgoing>P05_flujo_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P05_apl" name="Marcar aplicada y actualizar la copia de la cuenta">
      <bpmn:incoming>P05_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P05_sol" name="Cerrar la solicitud si ya se aplicó todo">
      <bpmn:incoming>P05_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P05_sse" name="Avisar en vivo (SSE)">
      <bpmn:incoming>P05_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P05_fa" name="Aplicada">
      <bpmn:incoming>P05_flujo_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P05_gi" name="¿Quedan intentos?">
      <bpmn:incoming>P05_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_18</bpmn:outgoing>
      <bpmn:outgoing>P05_flujo_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="P05_esp" name="Esperar 10 s, 20 s, 40 s… (máx. 10 min)">
      <bpmn:incoming>P05_flujo_18</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_20</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P05_gm2" name="">
      <bpmn:incoming>P05_flujo_13</bpmn:incoming>
      <bpmn:incoming>P05_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P05_fal" name="Marcar fallida con el mensaje">
      <bpmn:incoming>P05_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P05_avf" name="Aviso emergente en todo el panel">
      <bpmn:incoming>P05_flujo_22</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P05_ff" name="Fallida">
      <bpmn:incoming>P05_flujo_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P05_wi" name="Cada minuto">
      <bpmn:outgoing>P05_flujo_24</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">* * * * *</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P05_ven" name="Vencer las que nadie recogió en 72 h">
      <bpmn:incoming>P05_flujo_24</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P05_fe" name="Dar por fallidas las entregadas sin confirmar">
      <bpmn:incoming>P05_flujo_25</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P05_wf" name="Cola limpia">
      <bpmn:incoming>P05_flujo_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P05_flujo_1" sourceRef="P05_i" targetRef="P05_rv" />
    <bpmn:sequenceFlow id="P05_flujo_2" sourceRef="P05_rv" targetRef="P05_enc" />
    <bpmn:sequenceFlow id="P05_flujo_3" sourceRef="P05_enc" targetRef="P05_gp" />
    <bpmn:sequenceFlow id="P05_flujo_4" name="No" sourceRef="P05_gp" targetRef="P05_gm" />
    <bpmn:sequenceFlow id="P05_flujo_5" name="Sí" sourceRef="P05_gp" targetRef="P05_tp" />
    <bpmn:sequenceFlow id="P05_flujo_6" sourceRef="P05_tp" targetRef="P05_gm" />
    <bpmn:sequenceFlow id="P05_flujo_7" sourceRef="P05_gm" targetRef="P05_ent" />
    <bpmn:sequenceFlow id="P05_flujo_8" sourceRef="P05_ent" targetRef="P05_ge" />
    <bpmn:sequenceFlow id="P05_flujo_9" sourceRef="P05_ge" targetRef="P05_ok" />
    <bpmn:sequenceFlow id="P05_flujo_10" sourceRef="P05_ge" targetRef="P05_to" />
    <bpmn:sequenceFlow id="P05_flujo_11" sourceRef="P05_ok" targetRef="P05_gok" />
    <bpmn:sequenceFlow id="P05_flujo_12" name="Sí" sourceRef="P05_gok" targetRef="P05_apl" />
    <bpmn:sequenceFlow id="P05_flujo_13" name="No" sourceRef="P05_gok" targetRef="P05_gm2" />
    <bpmn:sequenceFlow id="P05_flujo_14" sourceRef="P05_apl" targetRef="P05_sol" />
    <bpmn:sequenceFlow id="P05_flujo_15" sourceRef="P05_sol" targetRef="P05_sse" />
    <bpmn:sequenceFlow id="P05_flujo_16" sourceRef="P05_sse" targetRef="P05_fa" />
    <bpmn:sequenceFlow id="P05_flujo_17" sourceRef="P05_to" targetRef="P05_gi" />
    <bpmn:sequenceFlow id="P05_flujo_18" name="Sí" sourceRef="P05_gi" targetRef="P05_esp" />
    <bpmn:sequenceFlow id="P05_flujo_19" name="No" sourceRef="P05_gi" targetRef="P05_gm2" />
    <bpmn:sequenceFlow id="P05_flujo_20" sourceRef="P05_esp" targetRef="P05_gm" />
    <bpmn:sequenceFlow id="P05_flujo_21" sourceRef="P05_gm2" targetRef="P05_fal" />
    <bpmn:sequenceFlow id="P05_flujo_22" sourceRef="P05_fal" targetRef="P05_avf" />
    <bpmn:sequenceFlow id="P05_flujo_23" sourceRef="P05_avf" targetRef="P05_ff" />
    <bpmn:sequenceFlow id="P05_flujo_24" sourceRef="P05_wi" targetRef="P05_ven" />
    <bpmn:sequenceFlow id="P05_flujo_25" sourceRef="P05_ven" targetRef="P05_fe" />
    <bpmn:sequenceFlow id="P05_flujo_26" sourceRef="P05_fe" targetRef="P05_wf" />
    <bpmn:textAnnotation id="P05_nota_n1"><bpmn:text>Estados: pendiente → entregado → aplicado | fallido | cancelado | vencido.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P05_nota_n2"><bpmn:text>Aether corre en Vercel: recibe por webhook. El SDK también puede consultar cada 5 s (reclamar).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P05_nota_n3"><bpmn:text>Fallidas, vencidas o canceladas se reintentan desde la bitácora.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P05_titulo"><bpmn:text>P05 · Ciclo de vida de una orden de la Supersuite. Cómo viaja una orden de la consola a Aether: cola, entrega firmada, reintentos, confirmación y vencimiento.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P05_proc_ae" name="P05 · Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P05_carriles_ae">
      <bpmn:lane id="P05_carril_wh" name="Webhook de órdenes">
        <bpmn:flowNodeRef>P05_rx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_vf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_gv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_f401</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_man</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_res</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P05_rx" name="Llega POST firmado">
      <bpmn:outgoing>P05_flujo_27</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P05_vf" name="Verificar firma (≤ 5 min)">
      <bpmn:incoming>P05_flujo_27</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P05_gv" name="¿Firma válida?">
      <bpmn:incoming>P05_flujo_28</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_29</bpmn:outgoing>
      <bpmn:outgoing>P05_flujo_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P05_f401" name="401">
      <bpmn:incoming>P05_flujo_30</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="P05_man" name="Aplicar con el manejador del tipo (idempotente)">
      <bpmn:incoming>P05_flujo_29</bpmn:incoming>
      <bpmn:outgoing>P05_flujo_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P05_res" name="200 { ok, mensaje, datos }">
      <bpmn:incoming>P05_flujo_31</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P05_flujo_27" sourceRef="P05_rx" targetRef="P05_vf" />
    <bpmn:sequenceFlow id="P05_flujo_28" sourceRef="P05_vf" targetRef="P05_gv" />
    <bpmn:sequenceFlow id="P05_flujo_29" name="Sí" sourceRef="P05_gv" targetRef="P05_man" />
    <bpmn:sequenceFlow id="P05_flujo_30" name="No" sourceRef="P05_gv" targetRef="P05_f401" />
    <bpmn:sequenceFlow id="P05_flujo_31" sourceRef="P05_man" targetRef="P05_res" />
  </bpmn:process>
  <bpmn:process id="P06_proc_ae" name="P06 · Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P06_carriles_ae">
      <bpmn:lane id="P06_carril_ev" name="Puntos centrales de Aether">
        <bpmn:flowNodeRef>P06_a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_e1</bpmn:flowNodeRef>
