    <bpmn:textAnnotation id="P20_nota_n1"><bpmn:text>De una candidata solo sale nombre artístico, número, representación, foto y bio pública.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P20_nota_n2"><bpmn:text>Los afiches nunca inventan un dato: una pieza sin su dato no está disponible.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P20_asoc_n2" associationDirection="None" sourceRef="P20_nota_n2" targetRef="P20_afi" />
    <bpmn:textAnnotation id="P20_titulo"><bpmn:text>P20 · Preparación y lanzamiento del certamen. Proyecto con presupuesto, convocatoria, micrositio, auspicios, entradas y jurado en paralelo, checklist del centro de mando y campaña.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P20_area_eventos"><bpmn:text>Producción de certámenes (P20, P21, P22, P23, P24, P25, P26, P27)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
