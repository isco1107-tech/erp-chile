      <bpmn:incoming>P27_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P27_flujo_21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P27_fcr" name="Recordatorios enviados">
      <bpmn:incoming>P27_flujo_21</bpmn:incoming>
    </bpmn:endEvent>
