    <bpmn:sequenceFlow id="P27_flujo_17" sourceRef="P27_mail" targetRef="P27_fin" />
    <bpmn:sequenceFlow id="P27_flujo_18" sourceRef="P27_exp" targetRef="P27_fexp" />
    <bpmn:sequenceFlow id="P27_flujo_19" sourceRef="P27_fexp" targetRef="P27_ffe" />
    <bpmn:sequenceFlow id="P27_flujo_20" sourceRef="P27_cr" targetRef="P27_rec" />
    <bpmn:sequenceFlow id="P27_flujo_21" sourceRef="P27_rec" targetRef="P27_fcr" />
    <bpmn:textAnnotation id="P27_nota_n1"><bpmn:text>Ni la notificación ni el retorno del navegador marcan algo como pagado: solo la consulta a Khipu.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P27_asoc_n1" associationDirection="None" sourceRef="P27_nota_n1" targetRef="P27_paid" />
    <bpmn:textAnnotation id="P27_nota_n2"><bpmn:text>La API key de Khipu es por empresa, cifrada; solo la edita settings:company.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P27_titulo"><bpmn:text>P27 · Pago en línea de cuotas (Khipu). Portal público por RUT de la beneficiaria, cobro en Khipu, confirmación solo consultando a Khipu, comprobante numerado y correo.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P30_proc_ae" name="P30 · Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P30_carriles_ae">
      <bpmn:lane id="P30_carril_ed" name="Editor del sitio">
        <bpmn:flowNodeRef>P30_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_pla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_gmo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_blo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_htm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_gm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_pub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P30_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P30_rdy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_gp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_cp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_dom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_gm3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_live</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P30_i" name="Necesita un sitio">
      <bpmn:outgoing>P30_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P30_pla" name="Elegir el propósito y la plantilla">
      <bpmn:incoming>P30_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P30_gmo" name="¿Qué modo?">
      <bpmn:incoming>P30_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P30_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P30_flujo_4</bpmn:outgoing>
