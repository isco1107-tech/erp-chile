    <bpmn:textAnnotation id="P25_nota_n1"><bpmn:text>El resultado se recalcula en cada consulta; nunca se guarda.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P25_asoc_n1" associationDirection="None" sourceRef="P25_nota_n1" targetRef="P25_res" />
    <bpmn:textAnnotation id="P25_nota_n2"><bpmn:text>Una ronda que ya entró en votación no se borra: se reabre para corregir.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P26_proc_ae" name="P26 · Aether ERP" isExecutable="false">
