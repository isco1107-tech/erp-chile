    <bpmn:sequenceFlow id="P08_flujo_9" sourceRef="P08_ci2" targetRef="P08_gci" />
    <bpmn:sequenceFlow id="P08_flujo_10" name="No" sourceRef="P08_gci" targetRef="P08_fix" />
    <bpmn:sequenceFlow id="P08_flujo_11" sourceRef="P08_fix" targetRef="P08_pr" />
    <bpmn:sequenceFlow id="P08_flujo_12" name="Sí" sourceRef="P08_gci" targetRef="P08_rev" />
    <bpmn:sequenceFlow id="P08_flujo_13" sourceRef="P08_rev" targetRef="P08_vb" />
    <bpmn:sequenceFlow id="P08_flujo_14" sourceRef="P08_vb" targetRef="P08_mg" />
    <bpmn:sequenceFlow id="P08_flujo_15" sourceRef="P08_mg" targetRef="P08_gmo" />
    <bpmn:sequenceFlow id="P08_flujo_16" name="Sí" sourceRef="P08_gmo" targetRef="P08_cmp" />
    <bpmn:sequenceFlow id="P08_flujo_17" name="No" sourceRef="P08_gmo" targetRef="P08_falla" />
    <bpmn:sequenceFlow id="P08_flujo_18" sourceRef="P08_falla" targetRef="P08_ff" />
    <bpmn:sequenceFlow id="P08_flujo_19" sourceRef="P08_cmp" targetRef="P08_pub" />
    <bpmn:sequenceFlow id="P08_flujo_20" sourceRef="P08_pub" targetRef="P08_fok" />
    <bpmn:textAnnotation id="P08_nota_n1"><bpmn:text>La base local es la de producción: aplicar una migración obliga a desplegar enseguida.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P08_asoc_n1" associationDirection="None" sourceRef="P08_nota_n1" targetRef="P08_diff" />
    <bpmn:textAnnotation id="P08_titulo"><bpmn:text>P08 · Despliegue y migraciones. De la rama al aire: CI, revisión, migraciones aplicadas en el build de Vercel y la Supersuite en Render.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P08_proc_rs" name="P08 · Supersuite en Render" isExecutable="false">
    <bpmn:laneSet id="P08_carriles_rs">
      <bpmn:lane id="P08_carril_rd" name="Blueprint render.yaml">
        <bpmn:flowNodeRef>P08_ri</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rpre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rgm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rfin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P08_ri" name="Push a main de la Supersuite">
      <bpmn:outgoing>P08_flujo_21</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P08_rpre" name="preDeploy: npm run db:migrar">
      <bpmn:incoming>P08_flujo_21</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P08_rgm" name="¿Migró?">
      <bpmn:incoming>P08_flujo_22</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_23</bpmn:outgoing>
      <bpmn:outgoing>P08_flujo_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P08_rf" name="Despliegue detenido">
      <bpmn:incoming>P08_flujo_24</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="P08_rup" name="Levantar API, worker y panel">
      <bpmn:incoming>P08_flujo_23</bpmn:incoming>
      <bpmn:outgoing>P08_flujo_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P08_rfin" name="Supersuite actualizada">
      <bpmn:incoming>P08_flujo_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P08_flujo_21" sourceRef="P08_ri" targetRef="P08_rpre" />
    <bpmn:sequenceFlow id="P08_flujo_22" sourceRef="P08_rpre" targetRef="P08_rgm" />
    <bpmn:sequenceFlow id="P08_flujo_23" name="Sí" sourceRef="P08_rgm" targetRef="P08_rup" />
    <bpmn:sequenceFlow id="P08_flujo_24" name="No" sourceRef="P08_rgm" targetRef="P08_rf" />
    <bpmn:sequenceFlow id="P08_flujo_25" sourceRef="P08_rup" targetRef="P08_rfin" />
  </bpmn:process>
  <bpmn:process id="P09_proc_ss" name="P09 · Supersuite" isExecutable="false">
    <bpmn:laneSet id="P09_carriles_ss">
      <bpmn:lane id="P09_carril_adm" name="Admin de la Supersuite">
        <bpmn:flowNodeRef>P09_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_alta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_key</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_wh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_ping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_fic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_off</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P09_carril_api" name="API de la Supersuite">
        <bpmn:flowNodeRef>P09_tx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_ver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_tx2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_rcv</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P09_i" name="Primera conexión">
      <bpmn:outgoing>P09_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P09_alta" name="Registrar el producto aether con sus módulos">
      <bpmn:incoming>P09_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P09_key" name="Crear API key">
      <bpmn:incoming>P09_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P09_wh" name="Poner la URL del webhook y generar el secreto">
      <bpmn:documentation>https://aetherp.online/api/supersuite/ordenes</bpmn:documentation>
      <bpmn:incoming>P09_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P09_ping" name="Probar con un ping">
      <bpmn:incoming>P09_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P09_tx" name="Entregar ping firmado">
      <bpmn:incoming>P09_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P09_ver" name="Marcar la conexión como escuchando">
      <bpmn:incoming>P09_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P09_fic" name="Pedir todas las fichas">
      <bpmn:incoming>P09_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P09_tx2" name="Entregar ficha.sincronizar">
      <bpmn:incoming>P09_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P09_rcv" name="Recibir las fichas">
      <bpmn:incoming>P09_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P09_off" name="Apagar la fase 1 (lectura directa)">
      <bpmn:incoming>P09_flujo_10</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P09_fin" name="Conexión en tiempo real">
      <bpmn:incoming>P09_flujo_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P09_flujo_1" sourceRef="P09_i" targetRef="P09_alta" />
    <bpmn:sequenceFlow id="P09_flujo_2" sourceRef="P09_alta" targetRef="P09_key" />
    <bpmn:sequenceFlow id="P09_flujo_3" sourceRef="P09_key" targetRef="P09_wh" />
    <bpmn:sequenceFlow id="P09_flujo_4" sourceRef="P09_wh" targetRef="P09_ping" />
    <bpmn:sequenceFlow id="P09_flujo_5" sourceRef="P09_ping" targetRef="P09_tx" />
    <bpmn:sequenceFlow id="P09_flujo_6" sourceRef="P09_tx" targetRef="P09_ver" />
    <bpmn:sequenceFlow id="P09_flujo_7" sourceRef="P09_ver" targetRef="P09_fic" />
    <bpmn:sequenceFlow id="P09_flujo_8" sourceRef="P09_fic" targetRef="P09_tx2" />
    <bpmn:sequenceFlow id="P09_flujo_9" sourceRef="P09_tx2" targetRef="P09_rcv" />
    <bpmn:sequenceFlow id="P09_flujo_10" sourceRef="P09_rcv" targetRef="P09_off" />
    <bpmn:sequenceFlow id="P09_flujo_11" sourceRef="P09_off" targetRef="P09_fin" />
    <bpmn:textAnnotation id="P09_nota_n1"><bpmn:text>Con las dos fases encendidas los eventos se cuentan dos veces: la fase 1 se apaga tras cargar la historia.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P09_titulo"><bpmn:text>P09 · Conexión Aether ↔ Supersuite. Puesta en marcha de la integración: producto, API key, webhook y secreto, variables en Vercel, ping y carga de fichas.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P09_proc_ae" name="P09 · Aether" isExecutable="false">
    <bpmn:laneSet id="P09_carriles_ae">
      <bpmn:lane id="P09_carril_dev" name="Administrador de Aether (Vercel)">
        <bpmn:flowNodeRef>P09_rc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_vars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_red</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P09_carril_sis" name="Aether en producción">
        <bpmn:flowNodeRef>P09_up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_fu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_pi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_po</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_fi2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_rf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_ff</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P09_rc" name="Recibe key y secreto">
      <bpmn:outgoing>P09_flujo_12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="P09_vars" name="Cargar las tres variables en Vercel">
      <bpmn:incoming>P09_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P09_red" name="Redesplegar">
      <bpmn:incoming>P09_flujo_13</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P09_up" name="Arranca con telemetría y webhook activos">
      <bpmn:incoming>P09_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P09_fu" name="En línea">
      <bpmn:incoming>P09_flujo_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P09_pi" name="Llega ping">
      <bpmn:outgoing>P09_flujo_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:endEvent id="P09_po" name="pong con versión del SDK">
      <bpmn:incoming>P09_flujo_16</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:startEvent id="P09_fi2" name="Llega ficha.sincronizar">
      <bpmn:outgoing>P09_flujo_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:sendTask id="P09_rf" name="Reenviar la ficha de cada empresa">
      <bpmn:incoming>P09_flujo_17</bpmn:incoming>
      <bpmn:outgoing>P09_flujo_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P09_ff" name="Fichas enviadas">
      <bpmn:incoming>P09_flujo_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P09_flujo_12" sourceRef="P09_rc" targetRef="P09_vars" />
    <bpmn:sequenceFlow id="P09_flujo_13" sourceRef="P09_vars" targetRef="P09_red" />
    <bpmn:sequenceFlow id="P09_flujo_14" sourceRef="P09_red" targetRef="P09_up" />
    <bpmn:sequenceFlow id="P09_flujo_15" sourceRef="P09_up" targetRef="P09_fu" />
    <bpmn:sequenceFlow id="P09_flujo_16" sourceRef="P09_pi" targetRef="P09_po" />
    <bpmn:sequenceFlow id="P09_flujo_17" sourceRef="P09_fi2" targetRef="P09_rf" />
    <bpmn:sequenceFlow id="P09_flujo_18" sourceRef="P09_rf" targetRef="P09_ff" />
  </bpmn:process>
  <bpmn:process id="P10_proc_ae" name="P10 · Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P10_carriles_ae">
      <bpmn:lane id="P10_carril_ven" name="Vendedor">
        <bpmn:flowNodeRef>P10_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_ge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_acep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_vence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_emi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P10_carril_sis" name="Sistema Aether">
        <bpmn:flowNodeRef>P10_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_gcr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_gcaf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_ted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_stk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_gpg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_cob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_gm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_wf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_env</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_gs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fv2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P10_carril_tes" name="Tesorería y cobranza">
        <bpmn:flowNodeRef>P10_gmc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_gev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_venc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_regp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_gpar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fpag</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P10_i" name="Cliente pide precio o compra">
      <bpmn:outgoing>P10_flujo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="P10_cot" name="Preparar cotización (sin folio ni timbre)">
      <bpmn:documentation>Una cotización no es DTE (isDte).</bpmn:documentation>
      <bpmn:incoming>P10_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="P10_ge" name="">
      <bpmn:incoming>P10_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_3</bpmn:outgoing>
      <bpmn:outgoing>P10_flujo_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P10_acep" name="Cliente acepta">
      <bpmn:incoming>P10_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P10_vence" name="Vence la cotización">
      <bpmn:incoming>P10_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_5</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="P10_fv" name="Cotización perdida">
      <bpmn:incoming>P10_flujo_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P10_emi" name="Emitir factura, boleta o guía">
      <bpmn:documentation>Puede venir de una nota de venta, que avanza lo facturado en la misma transacción. Manda idempotencyKey.</bpmn:documentation>
      <bpmn:incoming>P10_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P10_val" name="Validar cliente, bodega y líneas; exento desde el catálogo">
      <bpmn:incoming>P10_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P10_gcr" name="¿A crédito y sobre el límite?">
      <bpmn:incoming>P10_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_9</bpmn:outgoing>
      <bpmn:outgoing>P10_flujo_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P10_rech" name="Rechazada por límite de crédito">
      <bpmn:incoming>P10_flujo_10</bpmn:incoming>
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="P10_fol" name="Asignar folio: CAF con FOR UPDATE o contador interno">
      <bpmn:documentation>assignSalesFolio.</bpmn:documentation>
      <bpmn:incoming>P10_flujo_9</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P10_gcaf" name="¿Folio de un CAF?">
      <bpmn:incoming>P10_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_12</bpmn:outgoing>
      <bpmn:outgoing>P10_flujo_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P10_ted" name="Timbrar (TED con la llave del CAF) y armar el XML">
      <bpmn:documentation>RSA-SHA1. El bloque DA del CAF viaja byte a byte: nunca se reserializa.</bpmn:documentation>
      <bpmn:incoming>P10_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P10_gm" name="">
      <bpmn:incoming>P10_flujo_13</bpmn:incoming>
      <bpmn:incoming>P10_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P10_stk" name="Kardex al PMP vigente y asiento contable">
      <bpmn:documentation>applyStockOut lee el PMP bajo bloqueo; el asiento nace en la misma transacción.</bpmn:documentation>
      <bpmn:incoming>P10_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P10_gpg" name="¿Forma de pago?">
      <bpmn:incoming>P10_flujo_16</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_17</bpmn:outgoing>
      <bpmn:outgoing>P10_flujo_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P10_cob" name="Registrar el cobro (Payment)">
      <bpmn:incoming>P10_flujo_18</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P10_gm2" name="">
      <bpmn:incoming>P10_flujo_17</bpmn:incoming>
      <bpmn:incoming>P10_flujo_19</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P10_wf" name="Confirmar y disparar automatizaciones">
      <bpmn:incoming>P10_flujo_20</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P10_env" name="Enviar documento y PDF al cliente">
      <bpmn:incoming>P10_flujo_21</bpmn:incoming>
