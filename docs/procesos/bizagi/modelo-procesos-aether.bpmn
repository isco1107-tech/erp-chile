    <bpmn:sequenceFlow id="P00_flujo_14" sourceRef="P00_dig" targetRef="P00_gj" />
    <bpmn:sequenceFlow id="P00_flujo_15" sourceRef="P00_p06" targetRef="P00_gj" />
    <bpmn:sequenceFlow id="P00_flujo_16" sourceRef="P00_p07" targetRef="P00_gj" />
    <bpmn:sequenceFlow id="P00_flujo_17" sourceRef="P00_gj" targetRef="P00_gd" />
    <bpmn:sequenceFlow id="P00_flujo_18" name="Se da de baja" sourceRef="P00_gd" targetRef="P00_fin" />
