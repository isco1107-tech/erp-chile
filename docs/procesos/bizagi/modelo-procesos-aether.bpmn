    <bpmn:sequenceFlow id="P06_flujo_12" sourceRef="P06_fl" targetRef="P06_ffl" />
    <bpmn:textAnnotation id="P06_nota_n1"><bpmn:text>Nunca frena a Aether: el SDK no lanza, agrupa en lotes y descarta lo más antiguo si la Supersuite está caída.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="P06_titulo"><bpmn:text>P06 · Telemetría, salud y alertas. Aether reporta uso, presencia, cajas, folios y fichas; la Supersuite calcula salud y riesgo, abre alertas y avisa por WhatsApp.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P06_proc_ss" name="P06 · Supersuite" isExecutable="false">
