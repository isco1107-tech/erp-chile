    <bpmn:sequenceFlow id="P15_flujo_7" sourceRef="P15_corr" targetRef="P15_gmc" />
    <bpmn:sequenceFlow id="P15_flujo_8" name="Sí" sourceRef="P15_gd" targetRef="P15_rei" />
    <bpmn:sequenceFlow id="P15_flujo_9" sourceRef="P15_rei" targetRef="P15_fin" />
    <bpmn:textAnnotation id="P15_titulo"><bpmn:text>P15 · Rendición de gastos. El colaborador rinde lo que pagó, un aprobador decide y Tesorería reembolsa; lo rechazado vuelve a corregirse.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P16_proc_ae" name="P16 · Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P16_carriles_ae">
      <bpmn:lane id="P16_carril_rec" name="Recepción">
        <bpmn:flowNodeRef>P16_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_ord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_emi</bpmn:flowNodeRef>
