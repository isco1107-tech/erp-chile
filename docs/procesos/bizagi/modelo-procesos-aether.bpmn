        <bpmn:flowNodeRef>P27_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P27_carril_cob" name="Cobranza automática">
        <bpmn:flowNodeRef>P27_cr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P27_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P27_fcr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P27_i" name="Ingresa el RUT de la beneficiaria">
