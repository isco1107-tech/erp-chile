    <bpmn:sequenceFlow id="P27_flujo_14" name="No" sourceRef="P27_gx" targetRef="P27_pend" />
    <bpmn:sequenceFlow id="P27_flujo_15" sourceRef="P27_paid" targetRef="P27_num" />
