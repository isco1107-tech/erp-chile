      <bpmn:incoming>P10_flujo_13</bpmn:incoming>
      <bpmn:incoming>P10_flujo_14</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P10_stk" name="Kardex al PMP vigente y asiento contable">
      <bpmn:documentation>applyStockOut lee el PMP bajo bloqueo; el asiento nace en la misma transacción.</bpmn:documentation>
      <bpmn:incoming>P10_flujo_15</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_16</bpmn:outgoing>
    </bpmn:serviceTask>
