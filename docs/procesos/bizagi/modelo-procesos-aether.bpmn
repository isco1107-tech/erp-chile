      <bpmn:incoming>P10_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_12</bpmn:outgoing>
      <bpmn:outgoing>P10_flujo_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P10_ted" name="Timbrar (TED con la llave del CAF) y armar el XML">
      <bpmn:documentation>RSA-SHA1. El bloque DA del CAF viaja byte a byte: nunca se reserializa.</bpmn:documentation>
      <bpmn:incoming>P10_flujo_12</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_14</bpmn:outgoing>
    </bpmn:serviceTask>
