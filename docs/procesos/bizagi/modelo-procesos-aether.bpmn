      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P27_look" name="Buscar cuotas pendientes (empresa desde el token)">
      <bpmn:incoming>P27_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P27_flujo_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="P27_sel" name="Recibe las cuotas elegidas">
      <bpmn:incoming>P27_flujo_2</bpmn:incoming>
      <bpmn:outgoing>P27_flujo_3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="P27_crt" name="Crear orden PENDING por el monto exacto">
      <bpmn:incoming>P27_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P27_flujo_4</bpmn:outgoing>
    </bpmn:serviceTask>
