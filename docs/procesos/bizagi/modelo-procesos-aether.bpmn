    <bpmn:sequenceFlow id="P07_flujo_25" sourceRef="P07_ac" targetRef="P07_fr" />
  </bpmn:process>
  <bpmn:process id="P08_proc_ent" name="P08 · Entrega de Aether a producción" isExecutable="false">
    <bpmn:laneSet id="P08_carriles_ent">
