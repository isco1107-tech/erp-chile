      <bpmn:outgoing>P10_flujo_26</bpmn:outgoing>
      <bpmn:outgoing>P10_flujo_27</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P10_pago" name="Llega el pago">
      <bpmn:incoming>P10_flujo_26</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_30</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P10_venc" name="Cron diario de cobranza">
      <bpmn:incoming>P10_flujo_27</bpmn:incoming>
      <bpmn:outgoing>P10_flujo_28</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">30 13 * * *</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
