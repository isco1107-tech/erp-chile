    <bpmn:sequenceFlow id="P22_flujo_12" sourceRef="P22_est" targetRef="P22_gp" />
    <bpmn:sequenceFlow id="P22_flujo_13" name="No: esperar el siguiente pago" sourceRef="P22_gp" targetRef="P22_cob" />
    <bpmn:sequenceFlow id="P22_flujo_14" name="Sí" sourceRef="P22_gp" targetRef="P22_cump" />
    <bpmn:sequenceFlow id="P22_flujo_15" sourceRef="P22_cump" targetRef="P22_cer" />
    <bpmn:sequenceFlow id="P22_flujo_16" sourceRef="P22_cer" targetRef="P22_fin" />
    <bpmn:textAnnotation id="P22_nota_n1"><bpmn:text>Un plan sin certamen es plantilla: no se publica ni se ofrece hasta copiarlo a un certamen.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P22_asoc_n1" associationDirection="None" sourceRef="P22_nota_n1" targetRef="P22_ofr" />
    <bpmn:textAnnotation id="P22_titulo"><bpmn:text>P22 · Auspicios. De la propuesta con un paquete del tarifario al convenio firmado, los pagos y el cumplimiento de contraprestaciones.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P23_proc_ae" name="P23 · Aether ERP" isExecutable="false">
    <bpmn:laneSet id="P23_carriles_ae">
