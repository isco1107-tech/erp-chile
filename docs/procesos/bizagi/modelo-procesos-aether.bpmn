    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P27_syn" name="Consultar el cobro a Khipu">
      <bpmn:incoming>P27_flujo_11</bpmn:incoming>
      <bpmn:outgoing>P27_flujo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P27_gx" name="¿Pagado, con monto y transaction_id exactos?">
