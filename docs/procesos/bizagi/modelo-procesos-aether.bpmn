        <bpmn:flowNodeRef>P15_gd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P15_carril_tes" name="Tesorería">
        <bpmn:flowNodeRef>P15_rei</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P15_i" name="Pagó un gasto de la empresa">
      <bpmn:outgoing>P15_flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P15_cre" name="Crear la rendición y agregar los gastos">
      <bpmn:incoming>P15_flujo_1</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P15_gmc" name="">
      <bpmn:incoming>P15_flujo_2</bpmn:incoming>
      <bpmn:incoming>P15_flujo_7</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P15_env" name="Enviar a aprobación (SUBMITTED)">
      <bpmn:incoming>P15_flujo_3</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P15_rev" name="Revisar la rendición">
      <bpmn:incoming>P15_flujo_4</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P15_gd" name="¿Aprueba?">
      <bpmn:incoming>P15_flujo_5</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_6</bpmn:outgoing>
      <bpmn:outgoing>P15_flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P15_corr" name="Corregir según las notas">
      <bpmn:incoming>P15_flujo_6</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P15_rei" name="Reembolsar y registrar la referencia">
      <bpmn:incoming>P15_flujo_8</bpmn:incoming>
      <bpmn:outgoing>P15_flujo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P15_fin" name="Rendición reembolsada">
      <bpmn:incoming>P15_flujo_9</bpmn:incoming>
    </bpmn:endEvent>
