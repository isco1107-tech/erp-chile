    <WorkflowProcess Id="149d535f-95e2-523f-a2ed-a12a3fe2e3c0" Name="P00 · Ciclo de vida de una empresa en Aether">
      <ProcessHeader>
        <Created>2026-10-19T00:00:00-03:00</Created>
        <Description>Macroproceso: ciclo de vida de una empresa en Aether. Objetivo: Mostrar en una sola lámina cómo se encadenan los procesos detallados y quién es responsable de cada tramo.</Description>
      </ProcessHeader>
      <RedefinableHeader>
        <Author>Aether</Author>
        <Version>1.0</Version>
        <Countrykey>CL</Countrykey>
      </RedefinableHeader>
      <ActivitySets>
