    <WorkflowProcess Id="8b3f166f-f613-5fda-ba41-4b2a81c6806e" Name="P01 · Aether">
      <ProcessHeader>
        <Created>2026-10-19T00:00:00-03:00</Created>
        <Description>Captación y contratación. Objetivo: Convertir el interés de una empresa en un acuerdo de plan y módulos con los datos que exige el alta.</Description>
      </ProcessHeader>
      <RedefinableHeader>
        <Author>Aether</Author>
        <Version>1.0</Version>
        <Countrykey>CL</Countrykey>
      </RedefinableHeader>
      <ActivitySets />
      <DataInputOutputs />
      <Activities>
        <Activity Id="974809e9-00c0-5355-8f0f-c5678d921789" Name="Llega solicitud de demo o carrito de módulos">
          <Description>POST /api/public/leads (demo) o POST /api/public/module-quote (carrito de la vitrina).</Description>
          <Event>
            <StartEvent Trigger="Message">
              <TriggerResultMessage CatchThrow="CATCH">
                <Message Id="6e98c142-5ec6-5b5b-932d-39d51e658c27" />
              </TriggerResultMessage>
            </StartEvent>
          </Event>
          <Documentation />
          <NodeGraphicsInfos>
            <NodeGraphicsInfo ToolId="BizAgi_Process_Modeler" Height="36" Width="36" BorderColor="-10311914" FillColor="-1638505">
              <Coordinates XCoordinate="175" YCoordinate="1642" />
            </NodeGraphicsInfo>
          </NodeGraphicsInfos>
          <ExtendedAttributes />
        </Activity>
        <Activity Id="e70b1a16-35d4-5d12-99bd-e5318dd8e82e" Name="Validar límite por IP, señuelo y datos">
          <Description>rate-limiter por IP + honeypot + esquema Zod.</Description>
          <Implementation>
            <Task>
              <TaskService />
            </Task>
          </Implementation>
          <Performers />
          <Documentation />
          <Loop LoopType="None" />
          <NodeGraphicsInfos>
            <NodeGraphicsInfo ToolId="BizAgi_Process_Modeler" Height="84" Width="132" BorderColor="-16553830" FillColor="-1249281">
              <Coordinates XCoordinate="305" YCoordinate="1618" />
            </NodeGraphicsInfo>
          </NodeGraphicsInfos>
          <ExtendedAttributes />
        </Activity>
