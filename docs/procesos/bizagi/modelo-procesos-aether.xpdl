    <WorkflowProcess Id="0a583e53-ba6f-5bdb-a8d3-f8340a2f4489" Name="P21 · Aether ERP">
      <ProcessHeader>
        <Created>2026-10-19T00:00:00-03:00</Created>
        <Description>Postulación y casting de candidatas. Objetivo: Recibir postulaciones de forma segura y llevar a las seleccionadas hasta el micrositio.</Description>
      </ProcessHeader>
      <RedefinableHeader>
        <Author>Aether</Author>
        <Version>1.0</Version>
        <Countrykey>CL</Countrykey>
      </RedefinableHeader>
      <Activities>
        <Activity Id="7722d7b1-3c45-5373-a423-be63f7ac67ba" Name="Llega la postulación por el link">
          <Description />
