    <WorkflowProcess Id="b4b7a96b-2c37-5057-ae1b-873d84d8baa0" Name="P05 · Supersuite">
      <ProcessHeader>
        <Created>2026-10-19T00:00:00-03:00</Created>
        <Description>Ciclo de vida de una orden de la Supersuite. Objetivo: Garantizar que cada cambio de la consola se aplique una sola vez en Aether, o quede fallido a la vista, nunca perdido.</Description>
      </ProcessHeader>
      <RedefinableHeader>
        <Author>Aether</Author>
        <Version>1.0</Version>
        <Countrykey>CL</Countrykey>
      </RedefinableHeader>
      <Activities>
        <Activity Id="0524378f-02b8-5cf2-bd90-52aea08ef919" Name="Cambios en borrador en la consola">
