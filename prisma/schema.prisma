model Product {
  id                   String                     @id @default(cuid())
  companyId            String
  company              Company                    @relation(fields: [companyId], references: [id])
  categoryId           String?
  category             Category?                  @relation(fields: [categoryId], references: [id])
  sku                  String
  name                 String
  description          String?
  unit                 String                     @default("UN")
  isTrackable          Boolean                    @default(true)
  /// Producto exento de IVA. Sin este campo el POS no tenía forma de saberlo y
  /// cobraba 19% sobre todo, sobrecobrando al cliente y distorsionando el F29.
  isExempt             Boolean                    @default(false)
  costPricePMP         Float                      @default(0)
  netPrice             Int                        @default(0)
  grossPrice           Int                        @default(0)
  minStock             Int                        @default(0)
  /// Código de barras principal (EAN-13, UPC o interno). Único por empresa.
  barcode              String?
  brand                String?
  /// Foto del producto (Blob), para catálogo, POS y etiquetas.
  imageUrl             String?
  /// Maneja lotes con vencimiento: las entradas registran lote y las salidas
  /// consumen primero el que vence antes (FEFO). Ver `InventoryLot`.
  tracksLots           Boolean                    @default(false)
  packagings           ProductPackaging[]
  lots                 InventoryLot[]
  inventoryCountLines  InventoryCountLine[]
  stocks               Stock[]
  movements            InventoryMovement[]
  salesDocumentItems   SalesDocumentItem[]
  salesOrderItems      SalesOrderItem[]
  priceListItems       PriceListItem[]
  purchaseItems        PurchaseDocumentItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  journalLines         JournalLine[]
  purchaseRequestItems PurchaseRequestItem[]
  importShipmentItems  ImportShipmentItem[]
  billsOfMaterials     BillOfMaterials[]          @relation("BomOutput")
  bomComponents        BomComponent[]
  productionOrders     ProductionOrder[]          @relation("ProductionOutput")
  productionComponents ProductionOrderComponent[]
  serviceTicketLines   ServiceTicketLine[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, name])
}

model Stock {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, productId, warehouseId])
  @@index([companyId, productId])
}

model InventoryMovement {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  type           MovementType
  quantity       Float
  unitCost       Float
  totalCost      Int
  previousStock  Float
  newStock       Float
  previousPmp    Float
  newPmp         Float
  reference      String?
  notes          String?
  /// Lotes que movió este movimiento: `[{ lotNumber, expiryDate, quantity }]`.
  /// `null` en productos sin lotes y en movimientos previos a los lotes.
  lotAllocations Json?
  createdAt      DateTime     @default(now())

  @@index([companyId, productId, createdAt])
}

enum DteType {
  COTIZACION
  FACTURA_33
  FACTURA_EXENTA_34
  BOLETA_39
  BOLETA_EXENTA_41
  GUIA_DESPACHO_52
  NOTA_CREDITO_61
  NOTA_DEBITO_56
}

enum DocumentStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethodType {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
  CHEQUE
  OTRO
}

enum PaymentDirection {
  INCOME
  EXPENSE
}

enum PurchaseDocumentType {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
  GUIA_DESPACHO
  OTRO
}

model FolioSequence {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  dteType      DteType
  currentFolio Int     @default(0)

  @@unique([companyId, dteType])
}

model SalesDocument {
  id                     String                  @id @default(cuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id])
  contactId              String
  contact                Contact                 @relation(fields: [contactId], references: [id])
  warehouseId            String
  warehouse              Warehouse               @relation(fields: [warehouseId], references: [id])
  dteType                DteType
  folio                  Int?
  status                 DocumentStatus          @default(DRAFT)
  issueDate              DateTime                @default(now())
  dueDate                DateTime?
  paymentMethod          String
  netAmount              Int                     @default(0)
  exemptAmount           Int                     @default(0)
  ivaAmount              Int                     @default(0)
  totalAmount            Int                     @default(0)
  paidAmount             Int                     @default(0)
  paymentStatus          PaymentStatus           @default(UNPAID)
  referenceFolio         Int?
  referenceType          DteType?
  notes                  String?
  /// Clave de idempotencia para prevenir duplicados por doble clic o reintentos de red.
  idempotencyKey         String?
  /// Turno de caja que originó la venta. Solo lo llena el POS; es lo que
  /// permite que el arqueo sepa qué ventas cuentan para esta caja y este turno.
  cashShiftId            String?
  cashShift              CashShift?              @relation(fields: [cashShiftId], references: [id])
  /// Centro de costo/evento opcional (módulo `hasEventProjects`). Permite
  /// agregar ingresos reales de un proyecto sin que el resto del sistema
  /// dependa de que ese módulo esté contratado.
  projectId              String?
  project                Project?                @relation(fields: [projectId], references: [id])
  /// Nota de venta de la que salió este documento (facturación o despacho
  /// parcial). `null` en ventas directas.
  salesOrderId           String?
  salesOrder             SalesOrder?             @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  /// Vendedor al que se atribuye la venta (comisiones). Por defecto, quien la emite.
  sellerId               String?
  seller                 User?                   @relation("SalesDocumentSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  /// Cotizaciones convertidas en nota de venta.
  quotedOrders           SalesOrder[]            @relation("QuoteToOrder")
  items                  SalesDocumentItem[]
  payments               Payment[]
  collectionReminderLogs CollectionReminderLog[]
  collectionNotes        CollectionNote[]

  // ── Facturación electrónica ──────────────────────────────────────────────
  // Todo nullable: los documentos emitidos antes de que existiera el módulo
  // DTE, y las cotizaciones (que no son DTE), no tienen nada de esto.
  /// CAF que autorizó el folio. Permite revalidar el timbre años después,
  /// incluso si ese rango ya se agotó.
  cafId           String?
  caf             DteCaf?              @relation(fields: [cafId], references: [id])
  /// `<TED>` firmado, tal como se imprime en el PDF417 del documento.
  tedXml          String?
  /// XML completo del DTE ya firmado y enviado. Es el original tributario:
  /// se guarda literal porque cualquier reserialización invalida la firma.
  signedXml       String?
  /// Track ID que devuelve el SII al recibir el envío. Es la única forma de
  /// consultar después si el documento fue aceptado.
  siiTrackId      String?
  siiStatus       SiiSubmissionStatus?
  siiStatusAt     DateTime?
  /// Glosa del SII cuando rechaza u observa; sin esto un rechazo es opaco.
  siiStatusDetail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, dteType, folio])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@index([companyId, dteType])
  @@index([companyId, paymentStatus])
  @@index([cashShiftId])
  @@index([companyId, projectId])
  /// Cubre el filtro de deuda vigente por cliente (límite de crédito) y sirve
  /// también para un futuro "estado de cuenta" en la ficha de Contact.
  @@index([companyId, contactId, status, paymentStatus])
  @@index([companyId, salesOrderId])
  @@index([companyId, sellerId, issueDate])
}

model SalesDocumentItem {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  documentId       String
  document         SalesDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  sku              String?
  description      String
  quantity         Float
  unitPrice        Int
  isExempt         Boolean         @default(false)
  discountPercent  Float           @default(0)
  subtotal         Int
  iva              Int
  total            Int
  unitCostPMP      Float           @default(0)
  /// Línea de la nota de venta que esta línea factura o despacha.
  salesOrderItemId String?
  salesOrderItem   SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull)

  @@index([companyId, documentId])
}

model PurchaseDocument {
  id                      String                 @id @default(cuid())
  companyId               String
  company                 Company                @relation(fields: [companyId], references: [id])
  contactId               String
  contact                 Contact                @relation(fields: [contactId], references: [id])
  documentType            PurchaseDocumentType
  folio                   String
  status                  DocumentStatus         @default(DRAFT)
  issueDate               DateTime               @default(now())
  dueDate                 DateTime?
  paymentMethod           String?
  netAmount               Int                    @default(0)
  exemptAmount            Int                    @default(0)
  ivaAmount               Int                    @default(0)
  totalAmount             Int                    @default(0)
  paidAmount              Int                    @default(0)
  paymentStatus           PaymentStatus          @default(UNPAID)
  /// Folio del documento original que esta Nota de Crédito/Débito corrige,
  /// dentro del mismo proveedor (`contactId`). Sin esto no había forma de
  /// validar que una NC de proveedor correspondiera a una compra real, ni de
  /// aplicar su efecto contra el saldo de esa compra en vez de quedar como
  /// una cuenta por pagar propia y duplicada.
  referenceFolio          String?
  notes                   String?
  /// `NOT_REQUIRED` para la inmensa mayoría de documentos (bajo el umbral
  /// configurado, o compras sin umbral configurado). Solo pasa a `PENDING`
  /// cuando el total supera `CompanySettings.purchaseApprovalThreshold` al
  /// intentar EMITIR — en ese caso el documento se guarda como `DRAFT` (sin
  /// tocar stock/PMP todavía) hasta que alguien con `purchases:approve` lo
  /// apruebe o rechace. Las Notas de Crédito nunca quedan pendientes: reducen
  /// deuda, no la generan (mismo criterio que el límite de crédito de Ventas).
  approvalStatus          PurchaseApprovalStatus @default(NOT_REQUIRED)
  approvedByUserId        String?
  /// `SetNull`: perder de vista quién aprobó una compra al eliminar ese
  /// usuario es un desgaste menor de auditoría, no una pérdida de valor
  /// legal/financiero — `deleteUser` no bloquea por esto.
  approvedByUser          User?                  @relation("PurchaseApprovals", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt              DateTime?
  approvalNotes           String?
  /// Vínculo opcional a una Orden de Compra: la inmensa mayoría de compras NO
  /// la tiene y se comportan exactamente como antes (factura mueve stock
  /// directo). Cuando SÍ está presente, el stock ya se movió al confirmar la
  /// Recepción de Mercadería correspondiente — esta factura no vuelve a
  /// tocar stock/PMP, solo formaliza tributariamente y dispara el matching
  /// de 3 vías (OC ↔ Recepción ↔ Factura) contra `matchStatus`.
  purchaseOrderId         String?
  /// `Restrict` explícito, a propósito: una OC que ya tiene facturas
  /// referenciándola nunca debe poder borrarse, solo cancelarse — mismo
  /// criterio que `JournalEntry.reversalOf`.
  purchaseOrder           PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  matchStatus             PurchaseMatchStatus    @default(NOT_APPLICABLE)
  matchNotes              String?
  matchOverriddenByUserId String?
  /// `SetNull`: mismo criterio que `approvedByUser` — perder de vista quién
  /// forzó un pago con mismatch es un desgaste de auditoría, no de valor legal.
  matchOverriddenByUser   User?                  @relation("PurchaseMatchOverrides", fields: [matchOverriddenByUserId], references: [id], onDelete: SetNull)
  matchOverriddenAt       DateTime?
  /// Centro de costo/evento opcional (módulo `hasEventProjects`).
  projectId               String?
  project                 Project?               @relation(fields: [projectId], references: [id])
  items                   PurchaseDocumentItem[]
  payments                Payment[]
  paymentBatchItems       PaymentBatchItem[]
  receivedDtes            ReceivedDte[]
  importShipmentCosts     ImportShipmentCost[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  // N-17 (auditoría 2026-09-14): antes era `@@unique([companyId, contactId,
  // folio])`, sin `documentType` — una Factura y una Nota de Crédito del
  // mismo proveedor podían compartir folio (son numeraciones independientes
  // del proveedor) y chocaban entre sí. `documentType` entra a la unicidad
  // para que cada tipo de documento tenga su propio espacio de folios por
  // proveedor.
  @@unique([companyId, contactId, documentType, folio])
  @@index([companyId, status])
  @@index([companyId, paymentStatus])
  @@index([companyId, approvalStatus])
  @@index([companyId, purchaseOrderId])
  @@index([companyId, matchStatus])
  @@index([companyId, projectId])
}

enum PurchaseApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

/// Resultado del matching de 3 vías (OC ↔ Recepción ↔ Factura), solo se
/// calcula cuando la factura referencia una `PurchaseOrder`.
enum PurchaseMatchStatus {
  /// La factura no referencia ninguna Orden de Compra — la inmensa mayoría.
  NOT_APPLICABLE
  /// Cantidad y costo facturados coinciden con lo recibido/pactado.
  MATCHED
  /// Hay diferencia de cantidad o costo — bloquea `registerPurchasePayment`
  /// hasta que alguien con `purchases:override_match` la fuerce.
  MISMATCHED
  /// Tenía diferencia, pero un Dueño/Administrador la forzó explícitamente.
  OVERRIDDEN
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// Documento interno de solicitud al proveedor, ANTES de que despache o
/// facture nada — no existía ningún concepto de "pre-compra" en el sistema.
/// Es el ancla del matching de 3 vías: sus líneas (cantidad/costo pactados)
/// son contra lo que se comparan la Recepción física y la Factura.
model PurchaseOrder {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id])
  contactId         String
  contact           Contact             @relation(fields: [contactId], references: [id])
  /// Correlativo interno por empresa (ver `InternalDocumentSequence`) — no es
  /// folio SII, es solo un número de referencia interno.
  folio             Int
  status            PurchaseOrderStatus @default(DRAFT)
  issueDate         DateTime            @default(now())
  expectedDate      DateTime?
  notes             String?
  items             PurchaseOrderItem[]
  goodsReceipts     GoodsReceipt[]
  purchaseDocuments PurchaseDocument[]
  /// Solicitud de compra que originó esta OC (comparativo de cotizaciones).
  purchaseRequestId String?
  purchaseRequest   PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([companyId, folio])
  @@index([companyId, status])
}

model PurchaseOrderItem {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  orderId           String
  order             PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?           @relation(fields: [productId], references: [id])
  description       String
  quantity          Float
  unitCost          Int
  /// Acumulado desde `GoodsReceiptItem` — cuánto de esta línea ya entró
  /// físicamente a bodega. Nunca puede superar `quantity`.
  receivedQuantity  Float              @default(0)
  /// Acumulado desde facturas que referencian esta OC — para permitir
  /// facturación parcial de una recepción sin perder el rastro de cuánto
  /// ya se facturó contra cuánto se recibió.
  invoicedQuantity  Float              @default(0)
  goodsReceiptItems GoodsReceiptItem[]

  @@index([companyId, orderId])
}

enum GoodsReceiptStatus {
  CONFIRMED
  CANCELLED
}

/// Recepción física de mercadería contra una Orden de Compra. Es el paso que
/// realmente mueve stock/PMP en el flujo de 3 vías — la factura que llega
/// después ya no vuelve a tocarlo, solo formaliza y dispara el matching.
model GoodsReceipt {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id])
  orderId     String
  /// `Restrict` explícito: una OC ya recibida nunca debe poder borrarse
  /// (perdería el rastro de qué movió stock/PMP), solo cancelarse.
  order       PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  /// Correlativo interno por empresa (ver `InternalDocumentSequence`).
  folio       Int
  status      GoodsReceiptStatus @default(CONFIRMED)
  receivedAt  DateTime           @default(now())
  notes       String?
  items       GoodsReceiptItem[]
  createdAt   DateTime           @default(now())

  @@unique([companyId, folio])
  @@index([companyId, orderId])
}

model GoodsReceiptItem {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  receiptId   String
  receipt     GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItemId String
  /// `Restrict` explícito: mismo criterio que `GoodsReceipt.order` — una
  /// línea de OC ya recibida no debe poder borrarse.
  orderItem   PurchaseOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id])
  description String
  quantity    Float
  /// Copiado del `PurchaseOrderItem` al confirmar — el costo pactado en la OC,
  /// no uno nuevo tecleado en la recepción, para que el matching compare
  /// contra el mismo número en las 3 vías.
  unitCost    Int

  @@index([companyId, orderItemId])
  @@index([companyId, receiptId])
}

model PurchaseDocumentItem {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  documentId  String
  document    PurchaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Opcionales a propósito: una factura de compra también incluye servicios,
  // fletes y gastos que no son inventario. Solo las líneas que enlazan producto
  // Y bodega mueven stock y recalculan el PMP.
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id])
  warehouseId String?
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id])
  description String
  quantity    Float
  unitCost    Int
  isExempt    Boolean          @default(false)
  subtotal    Int
  iva         Int
  total       Int

  @@index([companyId, documentId])
  @@index([companyId, productId])
}

model Payment {
  id                       String                  @id @default(cuid())
  companyId                String
  company                  Company                 @relation(fields: [companyId], references: [id])
  type                     PaymentDirection
  contactId                String
  contact                  Contact                 @relation(fields: [contactId], references: [id])
  salesDocumentId          String?
  salesDocument            SalesDocument?          @relation(fields: [salesDocumentId], references: [id])
  purchaseDocumentId       String?
  purchaseDocument         PurchaseDocument?       @relation(fields: [purchaseDocumentId], references: [id])
  /// Centro de costo/evento opcional (módulo `hasEventProjects`) — permite
  /// etiquetar un pago suelto de tesorería directo a un proyecto (ej. gasto
  /// de producción pagado en efectivo) sin pasar por un documento.
  projectId                String?
  project                  Project?                @relation(fields: [projectId], references: [id])
  /// Etiqueta opcional a una línea de presupuesto operativo (módulo
  /// `hasBudgets`) — así el "real" de `Budget`/`BudgetLine` se suma solo
  /// desde los pagos ya registrados en Tesorería, sin duplicar agregación.
  budgetLineId             String?
  budgetLine               BudgetLine?             @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  /// Auditoría N-15: el cobro de una cuota de `PaymentPlan` genera su
  /// `Payment` de tesorería para que `getCashFlow` lo vea. `paymentPlanId` se
  /// llena siempre que el cobro venga de un plan (permite abarcar un pago en
  /// línea que cubre varias cuotas de una sola vez); `paymentPlanInstallmentId`
  /// solo cuando el cobro corresponde a UNA cuota puntual (el registro manual
  /// desde el panel). `SetNull`: borrar el plan/cuota no puede arrastrar el
  /// historial de tesorería ya generado.
  paymentPlanId            String?
  paymentPlan              PaymentPlan?            @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  paymentPlanInstallmentId String?
  paymentPlanInstallment   PaymentPlanInstallment? @relation(fields: [paymentPlanInstallmentId], references: [id], onDelete: SetNull)
  /// Auditoría N-15: cobro de un pagaré (`PromissoryNote`). Generado por la
  /// DIFERENCIA respecto al `paidAmount` anterior — el endpoint registra un
  /// total acumulado, no un incremento.
  promissoryNoteId         String?
  promissoryNote           PromissoryNote?         @relation(fields: [promissoryNoteId], references: [id], onDelete: SetNull)
  /// Auditoría N-15: cobro de la porción en efectivo de un contrato de
  /// auspicio (`SponsorshipContract`). Mismo criterio de diferencia que el
  /// pagaré: `updateSponsorshipPayment` también recibe un total acumulado.
  sponsorshipContractId    String?
  sponsorshipContract      SponsorshipContract?    @relation(fields: [sponsorshipContractId], references: [id], onDelete: SetNull)
  amount                   Int
  paymentMethod            PaymentMethodType
  paymentDate              DateTime                @default(now())
  referenceNumber          String?
  bankAccount              String?
  /// Cuenta bancaria propia por la que entró o salió (conciliación bancaria).
  bankAccountId            String?
  bankAccountRef           BankAccount?            @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  /// Movimiento de la cartola con que quedó conciliado. Un movimiento puede
  /// cubrir varios pagos (un depósito por tres facturas); un pago, uno solo.
  bankStatementLineId      String?
  bankStatementLine        BankStatementLine?      @relation(fields: [bankStatementLineId], references: [id], onDelete: SetNull)
  cheque                   Cheque?
  paymentBatchItem         PaymentBatchItem?
  notes                    String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([companyId, type])
  @@index([companyId, bankAccountId])
  @@index([bankStatementLineId])
  @@index([companyId, paymentDate])
  @@index([companyId, salesDocumentId])
  @@index([companyId, purchaseDocumentId])
  @@index([companyId, projectId])
  @@index([companyId, budgetLineId])
  @@index([companyId, paymentPlanId])
  @@index([companyId, paymentPlanInstallmentId])
  @@index([companyId, promissoryNoteId])
  @@index([companyId, sponsorshipContractId])
}

/// Caja física del local. Se ata a una bodega porque toda venta del POS
/// descuenta stock desde ella.
model CashRegister {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  name        String
  isActive    Boolean     @default(true)
  shifts      CashShift[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

/// Turno de caja (arqueo). Los montos son CLP entero, como el resto del sistema.
///
/// `expectedAmount`, `actualAmount` y `difference` se llenan solo al cerrar: un
/// turno abierto no tiene esperado "congelado", se calcula en vivo desde las
/// ventas en efectivo y los movimientos del turno.
model CashShift {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashRegisterId String
  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id])
  /// Nullable + `SetNull`: eliminar definitivamente al usuario no debe
  /// bloquearse por un turno de caja viejo. El turno (montos, descuadre)
  /// sobrevive intacto; solo se pierde el nombre de quién lo hizo.
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  initialAmount  Int
  expectedAmount Int?
  actualAmount   Int?
  difference     Int?
  status         CashShiftStatus @default(OPEN)
  openingNotes   String?
  closingNotes   String?
  movements      CashMovement[]
  salesDocuments SalesDocument[]

  @@index([companyId, status])
  @@index([companyId, cashRegisterId, openedAt])
  @@index([userId])
}

enum CashMovementType {
  INFLOW
  OUTFLOW
}

/// Entrada o salida de efectivo ajena a una venta: fondo de cambio adicional,
/// retiro parcial, pago de un gasto menor con dinero de la caja.
model CashMovement {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashShiftId String
  cashShift   CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  type        CashMovementType
  amount      Int
  reason      String
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([companyId, cashShiftId])
  @@index([userId])
}

model Invitation {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  email        String
  role         Role        @default(SALES)
  /// Rol personalizado asignado en la invitación; se copia al User al aceptarla.
  /// La FK con SetNull evita que borrar el rol deje la invitación apuntando a un
  /// id inexistente: al aceptarla, el INSERT en User violaría su propia FK.
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  token        String      @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@unique([companyId, email])
  @@index([customRoleId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ISSUE_DTE
  CANCEL_DTE
  STOCK_ADJUSTMENT
  EXPORT
  /// Descarga de un archivo sensible (ej. fotografía de una postulante) por un
  /// usuario del ERP — exigido por Ley 19.628/21.719 para trazar quién accedió
  /// a una imagen de una titular de datos, no solo quién la subió.
  DOWNLOAD
}

model AuditLog {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  userId    String?
  /// `SetNull`: el registro de auditoría es el que debe sobrevivir a la
  /// eliminación definitiva de un usuario, no al revés — `userEmail` ya queda
  /// como snapshot legible aunque el vínculo se pierda.
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  action    AuditAction
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime    @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
}

// ============================================================================
// Núcleo contable (PROMPT_ERP_V2.md, Fase B)
//
// Principio rector: un hecho económico se registra una vez. El asiento y el
// documento nacen juntos, dentro de la misma `$transaction`, o no nace
// ninguno. Ningún saldo contable es un campo que se actualiza: todo saldo se
// agrega desde `JournalLine`. Un asiento POSTED no se edita ni se borra jamás
// — se corrige con reverso. Los invariantes de cuadratura, signos e
// inmutabilidad se fuerzan con triggers SQL (ver migración de Fase B.2),
// porque Prisma no puede expresarlos.
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST
  EXPENSE
}

enum AccountNature {
  DEBIT
  CREDIT
}

enum CostBehavior {
  FIXED
  VARIABLE
  NONE
}

enum CashFlowCategory {
  OPERATING
  INVESTING
  FINANCING
  NONE
}

/// Plan de cuentas de la empresa. Autorelación para la jerarquía
/// agrupadora/hoja: solo las hojas (`isPostable = true`) reciben líneas de
/// asiento, las agrupadoras solo suman para el balance.
model Account {
  id               String           @id @default(cuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id])
  code             String
  name             String
  parentId         String?
  /// `Restrict`, no el `SetNull` implícito de una relación opcional: borrar una
  /// cuenta agrupadora no debe desprender en silencio a sus hijas del árbol
  /// del plan de cuentas.
  parent           Account?         @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         Account[]        @relation("AccountHierarchy")
  type             AccountType
  nature           AccountNature
  /// Solo las cuentas hoja pueden recibir líneas de asiento (forzado también por trigger).
  isPostable       Boolean          @default(true)
  /// Corriente / no corriente. Nulo en cuentas de resultado, donde no aplica.
  isCurrent        Boolean?
  costBehavior     CostBehavior     @default(NONE)
  cashFlowCategory CashFlowCategory @default(NONE)
  isActive         Boolean          @default(true)
  mappings         AccountMapping[]
  journalLines     JournalLine[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([companyId, parentId])
}

/// Puente entre la semántica que usa el motor de asientos (`CAJA`, `CLIENTES`,
/// `IVA_DEBITO`, ...) y el plan de cuentas real de cada empresa. Esto es lo
/// que permite que las reglas de asiento (Fase C) no tengan códigos de cuenta
/// incrustados: cada empresa mapea su propio plan y el motor sigue funcionando.
model AccountMapping {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  key       String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model AccountingPeriod {
  id             String                 @id @default(cuid())
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id])
  year           Int
  month          Int
  status         AccountingPeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  /// `SetNull`: `deleteUser` (src/lib/services/users.service.ts) nunca
  /// bloquea por historial — solo por auto-eliminación o ser el último
  /// OWNER — así que perder este vínculo al eliminar un usuario es
  /// esperado, no un bug (mismo criterio que `CashShift.user`).
  closedByUser   User?                  @relation(fields: [closedByUserId], references: [id], onDelete: SetNull)
  entries        JournalEntry[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([companyId, year, month])
  @@index([companyId, status])
}

/// Correlativo de `entryNumber` por empresa y año, sin huecos. Mismo patrón
/// que `FolioSequence`: `upsert` dentro de la `$transaction` del asiento, con
/// `LOCKING_TX_OPTIONS`.
model JournalEntrySequence {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])
  year          Int
  currentNumber Int     @default(0)

  @@unique([companyId, year])
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalSourceType {
  SALES_DOCUMENT
  PURCHASE_DOCUMENT
  PAYMENT
  INVENTORY_MOVEMENT
  CASH_SHIFT
  MANUAL
  OPENING
  CLOSING
}

/// Cabecera del asiento contable. Nunca se edita ni se borra en estado
/// POSTED (forzado por trigger) — se corrige con `reverseEntry`, que crea un
/// asiento nuevo enlazado vía `reversalOfId`.
model JournalEntry {
  id              String             @id @default(cuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id])
  entryNumber     Int
  year            Int
  date            DateTime
  description     String
  periodId        String
  period          AccountingPeriod   @relation(fields: [periodId], references: [id])
  status          JournalEntryStatus @default(DRAFT)
  sourceType      JournalSourceType
  /// Trazabilidad al documento origen (SalesDocument.id, PurchaseDocument.id, Payment.id, etc).
  /// Sin FK tipada porque el origen varía según `sourceType`.
  sourceId        String?
  /// Si este asiento reversa a otro, apunta al original. Único: un asiento
  /// original tiene a lo sumo un reverso.
  reversalOfId    String?            @unique
  /// `Restrict` como defensa en profundidad: el trigger de inmutabilidad (Fase
  /// B.2) protege los asientos POSTED, pero uno en DRAFT no. Perder el vínculo
  /// de reverso en silencio (el `SetNull` implícito) rompería la auditoría.
  reversalOf      JournalEntry?      @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy      JournalEntry?      @relation("EntryReversal")
  lines           JournalLine[]
  postedAt        DateTime?
  createdByUserId String?
  /// `SetNull`: `deleteUser` nunca bloquea por historial — perder este
  /// vínculo al eliminar un usuario es esperado, no un bug (mismo criterio
  /// que `CashShift.user`/`AccountingPeriod.closedByUser`).
  createdByUser   User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([companyId, year, entryNumber])
  @@index([companyId, status])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, date])
  @@index([periodId])
}

/// Línea de asiento. Restricción de negocio (forzada por trigger, no solo por
/// la aplicación): exactamente uno de `debit`/`credit` es mayor que cero, el
/// otro es cero. Nunca ambos, nunca negativos.
model JournalLine {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  entryId      String
  entry        JournalEntry @relation(fields: [entryId], references: [id])
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id])
  debit        Int          @default(0)
  credit       Int          @default(0)
  description  String?
  lineNumber   Int
  /// Referencias opcionales para reportes auxiliares (mayor por cliente, por producto, por centro de costo).
  customerId   String?
  customer     Contact?     @relation("JournalLineCustomer", fields: [customerId], references: [id])
  supplierId   String?
  supplier     Contact?     @relation("JournalLineSupplier", fields: [supplierId], references: [id])
  productId    String?
  product      Product?     @relation(fields: [productId], references: [id])
  costCenterId String?
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])
  createdAt    DateTime     @default(now())

  @@index([companyId, entryId])
  @@index([companyId, accountId])
  @@index([companyId, customerId])
  @@index([companyId, supplierId])
  @@index([companyId, costCenterId])
}

/// Unidad de negocio para abrir el estado de resultados. No mueve dinero por
/// sí sola, es solo una etiqueta sobre `JournalLine`.
model CostCenter {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  code      String
  name      String
  isActive  Boolean       @default(true)
  lines     JournalLine[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

// ============================================================================
// Producción de Eventos: Proyectos, Auspicios, Boletas de Honorarios,
// Candidatas (módulos `hasEventProjects`/`hasSponsorships`/`hasFeeDocuments`/
// `hasCandidates`, todos apagados por defecto)
//
// Pensado para franquicias de certámenes (tipo Miss Universe) y productoras
// de eventos: cada `Project` es un centro de costo/evento al que se pueden
// enlazar (opcionalmente) documentos de venta/compra/pagos ya existentes,
// más auspicios, boletas de honorarios y candidatas propias de este dominio.
// Los 4 flags son independientes entre sí (ninguno obliga a activar otro),
// pero `Candidate.projectId` es requerido: sin un proyecto creado no se
// pueden cargar candidatas.
// ============================================================================

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SponsorshipTier {
  TITULAR_MAIN_SPONSOR
  GOLD
  SILVER
  /// Planes reales de esquema de auspicio de certámenes, bajo plata —
  /// agregados junto al resto de módulos de esta pasada (antes solo existían
  /// plata/oro/titular hacia arriba, sin cobre/bronce).
  COPPER
  BRONZE
  OFFICIAL_SPONSOR
  MEDIA_PARTNER
  CANJE_BARTER
}

enum SponsorshipStatus {
  PROPOSAL
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum CandidateStatus {
  APPLICANT
  /// El equipo de casting está revisando la ficha/fotos antes de decidir si
  /// avanza — paso intermedio entre `APPLICANT` y el resto del pipeline.
  UNDER_REVIEW
  /// Convocada a la instancia presencial de casting.
  CALLED_TO_CASTING
  OFFICIAL_CANDIDATE
  FINALIST
  WINNER
  /// La propia postulante se retira del proceso — distinto de `REJECTED`
  /// (decisión de la organización), cada uno con su propio significado para
  /// reportes y para la purga por retención (Sección 7 del módulo).
  WITHDRAWN
  /// Descartada por la organización; el motivo va en `motivoDescarte`.
  REJECTED
}

/// Centro de costo/evento (ej. "Gala Final Miss Universe Temuco 2026").
/// `budgetedIncome`/`budgetedExpense` son el presupuesto inicial; el real se
/// agrega desde los documentos/pagos/auspicios/boletas vinculados (ver
/// src/lib/services/projects.ts).
model Project {
  id                         String                      @id @default(cuid())
  companyId                  String
  company                    Company                     @relation(fields: [companyId], references: [id])
  code                       String
  name                       String
  budgetedIncome             Int                         @default(0)
  budgetedExpense            Int                         @default(0)
  startDate                  DateTime
  endDate                    DateTime?
  status                     ProjectStatus               @default(PLANNING)
  notes                      String?
  salesDocuments             SalesDocument[]
  purchaseDocuments          PurchaseDocument[]
  payments                   Payment[]
  sponsorshipContracts       SponsorshipContract[]
  feeDocuments               FeeDocument[]
  candidates                 Candidate[]
  candidateSessions          CandidateSession[]
  stageTimelineItems         StageTimelineItem[]
  wardrobeItems              WardrobeItem[]
  staffAccreditations        StaffAccreditation[]
  badgeTemplates             BadgeTemplate[]
  judgingCategories          JudgingCategory[]
  judgeAssignments           JudgeAssignment[]
  competitionRounds          CompetitionRound[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  /// Token de acceso al formulario público de auto-inscripción de candidatas
  /// (mismo concepto que `SponsorshipContract.portalToken`): sin cuenta ni
  /// contraseña, un solo link por certamen que cualquier postulante puede usar
  /// para cargar su propia ficha. `null` hasta que alguien del equipo lo genera.
  candidateRegistrationToken String?                     @unique
  /// Ventana de postulación pública, independiente del ciclo de vida completo
  /// del proyecto (`status`/`startDate`/`endDate`, que describen el evento en
  /// sí). Un `Project` YA ES la "convocatoria" de una edición del certamen —
  /// no se creó un modelo `Convocatoria` aparte para no duplicar la entidad
  /// que ya cumple ese rol (ver nota de arquitectura en el módulo Candidatas).
  registrationStatus         CandidateRegistrationStatus @default(DRAFT)
  registrationOpensAt        DateTime?
  registrationClosesAt       DateTime?
  /// Edad mínima exigida al momento del envío del formulario público.
  minCandidateAge            Int                         @default(18)
  /// Cupo máximo de postulaciones aceptadas; `null` = sin límite.
  maxCandidates              Int?
  /// Costo pagado a la franquicia matriz por candidata aceptada (CLP), y lo
  /// que se le cobra a ella por el programa de preparación — insumos del
  /// reporte "Rentabilidad de candidatas" (`hasAdvancedReports`). `null` =
  /// no configurado, el reporte omite este proyecto.
  franchiseCost              Int?
  candidateProgramFee        Int?
  /// Token de acceso a la página pública de venta de entradas (`hasTicketing`)
  /// y de votación pagada (`hasPublicVoting`) — mismo concepto que
  /// `candidateRegistrationToken`: sin cuenta, un solo link por certamen.
  ticketSalesToken           String?                     @unique
  voteSalesToken             String?                     @unique
  ticketTypes                TicketType[]
  ticketSales                TicketSale[]
  voteOrders                 VoteOrder[]
  expenseReports             ExpenseReport[]
  opportunities              Opportunity[]
  sponsorshipPackages        SponsorshipPackage[]

  // ── Gala y micrositio público del certamen ──────────────────────────────
  /// Fecha y hora de la gala final. Distinta de `startDate` (inicio del
  /// proyecto completo, que puede ser meses antes): es la que alimenta la
  /// cuenta regresiva del micrositio y el "¿listos para la gala?" del panel.
  galaDate               DateTime?
  venueName              String?
  venueAddress           String?
  /// Dirección pública del micrositio (`/certamen/{publicSlug}`). Única en
  /// toda la plataforma, no por empresa: la URL no lleva la empresa. `null`
  /// hasta que alguien la configura; publicar exige además `publicSiteEnabled`.
  publicSlug             String?   @unique
  publicSiteEnabled      Boolean   @default(false)
  publicTagline          String?
  publicDescription      String?
  coverImageUrl          String?
  /// Acento visual del micrositio (`gold`, `violet`, `rose`, `cyan`,
  /// `emerald` — los de `PublicShell`). Texto y no enum para poder sumar
  /// acentos sin migración; Zod valida los permitidos.
  publicAccent           String    @default("gold")
  instagramHandle        String?
  publicContactEmail     String?
  /// WhatsApp de contacto del certamen (solo dígitos, formato wa.me: 56912345678).
  /// Junto a `publicContactEmail` e `instagramHandle` es lo que ven las
  /// postulantes y el público: contacto de cada certamen, no de la plataforma.
  publicWhatsapp         String?
  /// "Qué incluye tu inscripción": un beneficio por ítem (clases de
  /// maquillaje, oratoria…). Vacío = la sección no se muestra.
  registrationBenefits   String[]  @default([])
  /// Lugar y horario de las clases de preparación ("Por confirmar", etc.).
  registrationClassesNote String?
  /// Qué secciones muestra el micrositio. Candidatas y auspiciadores
  /// visibles por defecto (es la razón de ser del sitio); ranking de votos y
  /// resultados apagados hasta que producción decida revelarlos.
  showCandidatesPublic   Boolean   @default(true)
  showSponsorsPublic     Boolean   @default(true)
  showVoteRankingPublic  Boolean   @default(false)
  showResultsPublic      Boolean   @default(false)
  /// Formulario "Quiero auspiciar" del micrositio: crea un prospecto en el
  /// CRM (`hasSalesPipeline`). Sin CRM contratado el formulario no aparece.
  sponsorLeadFormEnabled Boolean   @default(true)

  @@unique([companyId, code])
  @@index([companyId, status])
}

enum CandidateRegistrationStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

/// Contrato de auspicio/patrocinio con una marca (`Contact`), en efectivo,
/// canje (barter) o ambos. `paidAmount`/`paymentStatus` son autocontenidos en
/// V1 (no pasan por el libro de Tesorería) para que el módulo funcione sin
/// depender de `hasTreasury`.
model SponsorshipContract {
  id                   String                   @id @default(cuid())
  companyId            String
  company              Company                  @relation(fields: [companyId], references: [id])
  projectId            String
  project              Project                  @relation(fields: [projectId], references: [id])
  contactId            String
  contact              Contact                  @relation(fields: [contactId], references: [id])
  tier                 SponsorshipTier
  isBarter             Boolean                  @default(false)
  cashAmount           Int                      @default(0)
  barterValuation      Int                      @default(0)
  barterDescription    String?
  status               SponsorshipStatus        @default(PROPOSAL)
  paidAmount           Int                      @default(0)
  paymentStatus        PaymentStatus            @default(UNPAID)
  notes                String?
  /// Token de acceso al portal público de la marca auspiciadora (mismo
  /// concepto que `JudgeAssignment.accessToken`): sin cuenta ni sesión ERP, la
  /// marca ve su propio cumplimiento/pago solo con este link. `null` hasta que
  /// alguien del equipo lo genera desde el panel interno — no se crea uno por
  /// defecto al crear el contrato para no filtrar links no solicitados.
  portalToken          String?                  @unique
  /// Carta de compromiso generada desde `DocumentTemplate` (tipo
  /// `SPONSOR_COMMITMENT_LETTER`). El estado (no generada / pendiente de
  /// firma / firmada) se deriva en el servicio a partir de estos 3 campos,
  /// nunca se guarda un status mutable — mismo criterio que
  /// `CandidateDocument.status`. Regenerar solo se permite mientras
  /// `agreementSignedAt` sea `null`.
  agreementFileUrl     String?
  agreementGeneratedAt DateTime?
  agreementSignedAt    DateTime?
  deliverables         SponsorshipDeliverable[]
  /// Plan del tarifario del que salió este contrato (si salió de uno). Es la
  /// base del conteo de cupos vendidos por plan. `SetNull`: borrar un plan
  /// no puede arrastrar contratos ya firmados.
  packageId            String?
  package              SponsorshipPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  /// Oportunidad del CRM que se convirtió en este contrato (trazabilidad
  /// venta → contrato). La FK vive en `Opportunity.sponsorshipContractId`.
  sourceOpportunity    Opportunity?
  payments             Payment[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([companyId, projectId])
  @@index([companyId, contactId])
  @@index([companyId, status])
  @@index([companyId, paymentStatus])
  @@index([packageId])
}

/// Plan del tarifario de auspicios de un certamen (ej. "Auspiciador Oro —
/// $8.000.000, 3 cupos"). Es lo que el equipo comercial ofrece: alimenta la
/// propuesta en el CRM, la sección "Planes de auspicio" del micrositio y, al
/// convertir un negocio ganado en contrato, la lista inicial de entregables
/// (`benefits`, uno por línea). `maxSlots null` = sin límite de cupos.
model SponsorshipPackage {
  id              String                @id @default(cuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tier            SponsorshipTier
  name            String
  /// Valor neto de lista en CLP entero. El precio real negociado queda en el
  /// contrato (`cashAmount`/`barterValuation`), no acá.
  price           Int                   @default(0)
  maxSlots        Int?
  benefits        String[]              @default([])
  description     String?
  /// Visible en el micrositio público. El precio se muestra solo si además
  /// `showPricePublic` — muchas productoras no publican tarifas.
  isPublic        Boolean               @default(true)
  showPricePublic Boolean               @default(false)
  order           Int                   @default(0)
  contracts       SponsorshipContract[]
  opportunities   Opportunity[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([companyId, projectId])
}

/// Checklist de compromisos entregables a la marca auspiciadora (logo en
/// backdrop, mención en vivo, reel en redes, etc).
model SponsorshipDeliverable {
  id          String                     @id @default(cuid())
  companyId   String
  company     Company                    @relation(fields: [companyId], references: [id])
  contractId  String
  contract    SponsorshipContract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  /// Tipificación del entregable (mención, backstage, pauta, otro). Default
  /// `OTRO` para no romper los entregables ya cargados antes de este campo.
  type        SponsorshipDeliverableType @default(OTRO)
  dueDate     DateTime?
  isCompleted Boolean                    @default(false)
  completedAt DateTime?
  proofUrl    String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([companyId, contractId])
}

enum SponsorshipDeliverableType {
  MENCION
  BACKSTAGE
  PAUTA
  OTRO
}

enum DocumentTemplateType {
  SPONSOR_COMMITMENT_LETTER
  CANDIDATE_CONTRACT
}

/// Plantilla estándar de un documento generado (carta de compromiso de
/// sponsors, contrato de imagen de candidatas). `bodyText` es texto plano con
/// placeholders `{{variable}}` sustituidos al generar el PDF — sin motor de
/// scripting. Una sola plantilla vigente por tipo por empresa: guardar sobre
/// ella actualiza el "formato estipulado", no crea una versión nueva.
model DocumentTemplate {
  id        String               @id @default(cuid())
  companyId String
  company   Company              @relation(fields: [companyId], references: [id])
  type      DocumentTemplateType
  name      String
  bodyText  String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([companyId, type])
}

/// Boleta de Honorarios Electrónica (BHE) de un prestador de servicios
enum BudgetStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// Presupuesto operativo general por período (ej. "Presupuesto 2027"),
/// independiente de `Project.budgetedIncome`/`budgetedExpense` (ese es
/// presupuesto POR CERTAMEN; este es el gasto/ingreso general de la empresa
/// por categoría — arriendo, sueldos, flores y coronas, etc). Módulo
/// `hasBudgets`.
model Budget {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name        String
  periodStart DateTime
  periodEnd   DateTime
  status      BudgetStatus @default(DRAFT)
  notes       String?
  lines       BudgetLine[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId, status])
}

/// Línea de presupuesto por categoría de texto libre (no un plan de cuentas
/// formal — a propósito, para no exigir `hasAccounting`). El "real" se suma
/// desde `Payment.budgetLineId` de los pagos que el staff etiquete a esta
/// línea al registrarlos en Tesorería.
model BudgetLine {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  budgetId      String
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category      String
  plannedAmount Int
  notes         String?
  payments      Payment[]
  createdAt     DateTime  @default(now())

  @@index([companyId, budgetId])
}

enum PromissoryNoteStatus {
  ACTIVE
  PAID
  PROTESTED
  CANCELLED
}

/// Pagaré firmado por un deudor (`Contact`, opcionalmente vinculado a una
/// `Candidate` para verlo desde su ficha). `paidAmount`/`paymentStatus`
/// autocontenidos, mismo patrón que `SponsorshipContract` — funciona sin
/// depender de `hasTreasury`. Módulo `hasPromissoryNotes`.
model PromissoryNote {
  id            String               @id @default(cuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId     String
  contact       Contact              @relation(fields: [contactId], references: [id], onDelete: Restrict)
  candidateId   String?
  candidate     Candidate?           @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  amount        Int
  issueDate     DateTime             @default(now())
  dueDate       DateTime
  /// Blob del pagaré firmado (imagen o PDF), mismo criterio de storage que
  /// `CandidateDocument.fileUrl`. Opcional: puede registrarse antes de
  /// escanear el papel.
  documentUrl   String?
  paidAmount    Int                  @default(0)
  paymentStatus PaymentStatus        @default(UNPAID)
  status        PromissoryNoteStatus @default(ACTIVE)
  notes         String?
  payments      Payment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([companyId, status, dueDate])
  @@index([companyId, contactId])
  @@index([companyId, candidateId])
}

enum PaymentPlanFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Plan de cuotas/mensualidades (ej. "6 cuotas de $150.000 por preparación de
/// candidata"). Genera sus `PaymentPlanInstallment` al crearse — ver
/// `createPaymentPlan` en `payment-plans.service.ts`. Módulo `hasInstallmentPlans`.
model PaymentPlan {
  id               String                    @id @default(cuid())
  companyId        String
  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId        String
  contact          Contact                   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  candidateId      String?
  candidate        Candidate?                @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  totalAmount      Int
  installmentCount Int
  frequency        PaymentPlanFrequency      @default(MONTHLY)
  startDate        DateTime
  /// Multa por cuota vencida, en basis points sobre el monto de ESA cuota
  /// (1000 = 10%). `0` = sin cláusula de penalización.
  penaltyBps       Int                       @default(0)
  status           PaymentPlanStatus         @default(ACTIVE)
  notes            String?
  installments     PaymentPlanInstallment[]
  onlinePayments   InstallmentPaymentOrder[]
  payments         Payment[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([companyId, status])
  @@index([companyId, contactId])
  @@index([companyId, candidateId])
}

/// Cuota individual de un `PaymentPlan`. `paidAmount`/`paymentStatus`
/// autocontenidos, mismo patrón que el resto de los documentos financieros
/// nuevos de este módulo.
model PaymentPlanInstallment {
  id                String                        @id @default(cuid())
  companyId         String
  company           Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  paymentPlanId     String
  /// `Restrict`, no `Cascade`: protege contra un borrado accidental en
  /// cascada por fuera de la lógica de aplicación. El borrado deliberado y
  /// explícito de un `PaymentPlan` SÍ está soportado (`deletePaymentPlan` en
  /// `payment-plans.service.ts`, decisión de negocio: "no dejar dato
  /// estorbando" aunque haya pagos) — ese flujo borra primero las cuotas
  /// dentro de la misma transacción para sortear este `Restrict`. El uso
  /// cotidiano de dar de baja un plan sigue siendo cancelarlo
  /// (`status: CANCELLED`), que conserva el historial; borrar es la
  /// excepción explícita, no la regla.
  paymentPlan       PaymentPlan                   @relation(fields: [paymentPlanId], references: [id], onDelete: Restrict)
  installmentNumber Int
  dueDate           DateTime
  amount            Int
  paidAmount        Int                           @default(0)
  paymentStatus     PaymentStatus                 @default(UNPAID)
  /// Multa ya aplicada sobre esta cuota (CLP) — el cron de vencidas la aplica
  /// una sola vez, este campo es el guardia contra doble aplicación.
  penaltyApplied    Int                           @default(0)
  paidAt            DateTime?
  createdAt         DateTime                      @default(now())
  onlinePayments    InstallmentPaymentOrderItem[]
  payments          Payment[]

  @@unique([paymentPlanId, installmentNumber])
  @@index([companyId, paymentStatus, dueDate])
}

enum OnlinePaymentStatus {
  /// Orden creada y enviada a la pasarela; el pagador todavía no termina.
  PENDING
  /// La pasarela confirmó el pago y ya se aplicó a las cuotas.
  PAID
  /// La pasarela rechazó la creación del cobro o lo reportó revertido.
  FAILED
  /// Venció sin pago confirmado. Libera las cuotas para un nuevo intento.
  EXPIRED
}

/// Pago en línea de una o más cuotas desde el portal público `/pagar/[token]`
/// (sin login: la "credencial" es el RUT de la candidata). Nunca se marca
/// `PAID` por lo que diga el navegador ni el cuerpo de la notificación: el
/// servicio vuelve a consultar el cobro a la pasarela con la API key de la
/// empresa (`syncOrderWithProvider` en `online-payment.service.ts`).
///
/// Los datos de la candidata y del pagador quedan como snapshot (no FK a
/// `Candidate`): el comprobante es un documento emitido y no debe cambiar si
/// después se edita o se borra la ficha.
model InstallmentPaymentOrder {
  id                 String                        @id @default(cuid())
  companyId          String
  company            Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  paymentPlanId      String
  /// `Restrict`: `deletePaymentPlan` borra primero las órdenes, igual que
  /// hace con las cuotas.
  paymentPlan        PaymentPlan                   @relation(fields: [paymentPlanId], references: [id], onDelete: Restrict)
  /// 'KHIPU' hoy. Texto y no enum para sumar otra pasarela sin migrar.
  provider           String
  /// Id del cobro en la pasarela (`payment_id` de Khipu). `null` solo en el
  /// instante entre crear la orden y recibir la respuesta de la pasarela.
  providerPaymentId  String?
  paymentUrl         String?
  amount             Int
  status             OnlinePaymentStatus           @default(PENDING)
  payerName          String
  payerEmail         String
  candidateName      String
  candidateRutClean  String
  projectName        String?
  /// Correlativo del comprobante (`InternalDocumentSequence` kind
  /// `INSTALLMENT_RECEIPT`). Se asigna recién al confirmarse el pago.
  receiptNumber      Int?
  /// Capacidad de acceso pública: la página de estado y el PDF del
  /// comprobante se piden con este valor, nunca con el `id`.
  accessToken        String                        @unique
  providerReceiptUrl String?
  payerBank          String?
  /// Monto que llegó por sobre el saldo de las cuotas (p. ej. alguien
  /// registró un pago manual mientras esta orden estaba en curso). Se informa
  /// al equipo para devolverlo; no se aplica a otra cuota por su cuenta.
  excessAmount       Int                           @default(0)
  expiresAt          DateTime
  paidAt             DateTime?
  items              InstallmentPaymentOrderItem[]
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@unique([provider, providerPaymentId])
  @@unique([companyId, receiptNumber])
  @@index([companyId, paymentPlanId])
  @@index([companyId, status])
}

/// Cuota cubierta por una `InstallmentPaymentOrder`, con el monto que la
/// orden le asignó al crearse (su saldo pendiente en ese momento).
model InstallmentPaymentOrderItem {
  id                String                  @id @default(cuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  orderId           String
  order             InstallmentPaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  installmentId     String
  /// `Cascade`: `deleteInstallment` solo borra cuotas sin pagos, así que lo
  /// único que se arrastra acá son intentos no concretados.
  installment       PaymentPlanInstallment  @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount            Int

  @@unique([orderId, installmentId])
  @@index([companyId, installmentId])
}

/// Boleta de honorarios de un prestador de servicios (staff/proveedor)
/// freelance (`Contact`). La emite el prestador vía el SII — acá solo se
/// REGISTRA para efectos de retención y F29, por eso `folioNumber` es texto
/// libre (no un correlativo propio) y único por prestador, no por empresa.
/// `retentionRateBps`/`retentionAmount`/`netToPay` quedan congelados como
/// snapshot al emitir: si la tasa de la empresa cambia después, las boletas
/// ya emitidas no se recalculan.
model FeeDocument {
  id                 String         @id @default(cuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id])
  projectId          String?
  project            Project?       @relation(fields: [projectId], references: [id])
  contactId          String
  contact            Contact        @relation(fields: [contactId], references: [id])
  folioNumber        String
  status             DocumentStatus @default(ISSUED)
  issueDate          DateTime       @default(now())
  serviceDescription String
  grossAmount        Int
  /// Tasa de retención en basis points (1375 = 13.75%), copiada de
  /// `CompanySettings.honorariumRetentionBps` al crear.
  retentionRateBps   Int
  retentionAmount    Int
  netToPay           Int
  paidAmount         Int            @default(0)
  paymentStatus      PaymentStatus  @default(UNPAID)
  paymentDate        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([companyId, contactId, folioNumber])
  @@index([companyId, projectId])
  @@index([companyId, status])
  @@index([companyId, paymentStatus])
  @@index([companyId, issueDate])
}

/// Ficha de candidata/staff de un certamen concreto — a diferencia de los
/// otros 3 modelos, `projectId` es REQUERIDO: una candidata siempre
/// pertenece a una edición específica del evento. Datos sensibles (RUT,
/// fecha de nacimiento, contacto de emergencia): RBAC restringido a
/// OWNER/ADMIN (ver src/lib/auth/permissions.ts).
model Candidate {
  id                    String                @id @default(cuid())
  companyId             String
  company               Company               @relation(fields: [companyId], references: [id])
  projectId             String
  project               Project               @relation(fields: [projectId], references: [id])
  rut                   String
  rutClean              String
  fullName              String
  stageName             String?
  email                 String?
  phone                 String?
  /// Obligatoria en fichas creadas desde el panel; `null` en postulaciones del
  /// formulario público, que solo pide la edad (`declaredAge`).
  birthDate             DateTime?
  /// Edad declarada por la postulante en el formulario público, al momento de
  /// postular. Solo se usa cuando no hay `birthDate`.
  declaredAge           Int?
  dressSize             String?
  shoeSize              String?
  heightCm              Int?
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Nombre/RUT del padre, madre o representante legal — solo se completa si
  /// la candidata es menor de edad. El contrato de imagen incluye un tercer
  /// bloque de firma para el tutor únicamente cuando `guardianName` está
  /// cargado (ver `contract-pdf.service.ts`); si es null, ese bloque se omite
  /// en vez de dejarse en blanco sin sentido.
  guardianName          String?
  guardianRut           String?
  status                CandidateStatus       @default(APPLICANT)
  photoUrl              String?
  notes                 String?
  /// Folio público entregado a la postulante al enviar el formulario
  /// (`{Project.code}-{año}-{correlativo}`, ver `InternalDocumentSequence`
  /// con `kind = CANDIDATE_APPLICATION`). `null` en fichas creadas a mano
  /// desde el panel interno, que no pasan por auto-inscripción.
  folio                 String?
  // ── Campos del formulario público de postulación (Sección 5 del módulo) ──
  comuna                String?
  direccion             String?
  ocupacion             String?
  instagram             String?
  idiomas               String?
  experiencia           String?
  motivacion            String?
  causaSocial           String?
  /// Alergias o condiciones médicas relevantes declaradas por la propia
  /// candidata (ej. alergia a un maquillaje, condición que el equipo de
  /// producción deba conocer para ensayos/pasarela). Texto libre, no
  /// reemplaza un certificado médico real — para eso existe el documento
  /// `MEDICAL_CERTIFICATE` en `CandidateDocument`.
  condicionesMedicas    String?
  aceptaMarketing       Boolean               @default(false)
  /// Motivo obligatorio al pasar a `REJECTED` — no se usa para `WITHDRAWN`.
  motivoDescarte        String?
  /// Metadatos de origen del envío público, solo para envíos que llegaron por
  /// `submitCandidateRegistration` — nunca para fichas creadas a mano.
  ipOrigen              String?
  userAgent             String?
  /// Datos del empleador (texto libre, completado a mano o vía búsqueda web
  /// en `lookupCompaniesByName` — ver `src/modules/contacts/services/company-lookup.service.ts`).
  /// No hay relación estructurada con `Contact`: es solo un dato informativo
  /// de la ficha, no un cliente/proveedor de la empresa.
  employerName          String?
  employerRut           String?
  employerAddress       String?
  // ── Presentación pública (micrositio, votación, escaleta) ───────────────
  /// Número oficial de candidata en el certamen ("Candidata N° 7"). Único
  /// por proyecto; `null` mientras no se numera (Postgres admite varios NULL
  /// bajo un índice único).
  candidateNumber       Int?
  /// Ciudad, región o país que representa ("Valparaíso", "Chile"): el
  /// "Miss ___" de la banda.
  representing          String?
  /// Texto de presentación para el micrositio, escrito por el equipo — no se
  /// reutiliza nada del formulario privado de postulación sin que alguien lo
  /// decida y lo escriba acá.
  publicBio             String?
  /// Permite ocultar a una candidata oficial del micrositio sin cambiar su
  /// estado en el certamen.
  showOnPublicSite      Boolean               @default(true)
  attendances           CandidateAttendance[]
  documents             CandidateDocument[]
  wardrobeItems         WardrobeItem[]
  stageTimelineItems    StageTimelineItem[]
  scoreSheets           ScoreSheet[]
  roundEntries          RoundContestant[]
  promissoryNotes       PromissoryNote[]
  paymentPlans          PaymentPlan[]
  voteOrders            VoteOrder[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([companyId, projectId, rutClean])
  // Folio único por empresa, no global: cada empresa tiene su propio
  // correlativo (`InternalDocumentSequence` es per-company), así que dos
  // empresas distintas del mismo SaaS pueden legítimamente compartir folio.
  @@unique([companyId, folio])
  @@unique([projectId, candidateNumber])
  @@index([companyId, projectId, status])
  @@index([companyId, comuna])
  @@index([companyId, createdAt])
}

enum CandidateActivityType {
  PASARELA
  ORATORIA
  ENSAYO
  TALLER
  EVENTO
  OTRO
}

/// Una fecha agendada de taller/ensayo/evento para todas las candidatas de un
/// proyecto. Se genera en lote (ej. "martes y jueves entre tal y tal fecha")
/// para poder pasar lista una sola vez por sesión en vez de ficha por ficha.
model CandidateSession {
  id           String                @id @default(cuid())
  companyId    String
  company      Company               @relation(fields: [companyId], references: [id])
  projectId    String
  project      Project               @relation(fields: [projectId], references: [id])
  activityType CandidateActivityType
  title        String?
  date         DateTime
  time         String?
  location     String?
  notes        String?
  createdAt    DateTime              @default(now())
  attendance   CandidateAttendance[]

  @@index([companyId, projectId, date])
}

/// Registro de asistencia a un taller/ensayo/actividad de preparación. Una
/// fila por actividad, no un acumulado — así se puede armar el detalle de
/// inasistencias, no solo el conteo. `sessionId` es nulo para registros
/// puntuales cargados desde la ficha individual (no vienen de una sesión
/// masiva); onDelete SetNull para no perder el histórico si se borra la sesión.
model CandidateAttendance {
  id           String                @id @default(cuid())
  companyId    String
  company      Company               @relation(fields: [companyId], references: [id])
  candidateId  String
  candidate    Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      CandidateSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  activityType CandidateActivityType
  activityDate DateTime
  attended     Boolean               @default(true)
  notes        String?
  createdAt    DateTime              @default(now())

  @@unique([sessionId, candidateId])
  @@index([companyId, candidateId])
}

enum CandidateDocumentStatus {
  PENDING
  SIGNED
  EXPIRED
}

enum CandidateDocumentType {
  CONTRACT_IMAGE
  OTHER
  /// Fotografía de rostro enviada con el formulario público de postulación.
  PHOTO_FACE
  /// Fotografía de cuerpo entero enviada con el formulario público de postulación.
  PHOTO_FULL_BODY
  /// Certificado médico (imagen o PDF) subido opcionalmente con el
  /// formulario público de postulación.
  MEDICAL_CERTIFICATE
}

/// Contrato de imagen u otro documento que la candidata debe firmar.
/// `status` se recalcula en la app (nunca se confía en lo que mande el
/// cliente) comparando `expiresAt` contra la fecha actual, mismo criterio que
/// el resto del sistema para estados derivados. `documentType` identifica el
/// contrato generado desde plantilla (`CONTRACT_IMAGE`) — default `OTHER`
/// para no romper los documentos ya cargados antes de este campo, mismo
/// criterio que `SponsorshipDeliverable.type`. Solo puede existir una fila
/// `CONTRACT_IMAGE` sin firmar por candidata a la vez; la regla se valida en
/// `services/documents.service.ts`, no se puede expresar como unique parcial
/// en Prisma.
model CandidateDocument {
  id               String                  @id @default(cuid())
  companyId        String
  company          Company                 @relation(fields: [companyId], references: [id])
  candidateId      String
  candidate        Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title            String
  documentType     CandidateDocumentType   @default(OTHER)
  fileUrl          String
  signedAt         DateTime?
  expiresAt        DateTime?
  status           CandidateDocumentStatus @default(PENDING)
  /// Token del documento en ZapSign — correlaciona el webhook de firma con
  /// esta fila. `null` para documentos subidos a mano (sin firma electrónica).
  zapsignDocToken  String?                 @unique
  /// Link de firma de ZapSign, guardado como respaldo por si el correo
  /// automático no llega — mismo criterio que `SponsorshipContract.portalToken`,
  /// salvo que este link lo emite y controla ZapSign, no nosotros.
  zapsignSignUrl   String?
  /// Metadatos capturados al recibir el archivo — solo poblados para
  /// `PHOTO_FACE`/`PHOTO_FULL_BODY` subidas por el formulario público
  /// (tipo MIME real leído de los primeros bytes, tamaño y hash SHA-256).
  /// `null` en documentos previos a este campo y en los subidos a mano.
  mimeType         String?
  fileSizeBytes    Int?
  sha256Hash       String?
  originalFileName String?
  createdAt        DateTime                @default(now())

  @@index([companyId, candidateId])
}

// ============================================================================
// Producción y Escaleta en Vivo (módulo `hasLiveProduction`, apagado por
// defecto): escaleta minuto a minuto, asignación de vestuario y acreditación
// de staff/proveedores por certamen (`Project`). Sin dependencia de
// Candidatas/Auspicios — un certamen puede contratar solo este módulo.
// ============================================================================

enum StageItemStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

/// Un bloque de la escaleta (ej. "Traje de baño — Bloque 3"). `blockOrder` es
/// el orden real en vivo — se reordena moviendo el número, nunca reordenando
/// filas por fecha de creación.
/// Tipo de segmento de un certamen de belleza: ordena la escaleta, colorea el
/// modo show y sugiere el vestuario que corresponde a cada bloque.
enum StageSegmentType {
  OPENING
  PRESENTATION
  SWIMSUIT
  EVENING_GOWN
  NATIONAL_COSTUME
  QUESTION
  ARTISTIC
  SPONSOR
  BREAK
  CROWNING
  OTHER
}

model StageTimelineItem {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blockOrder      Int
  startTime       DateTime
  durationMinutes Int
  title           String
  description     String?
  status          StageItemStatus  @default(PENDING)
  candidateId     String?
  candidate       Candidate?       @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  wardrobeItems   WardrobeItem[]
  /// Default `OTHER` para no reclasificar a ciegas los bloques ya cargados.
  segmentType     StageSegmentType @default(OTHER)
  /// Quién da el pie o es responsable del bloque (conductor, jefe de piso…).
  responsible     String?
  /// Pies técnicos por área — lo que el switcher/sonido/luces leen en vivo.
  audioCue        String?
  lightingCue     String?
  videoCue        String?
  /// Hora real de inicio/fin, marcadas desde el modo show. Son la base del
  /// adelanto/atraso acumulado; `startTime` sigue siendo el plan.
  actualStartedAt DateTime?
  actualEndedAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([projectId, blockOrder])
  @@index([companyId, projectId])
}

enum WardrobeStatus {
  PENDING
  READY
  ISSUED
  RETURNED
}

/// De dónde sale la prenda — define a quién se le devuelve y si entra al
/// valor de canje de un auspicio.
enum WardrobeSource {
  PRODUCTION
  DESIGNER
  SPONSOR
  RENTAL
  CANDIDATE_OWN
}

/// Prenda/accesorio asignado a una candidata para un bloque de la escaleta.
model WardrobeItem {
  id                  String             @id @default(cuid())
  companyId           String
  company             Company            @relation(fields: [companyId], references: [id])
  projectId           String
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  designer            String?
  stageTimelineItemId String?
  stageTimelineItem   StageTimelineItem? @relation(fields: [stageTimelineItemId], references: [id], onDelete: SetNull)
  candidateId         String?
  candidate           Candidate?         @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  status              WardrobeStatus     @default(PENDING)
  notes               String?
  source              WardrobeSource     @default(PRODUCTION)
  size                String?
  color               String?
  /// Valor declarado en CLP entero (seguro, garantía de arriendo o canje).
  valuation           Int?
  /// Prueba de vestuario agendada.
  fittingAt           DateTime?
  /// Fecha comprometida de devolución (arriendo, diseñador, auspicio).
  returnDueAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([companyId, projectId])
  @@index([companyId, stageTimelineItemId])
}

enum AccreditationLevel {
  GENERAL
  BACKSTAGE
  VIP
  STAFF
}

enum BadgeBackgroundMode {
  COLOR
  IMAGE
}

enum BadgeImageDisplayMode {
  SOLID
  WATERMARK
}

/// Plantilla de diseño visual para credenciales de staff de un proyecto/evento
/// (fondo sólido o imagen subida, modo "marca de agua" u "opaco", colores de
/// acento/texto). Varias por proyecto (ej. una para VIP, otra para GENERAL);
/// `isDefault` marca la que se usa cuando una acreditación no elige una
/// explícitamente. Que solo haya una `isDefault=true` por proyecto se aplica en
/// la capa de servicio (transacción) — Prisma no soporta índice único parcial
/// (`WHERE isDefault = true`), mismo caso que `CandidateDocument`.
model BadgeTemplate {
  id                  String                @id @default(cuid())
  companyId           String
  company             Company               @relation(fields: [companyId], references: [id])
  projectId           String
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  backgroundMode      BadgeBackgroundMode   @default(COLOR)
  backgroundColor     String                @default("#1e3a5f")
  backgroundImageUrl  String?
  imageDisplayMode    BadgeImageDisplayMode @default(SOLID)
  /// Opacidad de la imagen de fondo en basis points (0-10000), solo relevante si imageDisplayMode = WATERMARK.
  watermarkOpacityBps Int                   @default(2000)
  accentColor         String                @default("#1e3a5f")
  textColor           String                @default("#0f172a")
  isDefault           Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  accreditations      StaffAccreditation[]

  @@index([companyId, projectId])
}

/// Acreditación de staff/proveedor externo (no es un `User` del ERP —
/// cámaras, seguridad, catering, etc.). `badgeCode` es lo que se escanea/
/// digita en la puerta para hacer `checkedInAt`.
model StaffAccreditation {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fullName      String
  role          String
  organization  String?
  email         String?
  accessLevel   AccreditationLevel @default(GENERAL)
  badgeCode     String
  /// Token opaco y no adivinable (no correlativo como badgeCode) que identifica la credencial en la página pública de verificación / el QR. Nunca se expone el id interno ni companyId en esa URL.
  qrToken       String             @unique @default(cuid())
  qrEmailSentAt DateTime?
  checkedInAt   DateTime?
  createdAt     DateTime           @default(now())
  /// Plantilla de diseño elegida para esta credencial. `SetNull` al borrar la
  /// plantilla: la acreditación ya emitida no debe romperse, solo vuelve al
  /// estilo por defecto.
  templateId    String?
  template      BadgeTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([companyId, badgeCode])
  @@index([companyId, projectId])
  @@index([templateId])
}

// ============================================================================
// Votación y Escrutinio en Vivo (módulo `hasJudging`, apagado por defecto):
// categorías/criterios, jurados externos (acceso por link con token, no son
// `User` del ERP) y planillas de puntuación con bloqueo anti-edición
// post-envío. El resultado ponderado nunca se persiste — se recalcula en cada
// consulta desde los `ScoreSheet` en estado SUBMITTED, mismo principio que el
// balance de comprobación contable: ningún saldo es un campo que se
// actualiza.
// ============================================================================

/// Categoría/criterio de evaluación (ej. "Traje de Baño", "Entrevista") de
/// una ronda concreta. `weightBps` es la ponderación en basis points; la app
/// valida que las categorías de una misma ronda sumen 10000 al marcarla
/// lista — no se fuerza a nivel de base porque Prisma no puede expresar una
/// restricción de suma entre filas. `projectId` queda denormalizado (se
/// valida en el servicio que sea el mismo de `round.projectId`) para no
/// tener que resolver la ronda en cada consulta que ya filtraba por proyecto.
model JudgingCategory {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roundId     String
  round       CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  name        String
  weightBps   Int
  maxScore    Int              @default(10)
  order       Int              @default(0)
  scoreSheets ScoreSheet[]
  createdAt   DateTime         @default(now())

  @@unique([roundId, name])
  @@index([companyId, projectId])
  @@index([companyId, roundId])
}

enum RoundStatus {
  DRAFT
  READY
  VOTING
  VOTING_CLOSED
  COMPLETED
}

/// Una ronda eliminatoria del certamen (ej. "Preliminar", "Top 10", "Top 5",
/// "Final"). `cutOffCount` es cuántas candidatas clasifican a la siguiente
/// ronda — null en la ronda final, donde no hay corte sino posiciones 1/2/3.
/// El estado de una ronda solo avanza hacia adelante (`RoundStatus`), nunca
/// se retrocede: cerrar/completar una ronda es una decisión de producción en
/// vivo, no un borrador editable.
model CompetitionRound {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order        Int
  name         String
  cutOffCount  Int?
  isFinalRound Boolean     @default(false)
  status       RoundStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  categories  JudgingCategory[]
  contestants RoundContestant[]
  scoreSheets ScoreSheet[]

  @@unique([projectId, order])
  @@index([companyId, projectId])
}

/// Participación de una candidata en una ronda concreta. `qualified` es la
/// fuente de verdad de "sigue en competencia" para esa ronda — no se toca
/// `Candidate.status` hasta la ronda final (ver `completeRound` en
/// `rounds.service.ts`), así una candidata eliminada en el Top 10 sigue
/// siendo `OFFICIAL_CANDIDATE`/`FINALIST` en su ficha, solo que no aparece en
/// las rondas siguientes. `finalScore`/`rank` se escriben una única vez, al
/// cerrar la ronda (`closeRound`) — el guard vive en el servicio con el mismo
/// patrón `updateMany` + `where: { round: { status: 'VOTING' } }` que usa
/// `ScoreSheet` para impedir reescribir un puntaje ya enviado.
model RoundContestant {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  roundId     String
  round       CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  finalScore  Float?
  rank        Int?
  qualified   Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@unique([roundId, candidateId])
  @@index([companyId, roundId])
}

/// Jurado externo de un certamen. No es un `User` del ERP: se le da acceso
/// por `accessToken` (mismo concepto que `Invitation.token`), sin cuenta ni
/// contraseña — un jurado de una gala no necesita ni debe tener acceso al
/// resto del sistema.
model JudgeAssignment {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  judgeName   String
  judgeEmail  String?
  accessToken String       @unique
  scoreSheets ScoreSheet[]
  createdAt   DateTime     @default(now())

  @@index([companyId, projectId])
}

enum ScoreSheetStatus {
  DRAFT
  SUBMITTED
}

/// Puntuación de un jurado a una candidata en una categoría. Inmutable una vez
/// `SUBMITTED` — el guard vive en la capa de aplicación (`updateMany` con
/// `where: { status: 'DRAFT' }`, mismo patrón que `journal.service.ts` para un
/// período cerrado), no hay trigger SQL para esto todavía. `roundId` queda
/// denormalizado de `category.roundId` para filtrar resultados por ronda sin
/// join. `auditHash`/`ipAddress`/`userAgent` se completan solo al enviar
/// (`submitScore`), nunca en el borrador — son el sello de integridad del
/// voto final, no de cada edición intermedia.
model ScoreSheet {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  judgeAssignmentId String
  judgeAssignment   JudgeAssignment  @relation(fields: [judgeAssignmentId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  categoryId        String
  category          JudgingCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  roundId           String
  round             CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  score             Int
  status            ScoreSheetStatus @default(DRAFT)
  submittedAt       DateTime?
  /// Sello SHA-256 sobre (jurado, candidata, categoría, puntaje, submittedAt)
  /// calculado en `submitScore` — prueba de que el valor guardado es el que
  /// el jurado efectivamente envió, no una edición posterior directa en BD.
  auditHash         String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([judgeAssignmentId, candidateId, categoryId])
  @@index([companyId, candidateId])
  @@index([companyId, categoryId])
  @@index([companyId, roundId])
}

// ============================================================================
// Entradas y votación pública de la gala (módulos `hasTicketing` /
// `hasPublicVoting`, apagados por defecto).
//
// V1 sin pasarela de pago: no hay integración con Webpay/Flow/Mercadopago en
// este repo. El comprador paga por transferencia fuera del sistema (datos en
// `CompanySettings.bankTransferInfo`) y el staff confirma el pago a mano
// desde el panel — mismo criterio "autocontenido" que `SponsorshipContract`.
// `paymentStatus` es el mismo campo que usaría un futuro webhook de pasarela,
// así que integrarla después no exige rediseñar este modelo.
// ============================================================================

/// Tipo de entrada de un certamen (General, VIP, etc). `quantityAvailable
/// null` = sin límite de cupo.
model TicketType {
  id                String       @id @default(cuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projectId         String
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name              String
  price             Int
  quantityAvailable Int?
  salesOpen         Boolean      @default(true)
  sales             TicketSale[]
  createdAt         DateTime     @default(now())

  @@index([companyId, projectId])
}

/// Orden de compra de entrada(s), creada desde `/tickets/[token]` sin login.
/// `qrCode` es el control de acceso el día del evento — se genera solo al
/// confirmar el pago (`checkedInAt` marca el ingreso real).
model TicketSale {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  ticketTypeId  String
  ticketType    TicketType    @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  buyerName     String
  buyerEmail    String
  buyerPhone    String?
  quantity      Int
  totalAmount   Int
  /// `PARTIAL` no aplica en la práctica (venta manual de monto fijo, todo o
  /// nada) pero se guarda igual por si el staff confirma un abono parcial.
  paidAmount    Int           @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  qrCode        String        @unique
  checkedInAt   DateTime?
  createdAt     DateTime      @default(now())

  @@index([companyId, projectId])
  @@index([companyId, paymentStatus])
  @@index([companyId, ticketTypeId])
}

/// Orden de votos pagados por una candidata, creada desde `/votar/[token]`
/// sin login. Solo cuenta para el conteo público (`getVoteLeaderboard`) si
/// `paymentStatus === 'PAID'` — una orden `UNPAID` no es un voto real todavía.
model VoteOrder {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  candidateId   String
  candidate     Candidate     @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  buyerEmail    String
  buyerPhone    String?
  voteCount     Int
  pricePerVote  Int
  totalAmount   Int
  /// Ver nota equivalente en `TicketSale.paidAmount`.
  paidAmount    Int           @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  createdAt     DateTime      @default(now())

  @@index([companyId, projectId])
  @@index([companyId, candidateId])
  @@index([companyId, paymentStatus])
  @@index([companyId, candidateId, paymentStatus])
}

// ============================================================================
// Inteligencia de Negocio: Agentes (módulo `hasCrm`, apagado por defecto)
//
// Equipo ejecutivo virtual (CEO/CFO/COO/Ventas) que analiza datos REALES ya
// existentes en el ERP (ventas, compras, inventario, tesorería, todos ya
// relacionados entre sí por `companyId`) y propone recomendaciones para que
// el dueño las lea. Ningún agente hace scraping externo, gestiona leads ni
// envía comunicación a terceros — todo el resultado de una corrida es texto
// informativo guardado en `AgentTask`, nunca una acción fuera del sistema.
// `requiresApproval` queda en el modelo por si un rol futuro sí necesita un
// paso de aprobación con una acción externa detrás; en este módulo todos los
// roles lo dejan en `false`.
// ============================================================================

/// Tarea/recomendación generada por un agente para que un humano la lea. Es
/// el único canal por el que un agente "actúa": crear una fila acá, nunca
/// ejecutar ninguna acción externa directamente.
model AgentTask {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  role             AgentRole
  title            String
  description      String
  status           AgentTaskStatus @default(PENDING)
  /// Datos de respaldo de la recomendación (ej. el resumen de métricas en que
  /// se basó). Sin tipar a propósito: cada rol define su propia forma.
  payload          Json?
  requiresApproval Boolean         @default(false)
  approvedByUserId String?
  approvedByUser   User?           @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([companyId, role, status])
  @@index([approvedByUserId])
}

/// Una fila por corrida de un agente (cron o manual). Nunca queda colgada en
/// `RUNNING`: `runAgent()` (src/modules/agents/engine.ts) la cierra en
/// `COMPLETED` o `FAILED` sin importar cómo termine `fn()`.
model AgentRun {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  role       AgentRole
  status     AgentRunStatus @default(RUNNING)
  summary    String?
  error      String?
  startedAt  DateTime       @default(now())
  finishedAt DateTime?

  @@index([companyId, role, startedAt])
}

/// Marca de "ya confirmado" para el flujo "proponer → confirmar" del
/// asistente (OP-07 de la auditoría de arquitectura): el `jti` firmado en
/// `signPendingAction` (src/modules/agent-actions/token.ts) se consume
/// insertando una fila aquí, no en un `Map` en memoria de proceso — bajo
/// Vercel cada instancia tiene su propia memoria, así que el `Map` no
/// detectaba el reuso del mismo token entre instancias distintas y la
/// acción (que escribe en la base) podía ejecutarse dos veces.
///
/// `@@unique([companyId, jti])`: la propia base detecta el reintento
/// concurrente de forma atómica entre instancias (violación de constraint
/// única, ver `src/lib/prisma-errors.ts`), sin necesitar coordinación
/// adicional. La fila nace `PENDING` en el mismo insert que consume el jti
/// (antes de llamar a `action.execute`) y se actualiza a `SUCCEEDED`/`FAILED`
/// después — así el propio insert ya bloquea el segundo uso aunque la
/// ejecución de la acción todavía no haya terminado.
model AgentActionConfirmation {
  id            String                        @id @default(cuid())
  companyId     String
  company       Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jti           String
  actionType    String
  status        AgentActionConfirmationStatus @default(PENDING)
  resultSummary String?
  createdAt     DateTime                      @default(now())

  @@unique([companyId, jti])
  @@index([companyId])
}

// ============================================================================
// Bitácora de plataforma (superadmin)
// ============================================================================

/// Bitácora de acciones destructivas a nivel de plataforma (hoy: borrado
/// permanente de un tenant). A propósito NO tiene relación FK hacia `Company`:
/// todos los campos que identifican a la empresa son snapshots de texto plano
/// tomados ANTES de borrarla, así que esta fila sobrevive para siempre,
/// independiente del ciclo de vida de cualquier tenant — si tuviera FK, sería
/// imposible dejar constancia de que una empresa fue eliminada (la propia
/// bitácora de la empresa, `AuditLog`, vive dentro del tenant y se borra junto
/// con él).
model PlatformAuditLog {
  id                  String   @id @default(cuid())
  action              String
  companyId           String
  companyRut          String
  companyBusinessName String
  performedByUserId   String
  performedByEmail    String
  metadata            Json?
  ipAddress           String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([companyId])
}

// ============================================================================
// Bitácora de seguridad (transversal a toda la plataforma)
//
// A diferencia de `AuditLog` (acciones de negocio por tenant) y
// `PlatformAuditLog` (superadmin), esta tabla registra eventos de seguridad
// que no pertenecen a ningún tenant en particular — un intento de login
// fallido con un email inexistente no tiene `companyId`. Sin FK a User ni a
// Company a propósito: debe funcionar para cualquier evento, exista o no el
// actor en el sistema.
// ============================================================================

/// Evento de seguridad: intentos de login, lockouts, rate limits, resets de
/// contraseña, revocación de sesiones. Nunca almacena contraseñas ni PII
/// sensible — solo email, IP y metadatos descriptivos del evento.
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String // LOGIN_SUCCESS, LOGIN_FAILED, LOGIN_LOCKED, TOTP_FAILED,
  // TOTP_LOCKED, PASSWORD_RESET_REQUESTED, PASSWORD_CHANGED,
  // RATE_LIMITED, SESSION_REVOKED, etc.
  email     String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ============================================================================
// Idempotencia de Webhooks externos
// ============================================================================

/// Registro de deduplicación para webhooks externos (Stripe, Transbank, SII, etc).
/// Previene la ejecución múltiple de un mismo evento ante reintentos automáticos de la pasarela.
model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  companyId   String?
  provider    String // 'stripe' | 'transbank' | 'sii' | 'custom'
  eventId     String
  eventType   String
  payload     Json?
  status      String   @default("PROCESSED") // 'PROCESSED' | 'FAILED' | 'IGNORED'
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  /// `companyId` va en la clave de unicidad (no solo `provider`+`eventId`):
  /// dos empresas distintas pueden coincidir en el mismo `eventId` si su
  /// automatización externa genera el hash sin incluir la empresa (ej. un
  /// mismo workflow de n8n reusado por varios clientes con
  /// fecha+monto+glosa). Sin `companyId` acá, el evento de la segunda
  /// empresa se descartaría en silencio como "duplicado" del de la
  /// primera — el pago de la segunda empresa nunca se registraría.
  @@unique([provider, companyId, eventId])
  @@index([companyId, provider])
  @@index([createdAt])
}

// ============================================================================
// Mensajería interna
// ============================================================================

/// Chat interno de la empresa (equivalente a un Slack/WhatsApp propio). Es
/// capacidad transversal (permiso `messaging:use`, ver `src/lib/auth/permissions.ts`),
/// NO un módulo de `CompanyFeatures`: cualquier empresa contratada, sin
/// importar el plan, puede usarlo entre su propio equipo — no se vende por
/// separado.
enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        ConversationType @default(DIRECT)
  /// Solo GROUP: nombre visible del canal. Un DIRECT muestra el nombre del
  /// otro participante, resuelto en el servicio, nunca guardado acá.
  name        String?
  /// Solo DIRECT: par de userIds ordenado ("idA:idB") para no crear dos
  /// conversaciones 1 a 1 entre las mismas dos personas. `null` en GROUP.
  directKey   String?
  createdById String
  createdBy   User             @relation("MessagingConversationCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  /// Se toca en cada mensaje nuevo — así "Conversaciones" se puede ordenar
  /// por actividad reciente con un solo `orderBy`, sin agregar sobre `Message`.
  updatedAt   DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  attachments  MessageAttachment[]

  @@unique([companyId, directKey])
  @@index([companyId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hasta dónde leyó esta persona — la base del contador de "no leídos" en
  /// el sidebar (mensajes de la conversación con `createdAt > lastReadAt`).
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  /// "Borrar conversación" es ocultarla para quien la borra, no destruir el
  /// historial de la otra persona (mismo criterio que `Message.deletedAt`:
  /// nunca hard-delete de mensajería). `listConversationsAction` filtra las
  /// filas con `hiddenAt` seteado; llega un mensaje nuevo y vuelve a aparecer
  /// (se limpia al enviar/recibir, ver `messaging.service.ts`).
  hiddenAt       DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, hiddenAt])
}

/// Cuerpo del mensaje cifrado en reposo (AES-256-GCM, `src/lib/messaging/crypto.ts`):
/// nadie con acceso directo a la base (o un respaldo filtrado) puede leer el
/// contenido sin la llave del servidor. `ciphertext` es `null` cuando el
/// mensaje es solo adjunto(s), sin texto.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Denormalizado a propósito: permite filtrar por `companyId` en consultas
  /// de auditoría/soporte sin tener que unir contra `Conversation` primero —
  /// mismo criterio que otros modelos transversales del proyecto.
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  ciphertext     String?
  /// Baja lógica: "Eliminar mensaje" solo lo oculta (mismo criterio que el
  /// resto del sistema), nunca se sobrescribe el historial de otros.
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  attachments MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([companyId])
}

/// El archivo se cifra completo (IV + authTag + ciphertext concatenados) antes
/// de subirse a Vercel Blob — el blob en sí nunca contiene el contenido en
/// claro, y su URL jamás se entrega al navegador: siempre se descarga a
/// través de `/api/messaging/attachments/[id]`, que valida membresía en la
/// conversación y descifra en el servidor. `messageId` nace `null` (el
/// archivo se sube antes de que exista el mensaje que lo va a llevar) y se
/// fija recién cuando `sendMessageAction` lo asocia.
model MessageAttachment {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
  messageId      String?
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  /// Tamaño original del archivo (antes de cifrar), para mostrarlo en la UI.
  sizeBytes      Int
  blobUrl        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([messageId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Facturación Electrónica (DTE) — autorización de folios del SII
// ═══════════════════════════════════════════════════════════════════════════

/// Estado de un archivo CAF dentro de su ciclo de vida.
enum CafStatus {
  /// Tiene folios disponibles y puede timbrar documentos.
  ACTIVE
  /// Se asignó el último folio del rango. No se borra: los documentos ya
  /// emitidos con él siguen necesitando su bloque para revalidarse.
  EXHAUSTED
  /// Marcado a mano cuando el SII anula el rango (robo, error de solicitud).
  REVOKED
}

/// Resultado del envío de un DTE al SII.
enum SiiSubmissionStatus {
  /// Documento emitido y timbrado, todavía no enviado al SII.
  PENDING
  /// Enviado; el SII entregó un Track ID y aún no responde el resultado.
  SENT
  ACCEPTED
  /// Aceptado con reparos: es válido, pero el SII observó algo.
  ACCEPTED_WITH_OBJECTIONS
  REJECTED
}

/// Código de Autorización de Folios entregado por el SII.
///
/// Autoriza un RANGO de folios para UN tipo de documento y contiene la llave
/// privada RSA con la que se firma el timbre (TED) de cada documento de ese
/// rango. Sin un CAF vigente no existe emisión legalmente válida: el folio no
/// es un contador interno, es un número que el SII entregó de antemano.
model DteCaf {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dteType DteType
  /// Código numérico del SII (33, 39, 61…), redundante con `dteType` a
  /// propósito: es el valor que viaja al SII y evita traducir en cada consulta.
  siiCode Int

  rangeFrom         Int
  rangeTo           Int
  /// Folio más alto ya asignado de este rango. 0 = ninguno usado todavía.
  /// Es el cursor real de emisión; se avanza con lock de fila.
  lastAssignedFolio Int @default(0)

  authorizedAt DateTime
  status       CafStatus @default(ACTIVE)

  /// XML completo del CAF, cifrado en reposo con AES-256-GCM. Va cifrado
  /// porque contiene la llave privada que timbra los documentos: quien la
  /// obtiene puede emitir documentos a nombre de la empresa.
  encryptedXml String

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  salesDocuments SalesDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// El SII nunca entrega dos rangos iguales para el mismo tipo y emisor;
  /// esto convierte un doble-subida del mismo archivo en un error explícito.
  @@unique([companyId, dteType, rangeFrom])
  /// Cubre la búsqueda del CAF vigente al momento de emitir.
  @@index([companyId, dteType, status])
}

// ============================================================================
// Motor de automatizaciones ("Flujos de trabajo")
// ============================================================================
// Reglas definidas por la propia empresa (sin tocar código): un disparador de
// negocio ya existente + condiciones simples + una o más acciones. Es
// deliberadamente acotado en superficie (3 tipos de acción) para no convertirse
// en una forma de mutar datos de negocio sin pasar por las reglas de cada
// módulo — una automatización nunca escribe directo en Sales/Purchases/Stock,
// solo notifica o dispara integraciones externas.

enum WorkflowTriggerEvent {
  /// Documento de venta emitido (Factura, Boleta, Guía, NC, ND). Payload trae
  /// dteType/folio/totalAmount/contactName/paymentMethod.
  SALE_ISSUED
  /// Documento de venta anulado.
  SALE_CANCELLED
  /// Compra que superó `purchaseApprovalThreshold` y quedó esperando aprobación.
  PURCHASE_PENDING_APPROVAL
  /// Producto cuyo stock total cayó a su mínimo configurado o por debajo
  /// (mismo criterio que la alerta operativa diaria).
  STOCK_BELOW_MINIMUM
  /// Documento de venta a crédito vencido y todavía impago.
  RECEIVABLE_OVERDUE
  /// Rango de folios del SII con pocos folios libres.
  DTE_FOLIOS_LOW
  /// Nueva postulación recibida en el formulario público de candidatas.
  CANDIDATE_REGISTERED
  /// Orden de compra de entradas confirmada como pagada.
  TICKET_PURCHASE_CONFIRMED
  /// Orden de votos confirmada como pagada.
  VOTE_ORDER_PAID
  /// Contrato de auspicio firmado (ZapSign u otro proveedor de firma).
  SPONSORSHIP_SIGNED
  /// Oportunidad del CRM marcada como ganada.
  OPPORTUNITY_WON
  /// Rendición de gastos enviada a aprobación.
  EXPENSE_REPORT_SUBMITTED
  /// Solicitud de vacaciones o permiso registrada.
  LEAVE_REQUESTED
  /// Período de remuneraciones cerrado.
  PAYROLL_CLOSED
  /// Prospecto recibido por el formulario "Quiero auspiciar" del micrositio
  /// público de un certamen (queda como oportunidad en el CRM).
  CRM_LEAD_RECEIVED
  /// Pago aplicado a cuotas de un plan de pago, en línea (Khipu) o presencial.
  INSTALLMENT_PAID
  /// Pagaré pagado por completo.
  PROMISSORY_NOTE_PAID
  /// Boleta de honorarios marcada como pagada.
  FEE_DOCUMENT_PAID
  /// Turno de caja cerrado con su arqueo (trae la diferencia).
  CASH_SHIFT_CLOSED
  /// Compra pendiente aprobada o rechazada.
  PURCHASE_REVIEWED
  /// Recepción de mercadería registrada contra una orden de compra.
  GOODS_RECEIPT_CREATED
  /// Solicitud de vacaciones o permiso aprobada o rechazada.
  LEAVE_REQUEST_REVIEWED
  /// Lote con saldo que vence en 30, 7 o 0 días, o que ya venció (lo emite
  /// la alerta operativa diaria en esos hitos, no todos los días).
  LOT_EXPIRING
  /// Toma de inventario contabilizada (trae ajustes y su valorización).
  INVENTORY_COUNT_POSTED
  /// Orden de producción terminada (producto ingresado a su costo).
  PRODUCTION_ORDER_COMPLETED
  /// Orden de servicio técnico cambió de estado (listo para retiro, entregado…).
  SERVICE_TICKET_STATUS_CHANGED
  /// El cliente aprobó o rechazó el presupuesto desde su enlace de seguimiento.
  SERVICE_ESTIMATE_DECIDED
}

enum WorkflowActionType {
  SEND_EMAIL
  CREATE_NOTIFICATION
  CALL_WEBHOOK
}

enum WorkflowExecutionStatus {
  /// Todas las acciones de la regla se ejecutaron sin error.
  SUCCESS
  /// Al menos una acción falló, pero al menos una tuvo éxito.
  PARTIAL_FAILURE
  /// Ninguna acción se ejecutó con éxito.
  FAILED
}

/// Mismo vocabulario que ya usa `NotificationItem.severity` en
/// `src/lib/actions/notifications.ts` — una sola fuente de verdad para lo que
/// puede mostrar la campanita, ahora que también hay notificaciones
/// persistidas (antes todas se calculaban al vuelo).
enum WorkflowNotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model WorkflowRule {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?

  trigger WorkflowTriggerEvent

  /// `WorkflowCondition[]` (ver src/lib/workflows/types.ts) evaluadas en AND
  /// contra el payload del evento. Arreglo vacío = se ejecuta siempre que
  /// ocurra el disparador.
  conditions Json @default("[]")

  /// `WorkflowActionConfig[]` ejecutadas en el orden del arreglo. Siempre al
  /// menos una — se valida en el schema Zod, no aquí.
  actions Json

  isActive Boolean @default(true)

  /// Secreto HMAC para las acciones CALL_WEBHOOK de esta regla (header
  /// `X-Aether-Signature`), para que el receptor pueda verificar que la
  /// llamada vino de esta empresa. En texto plano, mismo criterio que
  /// `CompanySettings.n8nWebhookSecret`: es un secreto de integración, no una
  /// llave que pueda forjar documentos tributarios.
  signingSecret String

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  executions    WorkflowExecution[]
  notifications WorkflowNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, trigger, isActive])
}

model WorkflowExecution {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Opcional y `SetNull` a propósito: el historial de ejecuciones es
  /// evidencia de auditoría (qué correo/webhook se disparó y cuándo) y debe
  /// sobrevivir aunque alguien borre la regla que lo generó — a diferencia de
  /// `DteCaf`/`SalesDocument`, acá no hay razón tributaria para exigir que
  /// exista la regla dueña.
  ruleId String?
  rule   WorkflowRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  trigger WorkflowTriggerEvent
  status  WorkflowExecutionStatus

  /// Payload del evento que disparó esta corrida — clave para depurar por qué
  /// una condición hizo o no hizo match.
  eventPayload Json

  /// `Array<{ type, success, detail }>`: resultado de cada acción, en orden.
  actionResults Json

  createdAt DateTime @default(now())

  /// El historial de una regla (más reciente primero) es el patrón de acceso
  /// principal de la UI.
  @@index([companyId, ruleId, createdAt])
}

model WorkflowNotification {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// `SetNull` — la notificación ya entregada sigue siendo válida en la
  /// campanita aunque la regla que la generó se borre después.
  ruleId String?
  rule   WorkflowRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  severity WorkflowNotificationSeverity @default(INFO)
  title    String
  message  String
  href     String?

  readAt DateTime?

  createdAt DateTime @default(now())

  /// La campanita solo pide las no leídas más recientes.
  @@index([companyId, readAt, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM comercial (`hasSalesPipeline`)
// ─────────────────────────────────────────────────────────────────────────────

enum OpportunityStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  TASK
  NOTE
}

/// Negocio en curso. Puede nacer sin `Contact` (un prospecto que todavía no
/// tiene RUT) y vincularse después; `prospectName` cubre ese tramo.
model Opportunity {
  id                    String               @id @default(cuid())
  companyId             String
  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                 String
  contactId             String?
  contact               Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  prospectName          String?
  prospectEmail         String?
  prospectPhone         String?
  /// Monto neto estimado en CLP entero.
  amount                Int                  @default(0)
  /// 0-100. Se sugiere por etapa, pero el vendedor puede ajustarlo.
  probability           Int                  @default(10)
  stage                 OpportunityStage     @default(LEAD)
  source                String?
  expectedCloseDate     DateTime?
  ownerUserId           String?
  owner                 User?                @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  lostReason            String?
  /// Fecha en que entró a la etapa actual: base del "días en etapa" y del
  /// tiempo de ciclo del embudo.
  stageChangedAt        DateTime             @default(now())
  closedAt              DateTime?
  notes                 String?
  activities            CrmActivity[]
  // ── Negocio de una productora de certámenes ──────────────────────────────
  /// Qué se está vendiendo. Default `OTHER` para no reclasificar a ciegas los
  /// negocios cargados antes de este campo.
  dealType              CrmDealType          @default(OTHER)
  priority              CrmPriority          @default(MEDIUM)
  /// Certamen/evento al que apunta el negocio (auspicio de Miss X 2026,
  /// entradas corporativas de la gala…). `SetNull`: cancelar o borrar un
  /// proyecto no borra el historial comercial.
  projectId             String?
  project               Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Solo para `SPONSORSHIP`: plan del tarifario y nivel propuestos.
  packageId             String?
  package               SponsorshipPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  sponsorshipTier       SponsorshipTier?
  /// Parte del negocio que se paga en canje (productos/servicios), valorizada
  /// en CLP entero. `amount` sigue siendo solo lo que entra en efectivo.
  isBarter              Boolean              @default(false)
  barterValuation       Int                  @default(0)
  barterDescription     String?
  tags                  String[]             @default([])
  /// Persona de contacto principal del negocio (gerente de marca, agencia…).
  personId              String?
  person                CrmPerson?           @relation(fields: [personId], references: [id], onDelete: SetNull)
  /// Contrato de auspicio creado al convertir este negocio ganado. Único: un
  /// negocio se convierte una sola vez.
  sponsorshipContractId String?              @unique
  sponsorshipContract   SponsorshipContract? @relation(fields: [sponsorshipContractId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([companyId, stage])
  @@index([companyId, ownerUserId])
  @@index([companyId, contactId])
  @@index([companyId, projectId])
  @@index([companyId, dealType])
  @@index([personId])
  @@index([packageId])
}

/// Qué vende una productora de certámenes y eventos.
enum CrmDealType {
  SPONSORSHIP
  EVENT_PRODUCTION
  CORPORATE_TICKETS
  TALENT_BOOKING
  LICENSING
  MEDIA
  OTHER
}

enum CrmPriority {
  LOW
  MEDIUM
  HIGH
}

/// Persona de contacto comercial (gerente de marketing de una marca, agencia
/// de medios, productor de un evento corporativo). Distinta de `Contact`, que
/// es la EMPRESA con RUT: una marca tiene varias personas y una persona puede
/// existir antes de que su empresa tenga ficha tributaria.
model CrmPerson {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId        String?
  contact          Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  fullName         String
  jobTitle         String?
  /// Empresa escrita a mano cuando todavía no hay `Contact` con RUT.
  organizationName String?
  email            String?
  phone            String?
  instagram        String?
  linkedinUrl      String?
  isDecisionMaker  Boolean       @default(false)
  tags             String[]      @default([])
  notes            String?
  opportunities    Opportunity[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId, contactId])
  @@index([companyId, fullName])
}

model CrmActivity {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          CrmActivityType
  summary       String
  dueAt         DateTime?
  completedAt   DateTime?
  userId        String?
  user          User?           @relation("CrmActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([companyId, opportunityId])
  @@index([companyId, completedAt, dueAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Personas y Remuneraciones (`hasPayroll`)
// ─────────────────────────────────────────────────────────────────────────────

enum EmploymentContractType {
  INDEFINIDO
  PLAZO_FIJO
  POR_OBRA
}

enum HealthInsuranceType {
  FONASA
  ISAPRE
}

enum AfpInstitution {
  CAPITAL
  CUPRUM
  HABITAT
  MODELO
  PLANVITAL
  PROVIDA
  UNO
}

enum GratificationMode {
  /// Art. 50 del Código del Trabajo: 25% de lo devengado, con tope anual de
  /// 4,75 ingresos mínimos (pagado mes a mes).
  ART_50
  NONE
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
}

enum PayrollPeriodStatus {
  DRAFT
  CLOSED
}

enum LeaveType {
  VACATION
  SICK_LEAVE
  PERSONAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Ficha del trabajador dependiente. Los honorarios NO van acá: siguen en
/// `FeeDocument` (no hay relación laboral ni cotizaciones).
model Employee {
  id                   String                 @id @default(cuid())
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rut                  String
  rutClean             String
  fullName             String
  email                String?
  phone                String?
  birthDate            DateTime?
  address              String?
  position             String
  department           String?
  hireDate             DateTime
  terminationDate      DateTime?
  contractType         EmploymentContractType @default(INDEFINIDO)
  /// Jornada ordinaria semanal (Ley 21.561 la baja gradualmente a 40 h).
  weeklyHours          Int                    @default(42)
  /// Sueldo base mensual en CLP entero.
  baseSalary           Int
  gratificationMode    GratificationMode      @default(ART_50)
  /// Asignaciones no imponibles ni tributables (CLP entero).
  mealAllowance        Int                    @default(0)
  transportAllowance   Int                    @default(0)
  afp                  AfpInstitution
  healthInsurance      HealthInsuranceType    @default(FONASA)
  isapreName           String?
  /// Plan de Isapre pactado en UF (ej. 3.25). Solo si `healthInsurance = ISAPRE`.
  isaprePlanUf         Float?
  bankName             String?
  bankAccountType      String?
  bankAccountNumber    String?
  status               EmployeeStatus         @default(ACTIVE)
  notes                String?
  /// Remuneraciones · Ola 4: nacionalidad (la exige el contrato, art. 10 CT).
  nationality          String?
  /// Portal del trabajador: hash SHA-256 del token del enlace personal (el
  /// token en claro solo se muestra una vez al generarlo).
  portalTokenHash      String?                @unique
  portalTokenCreatedAt DateTime?
  payslips             Payslip[]
  leaveRequests        LeaveRequest[]
  loans                EmployeeLoan[]
  advances             EmployeeAdvance[]
  settlements          EmployeeSettlement[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([companyId, rutClean])
  @@index([companyId, status])
}

/// Mes de remuneraciones. Guarda los parámetros previsionales vigentes ESE
/// mes (UF, UTM, topes, tasas) para que una liquidación cerrada se pueda
/// reproducir años después aunque los valores legales hayan cambiado.
model PayrollPeriod {
  id                     String              @id @default(cuid())
  companyId              String
  company                Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year                   Int
  month                  Int
  status                 PayrollPeriodStatus @default(DRAFT)
  ufValue                Float
  utmValue               Int
  minimumWage            Int
  /// Tope imponible AFP/salud en UF.
  taxableCapUf           Float
  /// Tope imponible del seguro de cesantía en UF.
  unemploymentCapUf      Float
  /// Tasas del empleador en basis points (1% = 100).
  sisRateBps             Int
  mutualRateBps          Int
  employerPensionRateBps Int
  /// Comisión de cada AFP en basis points, `{ "HABITAT": 127, ... }`.
  afpCommissionBps       Json
  closedAt               DateTime?
  closedByUserId         String?
  closedBy               User?               @relation("PayrollPeriodClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  payslips               Payslip[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([companyId, year, month])
}

/// Liquidación de sueldo: foto completa del cálculo. Todos los montos son
/// CLP entero y quedan congelados al cerrar el período.
model Payslip {
  id                   String        @id @default(cuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodId             String
  period               PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workedDays           Int           @default(30)
  overtimeHours        Float         @default(0)
  /// Bonos imponibles del mes (producción, metas, etc.).
  bonuses              Int           @default(0)
  /// Anticipos y otros descuentos voluntarios.
  advances             Int           @default(0)
  otherDeductions      Int           @default(0)
  baseSalary           Int
  gratification        Int
  overtimeAmount       Int
  taxableIncome        Int
  mealAllowance        Int
  transportAllowance   Int
  pensionAmount        Int
  healthAmount         Int
  unemploymentEmployee Int
  taxBase              Int
  incomeTax            Int
  totalDeductions      Int
  netPay               Int
  employerSis          Int
  employerUnemployment Int
  employerMutual       Int
  employerPension      Int
  employerCost         Int
  /// Cuotas de préstamos descontadas (se suman a `totalDeductions`).
  loanDeduction        Int           @default(0)
  /// Anticipos y cuotas registrados que se aplicaron, para marcarlos al cerrar:
  /// `{ advances: [{ id, amount }], loans: [{ id, amount }] }`.
  deductionDetail      Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([periodId, employeeId])
  @@index([companyId, periodId])
  @@index([companyId, employeeId])
}

model LeaveRequest {
  id               String      @id @default(cuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             LeaveType
  startDate        DateTime
  endDate          DateTime
  /// Días hábiles (lunes a viernes) del rango, sin contar feriados.
  businessDays     Int
  status           LeaveStatus @default(PENDING)
  reason           String?
  reviewedByUserId String?
  reviewedBy       User?       @relation("LeaveRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([companyId, status])
  @@index([companyId, employeeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Activo fijo (`hasFixedAssets`)
// ─────────────────────────────────────────────────────────────────────────────

enum DepreciationMethod {
  LINEAL
  /// Un tercio de la vida útil normal, en años enteros (art. 31 N°5 bis LIR).
  ACELERADA
  /// Terrenos y bienes que no se deprecian.
  SIN_DEPRECIACION
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

/// La depreciación NO se persiste mes a mes: se calcula determinísticamente
/// desde costo, fecha de inicio y vida útil (`src/lib/assets/depreciation.ts`).
model FixedAsset {
  id                    String                  @id @default(cuid())
  companyId             String
  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  category              String
  description           String?
  location              String?
  responsible           String?
  acquisitionDate       DateTime
  depreciationStartDate DateTime
  /// Costo de adquisición neto (sin IVA recuperable), CLP entero.
  acquisitionCost       Int
  residualValue         Int                     @default(1)
  /// Vida útil NORMAL en meses. La acelerada se deriva de este valor.
  usefulLifeMonths      Int
  method                DepreciationMethod      @default(LINEAL)
  status                FixedAssetStatus        @default(ACTIVE)
  disposalDate          DateTime?
  disposalAmount        Int?
  supplierContactId     String?
  supplier              Contact?                @relation(fields: [supplierContactId], references: [id], onDelete: SetNull)
  invoiceReference      String?
  notes                 String?
  maintenances          FixedAssetMaintenance[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Rendición de gastos (`hasExpenseReports`)
// ─────────────────────────────────────────────────────────────────────────────

enum ExpenseReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

enum ExpenseDocumentType {
  BOLETA
  FACTURA
  TICKET
  SIN_DOCUMENTO
}

model ExpenseReport {
  id                     String              @id @default(cuid())
  companyId              String
  company                Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                  String
  submittedByUserId      String?
  submittedBy            User?               @relation("ExpenseReportSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  status                 ExpenseReportStatus @default(DRAFT)
  /// Centro de costo opcional (módulo `hasEventProjects`).
  projectId              String?
  project                Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  totalAmount            Int                 @default(0)
  submittedAt            DateTime?
  reviewedByUserId       String?
  reviewedBy             User?               @relation("ExpenseReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  reviewNotes            String?
  reimbursedAt           DateTime?
  reimbursementReference String?
  items                  ExpenseItem[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([companyId, status])
  @@index([companyId, submittedByUserId])
}

model ExpenseItem {
  id             String              @id @default(cuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportId       String
  report         ExpenseReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  expenseDate    DateTime
  category       String
  description    String
  documentType   ExpenseDocumentType @default(BOLETA)
  documentNumber String?
  supplierName   String?
  supplierRut    String?
  /// Total pagado, IVA incluido, CLP entero.
  amount         Int
  createdAt      DateTime            @default(now())

  @@index([companyId, reportId])
}

// ============================================================================
// Ventas · Ola 1: notas de venta, listas de precios y comisiones.
// ============================================================================

/// Lista de precios: precio neto por producto, opcionalmente escalonado por
/// cantidad (`minQuantity`). Se asigna a clientes (`Contact.priceListId`) y la
/// usan Ventas y las notas de venta para proponer el precio de cada línea.
model PriceList {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  name        String
  description String?
  isActive    Boolean         @default(true)
  items       PriceListItem[]
  contacts    Contact[]
  salesOrders SalesOrder[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([companyId, name])
}

/// Precio neto de un producto en una lista, desde `minQuantity` unidades.
/// Varias filas del mismo producto con distinto `minQuantity` = precio por
/// volumen.
model PriceListItem {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity Float     @default(1)
  netPrice    Int

  @@unique([priceListId, productId, minQuantity])
  @@index([companyId, productId])
}

/// Estado de una nota de venta. Se deriva de lo facturado (ver
/// `src/modules/sales/orders.ts`), salvo `CANCELLED`, que es explícito.
enum SalesOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Nota de venta (pedido del cliente): el paso entre la cotización y la
/// factura. Reserva stock mientras está abierta y se factura o despacha por
/// partes; cada documento emitido desde ella suma a `quantityInvoiced` /
/// `quantityDispatched` de sus líneas.
model SalesOrder {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  folio          Int
  contactId      String
  contact        Contact          @relation(fields: [contactId], references: [id])
  warehouseId    String
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id])
  sellerId       String?
  seller         User?            @relation("SalesOrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  quoteId        String?
  quote          SalesDocument?   @relation("QuoteToOrder", fields: [quoteId], references: [id], onDelete: SetNull)
  priceListId    String?
  priceList      PriceList?       @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  status         SalesOrderStatus @default(PENDING)
  orderDate      DateTime         @default(now())
  deliveryDate   DateTime?
  paymentMethod  String
  notes          String?
  netAmount      Int              @default(0)
  exemptAmount   Int              @default(0)
  ivaAmount      Int              @default(0)
  totalAmount    Int              @default(0)
  cancelReason   String?
  items          SalesOrderItem[]
  salesDocuments SalesDocument[]
  serviceTickets ServiceTicket[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([companyId, folio])
  @@index([companyId, status])
  @@index([companyId, contactId])
}

model SalesOrderItem {
  id                 String              @id @default(cuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  orderId            String
  order              SalesOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?            @relation(fields: [productId], references: [id])
  sku                String?
  description        String
  quantity           Float
  unitPrice          Int
  discountPercent    Float               @default(0)
  isExempt           Boolean             @default(false)
  subtotal           Int                 @default(0)
  /// Cantidad ya facturada (factura/boleta emitida desde la nota).
  quantityInvoiced   Float               @default(0)
  /// Cantidad que ya salió de bodega (guía, o factura que no formaliza una guía).
  quantityDispatched Float               @default(0)
  documentItems      SalesDocumentItem[]

  @@index([companyId, orderId])
  @@index([companyId, productId])
}

/// Base de cálculo de la comisión: lo facturado en el mes o lo efectivamente
/// cobrado en el mes.
enum CommissionBasis {
  ISSUED
  COLLECTED
}

/// Comisión de un vendedor, en puntos base sobre la venta neta (250 = 2,5%).
model SalesCommissionRate {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rateBps   Int
  basis     CommissionBasis @default(ISSUED)
  updatedAt DateTime        @updatedAt

  @@unique([companyId, userId])
}

// ============================================================================
// Inventario · Ola 2: empaques, lotes con vencimiento y toma de inventario.
// ============================================================================

/// Empaque de compra o venta de un producto ("Caja x12"): `factor` unidades
/// base. Escanear su código de barras agrega `factor` unidades del producto.
model ProductPackaging {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  factor    Float
  barcode   String?
  createdAt DateTime @default(now())

  @@unique([companyId, barcode])
  @@index([companyId, productId])
}

/// Saldo de un lote de un producto en una bodega. La suma de los lotes de un
/// producto con `tracksLots` sigue a `Stock.quantity`; lo que entró sin lote
/// (compras previas, devoluciones) queda en el lote "SIN-LOTE".
model InventoryLot {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  lotNumber   String
  expiryDate  DateTime?
  quantity    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, productId, warehouseId, lotNumber])
  @@index([companyId, expiryDate])
}

enum InventoryCountStatus {
  OPEN
  POSTED
  CANCELLED
}

/// Toma de inventario (conteo físico) de una bodega. Al contabilizarla, cada
/// diferencia entre lo contado y el stock del momento se ajusta al PMP
/// vigente, con su asiento contra `DIFERENCIA_INVENTARIO`.
model InventoryCount {
  id          String               @id @default(cuid())
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id])
  folio       Int
  warehouseId String
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])
  categoryId  String?
  status      InventoryCountStatus @default(OPEN)
  notes       String?
  createdById String?
  postedAt    DateTime?
  postedById  String?
  lines       InventoryCountLine[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([companyId, folio])
  @@index([companyId, status])
}

model InventoryCountLine {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  countId         String
  count           InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  /// Stock del sistema al abrir el conteo (referencia para quien cuenta).
  systemQuantity  Float
  /// Lo contado. `null` = aún no contado (no se ajusta).
  countedQuantity Float?
  /// Al contabilizar: stock del momento, ajuste aplicado y su costo unitario.
  stockAtPosting  Float?
  adjustment      Float?
  unitCost        Float?

  @@unique([countId, productId])
  @@index([companyId, countId])
}

// ─── Tesorería · Ola 3: bancos, cartolas, conciliación, cheques, nóminas y cobranza ───

/// Cuenta bancaria propia de la empresa.
model BankAccount {
  id             String              @id @default(cuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id])
  name           String
  /// Código de banco (CMF), ej. "012" BancoEstado.
  bankCode       String
  accountType    String
  accountNumber  String
  /// Saldo inicial (CLP) a la fecha desde la que se concilia.
  openingBalance Int                 @default(0)
  openingDate    DateTime?
  isDefault      Boolean             @default(false)
  isActive       Boolean             @default(true)
  statements     BankStatement[]
  lines          BankStatementLine[]
  payments       Payment[]
  cheques        Cheque[]
  paymentBatches PaymentBatch[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([companyId, bankCode, accountNumber])
  @@index([companyId, isActive])
}

/// Una cartola importada (archivo del banco).
model BankStatement {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  bankAccountId String
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id])
  fileName      String
  periodStart   DateTime?
  periodEnd     DateTime?
  importedLines Int                 @default(0)
  skippedLines  Int                 @default(0)
  importedById  String?
  lines         BankStatementLine[]
  createdAt     DateTime            @default(now())

  @@index([companyId, bankAccountId])
}

enum BankLineStatus {
  UNMATCHED
  MATCHED
  /// Sin contrapartida en libros por decisión del usuario (comisión, interés...).
  IGNORED
}

/// Movimiento de una cartola. `amount` con signo: + abono, − cargo.
model BankStatementLine {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  bankAccountId String
  bankAccount   BankAccount    @relation(fields: [bankAccountId], references: [id])
  statementId   String
  statement     BankStatement  @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date          DateTime
  description   String
  reference     String?
  amount        Int
  balance       Int?
  /// Huella para no duplicar movimientos al reimportar cartolas que se traslapan.
  fingerprint   String
  status        BankLineStatus @default(UNMATCHED)
  ignoredReason String?
  matchedAt     DateTime?
  matchedById   String?
  payments      Payment[]
  createdAt     DateTime       @default(now())

  @@unique([bankAccountId, fingerprint])
  @@index([companyId, bankAccountId, status, date])
  /// "BankStatementLine" ya existe en la base compartida (rama no fusionada
  /// `feat/erp-integracion-total`, otra estructura): esta tabla usa otro nombre.
  @@map("BankLine")
}

enum ChequeDirection {
  RECEIVED
  ISSUED
}

enum ChequeStatus {
  /// Recibido: en cartera. Girado: entregado, aún no cobrado.
  PORTFOLIO
  DEPOSITED
  CLEARED
  BOUNCED
  VOIDED
}

/// Cheque recibido de un cliente o girado a un proveedor.
model Cheque {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  direction     ChequeDirection
  number        String
  bankCode      String
  drawerName    String?
  drawerRut     String?
  contactId     String?
  contact       Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  amount        Int
  issueDate     DateTime
  /// Fecha desde la que se puede cobrar (cheque a fecha).
  dueDate       DateTime
  status        ChequeStatus    @default(PORTFOLIO)
  /// Cobro/pago de tesorería que registró el cheque (si salda un documento).
  paymentId     String?         @unique
  payment       Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  bankAccountId String?
  bankAccount   BankAccount?    @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  depositedAt   DateTime?
  clearedAt     DateTime?
  bouncedAt     DateTime?
  bounceReason  String?
  notes         String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([companyId, direction, status, dueDate])
}

enum PaymentBatchStatus {
  DRAFT
  PAID
  CANCELLED
}

/// Nómina de pago a proveedores: se exporta al banco y, al confirmarse,
/// registra el pago de cada factura.
model PaymentBatch {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])
  folio         Int
  bankAccountId String
  bankAccount   BankAccount        @relation(fields: [bankAccountId], references: [id])
  paymentDate   DateTime
  status        PaymentBatchStatus @default(DRAFT)
  totalAmount   Int                @default(0)
  notes         String?
  createdById   String?
  paidAt        DateTime?
  paidById      String?
  items         PaymentBatchItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([companyId, folio])
  @@index([companyId, status])
}

model PaymentBatchItem {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  batchId            String
  batch              PaymentBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  purchaseDocumentId String
  purchaseDocument   PurchaseDocument @relation(fields: [purchaseDocumentId], references: [id])
  contactId          String
  contact            Contact          @relation(fields: [contactId], references: [id])
  amount             Int
  /// Pago de tesorería generado al confirmar la nómina.
  paymentId          String?          @unique
  payment            Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([batchId, purchaseDocumentId])
  @@index([companyId, batchId])
}

/// Recordatorio automático de cobranza ya enviado (uno por documento e hito).
model CollectionReminderLog {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  salesDocumentId String
  salesDocument   SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact       @relation(fields: [contactId], references: [id])
  /// Hito en días respecto del vencimiento (negativo = antes de vencer).
  stage           Int
  sentTo          String
  deliveryStatus  String
  sentAt          DateTime      @default(now())

  @@unique([salesDocumentId, stage])
  @@index([companyId, sentAt])
}

enum CollectionNoteKind {
  CALL
  EMAIL
  VISIT
  WHATSAPP
  PROMISE
  NOTE
}

/// Gestión de cobranza registrada por el equipo (llamado, visita, promesa de pago).
model CollectionNote {
  id              String             @id @default(cuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id])
  contactId       String
  contact         Contact            @relation(fields: [contactId], references: [id])
  salesDocumentId String?
  salesDocument   SalesDocument?     @relation(fields: [salesDocumentId], references: [id], onDelete: SetNull)
  kind            CollectionNoteKind
  note            String
  promiseDate     DateTime?
  promiseAmount   Int?
  createdById     String?
  createdByName   String?
  createdAt       DateTime           @default(now())

  @@index([companyId, contactId, createdAt])
}

// ─── Remuneraciones · Ola 4: préstamos, anticipos y finiquitos ───────────────

enum EmployeeLoanStatus {
  ACTIVE
  PAID
  CANCELLED
}

/// Préstamo de la empresa al trabajador, descontado en cuotas de la liquidación.
model EmployeeLoan {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  description       String
  principal         Int
  installments      Int
  installmentAmount Int
  /// Primer mes en que se descuenta.
  startYear         Int
  startMonth        Int
  paidInstallments  Int                @default(0)
  status            EmployeeLoanStatus @default(ACTIVE)
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([companyId, employeeId, status])
}

enum EmployeeAdvanceStatus {
  PENDING
  DEDUCTED
  CANCELLED
}

/// Anticipo de sueldo (ej. quincena): se descuenta en la liquidación del mes indicado.
model EmployeeAdvance {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount      Int
  paidDate    DateTime
  year        Int
  month       Int
  status      EmployeeAdvanceStatus @default(PENDING)
  notes       String?
  createdById String?
  createdAt   DateTime              @default(now())

  @@index([companyId, year, month, status])
  @@index([companyId, employeeId])
}

enum SettlementStatus {
  DRAFT
  FINAL
  CANCELLED
}

/// Finiquito: cálculo de lo que se paga al término de la relación laboral.
model EmployeeSettlement {
  id                   String           @id @default(cuid())
  companyId            String
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  terminationDate      DateTime
  /// Causal legal (ej. `ART_161_1` necesidades de la empresa).
  cause                String
  noticeGiven          Boolean          @default(true)
  monthlySalary        Int
  yearsOfService       Int              @default(0)
  severanceAmount      Int              @default(0)
  noticeIndemnity      Int              @default(0)
  vacationBusinessDays Float            @default(0)
  vacationCalendarDays Float            @default(0)
  vacationAmount       Int              @default(0)
  pendingSalary        Int              @default(0)
  otherEarnings        Int              @default(0)
  loanBalance          Int              @default(0)
  otherDeductions      Int              @default(0)
  totalAmount          Int              @default(0)
  notes                String?
  status               SettlementStatus @default(DRAFT)
  createdById          String?
  finalizedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([companyId, employeeId])
}

// ─── SII · Ola 5: bandeja de DTE recibidos y Registro de Compras y Ventas ────

enum ReceivedDteStatus {
  /// Recién cargado: nadie lo revisó todavía.
  PENDING
  /// Aceptado en su contenido (acuse de recibo interno).
  ACCEPTED
  /// Reclamado: el contenido no corresponde (Ley 19.983, 8 días).
  CLAIMED
  /// Ya se registró como documento de compra en el ERP.
  REGISTERED
}

/// DTE emitido por un proveedor a esta empresa, cargado desde su XML
/// (`EnvioDTE` o `DTE` suelto). `xml` guarda el bloque `<DTE>` tal como
/// llegó, byte a byte: el timbre del proveedor se calculó sobre esos bytes y
/// reserializarlo lo invalidaría.
model ReceivedDte {
  id                 String            @id @default(cuid())
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  issuerRut          String
  issuerName         String
  issuerGiro         String?
  siiCode            Int
  folio              Int
  issueDate          DateTime
  dueDate            DateTime?
  netAmount          Int               @default(0)
  exemptAmount       Int               @default(0)
  ivaAmount          Int               @default(0)
  totalAmount        Int               @default(0)
  /// Líneas de detalle normalizadas (nombre, cantidad, precio, exenta).
  lines              Json
  /// Referencias del documento (notas de crédito/débito, OC, guías).
  references         Json?
  xml                String
  /// `VALID` timbre íntegro, `INVALID` no cuadra, `MISSING` sin TED.
  tedStatus          String
  status             ReceivedDteStatus @default(PENDING)
  statusNote         String?
  statusAt           DateTime?
  statusById         String?
  purchaseDocumentId String?
  purchaseDocument   PurchaseDocument? @relation(fields: [purchaseDocumentId], references: [id], onDelete: SetNull)
  fileName           String?
  receivedAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([companyId, issuerRut, siiCode, folio])
  @@index([companyId, status, receivedAt])
}

enum RcvKind {
  PURCHASES
  SALES
}

/// Archivo del Registro de Compras y Ventas descargado desde el SII para un
/// período. Se guarda normalizado (`entries`) y se cuadra contra los
/// documentos del ERP al consultarlo; reimportar el mismo mes lo reemplaza.
model RcvImport {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind         RcvKind
  year         Int
  month        Int
  fileName     String
  rowCount     Int
  entries      Json
  importedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, kind, year, month])
}

// ─── Operaciones · Ola 6: solicitudes de compra, cotizaciones e importaciones ─

enum PurchaseRequestStatus {
  DRAFT
  /// Enviada a aprobación.
  SUBMITTED
  APPROVED
  REJECTED
  /// Ya generó sus órdenes de compra.
  ORDERED
  CANCELLED
}

/// Solicitud interna de compra: alguien pide, jefatura aprueba, compras
/// cotiza con varios proveedores y el comparativo genera las OC.
model PurchaseRequest {
  id              String                @id @default(cuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folio           Int
  title           String
  status          PurchaseRequestStatus @default(DRAFT)
  neededBy        DateTime?
  notes           String?
  requestedById   String?
  requestedByName String?
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  rejectionReason String?
  items           PurchaseRequestItem[]
  quotes          SupplierQuote[]
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([companyId, folio])
  @@index([companyId, status])
}

model PurchaseRequestItem {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestId         String
  request           PurchaseRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  description       String
  quantity          Float
  unit              String?
  /// Costo unitario de referencia (último PMP o estimado), CLP.
  estimatedUnitCost Int?
  position          Int                 @default(0)
  quoteLines        SupplierQuoteLine[]

  @@index([companyId, requestId])
}

/// Cotización de un proveedor para una solicitud.
model SupplierQuote {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestId    String
  request      PurchaseRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact             @relation(fields: [contactId], references: [id])
  quoteNumber  String?
  validUntil   DateTime?
  leadTimeDays Int?
  paymentTerms String?
  notes        String?
  lines        SupplierQuoteLine[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([requestId, contactId])
  @@index([companyId, requestId])
}

model SupplierQuoteLine {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteId       String
  quote         SupplierQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requestItemId String
  requestItem   PurchaseRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  /// Precio unitario neto ofrecido, CLP.
  unitCost      Int

  @@unique([quoteId, requestItemId])
  @@index([companyId, quoteId])
}

enum ImportShipmentStatus {
  OPEN
  /// Mercadería ingresada a bodega al costo de importación.
  CLOSED
  CANCELLED
}

/// Carpeta de importación: reúne el valor FOB de la mercadería y todos los
/// costos hasta la bodega (flete, seguro, derechos, agente, puerto) para
/// ingresarla al kardex a su costo real.
model ImportShipment {
  id               String               @id @default(cuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folio            Int
  reference        String
  contactId        String?
  contact          Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  currency         String               @default("USD")
  /// Pesos por unidad de moneda extranjera (dólar observado o el de la DIN).
  exchangeRate     Float
  incoterm         String?
  dinNumber        String?
  arrivalDate      DateTime?
  warehouseId      String?
  warehouse        Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  /// `VALUE` prorratea por valor FOB, `QUANTITY` por unidades.
  allocationMethod String               @default("VALUE")
  status           ImportShipmentStatus @default(OPEN)
  closedAt         DateTime?
  closedById       String?
  notes            String?
  items            ImportShipmentItem[]
  costs            ImportShipmentCost[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([companyId, folio])
  @@index([companyId, status])
}

model ImportShipmentItem {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipmentId       String
  shipment         ImportShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  description      String
  quantity         Float
  /// Precio unitario FOB en la moneda de la carpeta.
  unitPriceForeign Float
  /// Costo unitario puesto en bodega (CLP, 2 decimales), fijado al cerrar.
  landedUnitCost   Float?
  position         Int            @default(0)

  @@index([companyId, shipmentId])
}

model ImportShipmentCost {
  id                 String            @id @default(cuid())
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipmentId         String
  shipment           ImportShipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// FREIGHT, INSURANCE, DUTY, CUSTOMS_AGENT, PORT, TRANSPORT, OTHER
  kind               String
  description        String
  /// Monto neto en CLP (sin IVA recuperable).
  amount             Int
  /// Factura de Compras que respalda el costo, si ya se registró.
  purchaseDocumentId String?
  purchaseDocument   PurchaseDocument? @relation(fields: [purchaseDocumentId], references: [id], onDelete: SetNull)

  @@index([companyId, shipmentId])
}

// ─── Operaciones · Ola 6: producción y servicio técnico ──────────────────────

/// Receta o lista de materiales: qué componentes y en qué cantidad se
/// consumen para fabricar `outputQuantity` unidades del producto terminado.
model BillOfMaterials {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation("BomOutput", fields: [productId], references: [id])
  name             String
  outputQuantity   Float             @default(1)
  notes            String?
  isActive         Boolean           @default(true)
  components       BomComponent[]
  productionOrders ProductionOrder[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([companyId, productId])
}

model BomComponent {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bomId     String
  bom       BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  /// Cantidad por `outputQuantity` unidades producidas.
  quantity  Float
  position  Int             @default(0)

  @@index([companyId, bomId])
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  /// Componentes consumidos y producto terminado ingresado a bodega.
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id                 String                     @id @default(cuid())
  companyId          String
  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folio              Int
  bomId              String?
  bom                BillOfMaterials?           @relation(fields: [bomId], references: [id], onDelete: SetNull)
  productId          String
  product            Product                    @relation("ProductionOutput", fields: [productId], references: [id])
  quantity           Float
  warehouseId        String
  warehouse          Warehouse                  @relation(fields: [warehouseId], references: [id])
  status             ProductionOrderStatus      @default(PLANNED)
  plannedDate        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  completedById      String?
  /// Mano de obra y gastos de fabricación que se suman al costo, CLP.
  additionalCost     Int                        @default(0)
  additionalCostNote String?
  /// Costo total y unitario resultantes al completar.
  totalCost          Int?
  unitCost           Float?
  notes              String?
  components         ProductionOrderComponent[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([companyId, folio])
  @@index([companyId, status])
}

model ProductionOrderComponent {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId          String
  order            ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  plannedQuantity  Float
  consumedQuantity Float?
  /// Costo de lo consumido (PMP al momento de consumir).
  totalCost        Int?
  position         Int             @default(0)

  @@index([companyId, orderId])
}

enum ServiceTicketStatus {
  RECEIVED
  DIAGNOSING
  WAITING_APPROVAL
  APPROVED
  IN_REPAIR
  READY
  DELIVERED
  CANCELLED
}

/// Orden de servicio técnico: equipo que un cliente deja para diagnóstico y
/// reparación. `trackingToken` es la llave del enlace de seguimiento que se
/// entrega al cliente (sin cuenta).
model ServiceTicket {
  id                String               @id @default(cuid())
  companyId         String
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folio             Int
  contactId         String
  contact           Contact              @relation(fields: [contactId], references: [id])
  equipment         String
  brand             String?
  model             String?
  serialNumber      String?
  accessories       String?
  reportedIssue     String
  diagnosis         String?
  /// LOW, NORMAL, HIGH
  priority          String               @default("NORMAL")
  status            ServiceTicketStatus  @default(RECEIVED)
  technicianId      String?
  technician        User?                @relation("ServiceTicketTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  promisedDate      DateTime?
  warranty          Boolean              @default(false)
  /// Decisión del cliente sobre el presupuesto: APPROVED o REJECTED.
  estimateDecision  String?
  estimateDecidedAt DateTime?
  /// STAFF o CUSTOMER (desde el enlace de seguimiento).
  estimateDecidedBy String?
  deliveredAt       DateTime?
  salesOrderId      String?
  salesOrder        SalesOrder?          @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  trackingToken     String               @unique
  receivedByName    String?
  notes             String?
  lines             ServiceTicketLine[]
  events            ServiceTicketEvent[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([companyId, folio])
  @@index([companyId, status])
}

model ServiceTicketLine {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticketId    String
  ticket      ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// PART (repuesto) o LABOR (mano de obra)
  kind        String
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Float
  /// Precio unitario neto, CLP.
  unitPrice   Int
  position    Int           @default(0)

  @@index([companyId, ticketId])
}

model ServiceTicketEvent {
  id                String               @id @default(cuid())
  companyId         String
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticketId          String
  ticket            ServiceTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status            ServiceTicketStatus?
  note              String?
  visibleToCustomer Boolean              @default(true)
  createdByName     String?
  createdAt         DateTime             @default(now())

  @@index([companyId, ticketId, createdAt])
}

// ─── Activo fijo · Ola 6: bitácora de mantenciones ───────────────────────────

/// Mantención de un bien del activo fijo (preventiva, correctiva o
/// inspección) con su costo y la próxima fecha programada.
model FixedAssetMaintenance {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetId       String
  asset         FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date          DateTime
  /// PREVENTIVE, CORRECTIVE o INSPECTION
  kind          String
  description   String
  /// Costo neto de la mantención, CLP (gasto del período, no aumenta el valor del bien).
  cost          Int        @default(0)
  provider      String?
  nextDueDate   DateTime?
  createdByName String?
  createdAt     DateTime   @default(now())

  @@index([companyId, assetId, date])
  @@index([companyId, nextDueDate])
}
