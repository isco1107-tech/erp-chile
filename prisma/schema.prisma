model User {
  id                               String                    @id @default(cuid())
  /// Ventas y notas de venta atribuidas a este vendedor (comisiones).
  soldSalesDocuments               SalesDocument[]           @relation("SalesDocumentSeller")
  soldSalesOrders                  SalesOrder[]              @relation("SalesOrderSeller")
  salesCommissionRates             SalesCommissionRate[]
  email                            String                    @unique
  passwordHash                     String
  name                             String
  /// Teléfono personal (con código de país, ej. +56912345678). Editable solo
  /// por el propio usuario desde "Mi Perfil" — sirve para el botón de WhatsApp
  /// que ve el dueño/administrador en el directorio de equipo.
  phone                            String?
  role                             Role                      @default(SALES)
  companyId                        String?
  company                          Company?                  @relation(fields: [companyId], references: [id])
  /// Rol personalizado de la empresa. Cuando está presente, su lista de permisos
  /// reemplaza a la matriz del rol base (salvo para OWNER, que nunca se limita).
  customRoleId                     String?
  customRole                       CustomRole?               @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  /// Foto de perfil (Vercel Blob) para el organigrama (módulo `hasOrgChart`).
  /// Estrictamente autoservicio: solo el propio usuario la sube, ver
  /// src/app/api/org-chart/photo-upload/route.ts.
  photoUrl                         String?
  /// Cargo elegido de `JobPosition` (catálogo por empresa). `SetNull`: mismo
  /// criterio que `customRoleId` — borrar un cargo del catálogo no debe dejar
  /// una FK huérfana, es metadata menor, no pérdida de estructura.
  jobPositionId                    String?
  jobPosition                      JobPosition?              @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  /// Jefe directo en el organigrama. `Restrict` a propósito, a diferencia de
  /// `customRoleId`: es una relación ESTRUCTURAL activa (como `Account.parentId`
  /// en el plan de cuentas), no un dato de atribución histórica — borrar a
  /// alguien no debe desprender en silencio a sus reportes del árbol.
  /// `deleteUser` bloquea explícitamente si `managerId` de otros lo referencia
  /// (ver src/lib/services/users.service.ts); la baja cotidiana es desactivar
  /// la cuenta (`isActive`), que no toca esta FK.
  managerId                        String?
  manager                          User?                     @relation("OrgChartHierarchy", fields: [managerId], references: [id], onDelete: Restrict)
  reports                          User[]                    @relation("OrgChartHierarchy")
  /// Bandera global de plataforma: acceso al portal /superadmin. No pertenece a
  /// ninguna empresa y no se puede otorgar desde el panel del cliente.
  isSuperAdmin                     Boolean                   @default(false)
  isActive                         Boolean                   @default(true)
  sessionVersion                   Int                       @default(0)
  /// Fuerza el flujo de "nueva contraseña" en el próximo login. Se activa al
  /// crear una cuenta con contraseña temporal generada por un administrador;
  /// se apaga al completar el cambio, nunca por otra vía.
  mustChangePassword               Boolean                   @default(false)
  /// Secreto TOTP cifrado en reposo (AES-256-GCM, ver src/lib/auth/totp-crypto.ts)
  /// — nunca en texto plano en la base. `null` mientras 2FA no está configurado
  /// o mientras el usuario está a mitad del flujo de activación.
  totpSecret                       String?
  /// Recién en `true` cuando el usuario confirma el primer código válido al
  /// activar — así nunca queda "medio activado" con un secreto sin verificar
  /// que le bloquearía su propio acceso.
  totpEnabled                      Boolean                   @default(false)
  /// Intentos fallidos consecutivos de código TOTP/respaldo en el segundo
  /// paso del login. Se resetea a 0 en cualquier intento exitoso; al llegar
  /// al umbral (ver verify-totp/route.ts) se bloquea temporalmente en vez de
  /// seguir aceptando intentos — sin esto, un código de 6 dígitos es
  /// fuerza-bruteable dentro de la ventana de 5 minutos del challenge token.
  totpFailedAttempts               Int                       @default(0)
  totpLockedUntil                  DateTime?
  totpBackupCodes                  TotpBackupCode[]
  /// Intentos fallidos consecutivos de contraseña en el primer paso del login
  /// (antes de llegar siquiera al TOTP). Mismo mecanismo que `totpFailedAttempts`:
  /// sin esto, la contraseña es fuerza-bruteable sin límite — solo el costo de
  /// bcrypt(12) frena a un atacante, y eso no alcanza contra intentos paralelos.
  failedLoginAttempts              Int                       @default(0)
  loginLockedUntil                 DateTime?
  createdAt                        DateTime                  @default(now())
  auditLogs                        AuditLog[]
  cashShifts                       CashShift[]
  passwordResetTokens              PasswordResetToken[]
  closedAccountingPeriods          AccountingPeriod[]
  createdJournalEntries            JournalEntry[]
  approvedPurchaseDocuments        PurchaseDocument[]        @relation("PurchaseApprovals")
  matchOverriddenPurchaseDocuments PurchaseDocument[]        @relation("PurchaseMatchOverrides")
  sessions                         UserSession[]
  assignedServiceTickets           ServiceTicket[]           @relation("ServiceTicketTechnician")
  /// Empresas ADICIONALES a `companyId` (la "hogar") que este usuario puede
  /// activar sin iniciar sesión de nuevo — ver `CompanyMembership` y
  /// `src/lib/auth/actions/switch-company.actions.ts`.
  companyMemberships               CompanyMembership[]
  /// Mensajería interna — ver sección "Mensajería interna" al final del schema.
  sentMessages                     Message[]
  conversationParticipations       ConversationParticipant[]
  createdConversations             Conversation[]            @relation("MessagingConversationCreator")
  uploadedMessageAttachments       MessageAttachment[]
  /// CAF que este usuario cargó — queda trazado quién habilitó cada rango de
  /// folios, que es una acción tributariamente sensible.
  uploadedDteCafs                  DteCaf[]
  createdWorkflowRules             WorkflowRule[]
  cashMovements                    CashMovement[]
  approvedAgentTasks               AgentTask[]
  ownedOpportunities               Opportunity[]             @relation("OpportunityOwner")
  crmActivities                    CrmActivity[]             @relation("CrmActivityUser")
  closedPayrollPeriods             PayrollPeriod[]           @relation("PayrollPeriodClosedBy")
  reviewedLeaveRequests            LeaveRequest[]            @relation("LeaveRequestReviewer")
  submittedExpenseReports          ExpenseReport[]           @relation("ExpenseReportSubmitter")
  reviewedExpenseReports           ExpenseReport[]           @relation("ExpenseReportReviewer")

  @@index([companyId])
  @@index([customRoleId])
  @@index([jobPositionId])
  @@index([managerId])
}

/// Sesión de inicio de sesión, para la pantalla "Dispositivos activos". El
/// sistema de autenticación es JWT sin estado por diseño; esto NO reemplaza
/// eso, es un registro paralelo — cada login/aceptar-invitación/cambio de
/// contraseña crea una fila acá además de emitir el token, y cada request
/// verifica que su fila siga sin `revokedAt` (ver `getAuthContext`).
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// SHA-256 del JWT, nunca el token en claro — mismo principio que
  /// `PasswordResetToken.tokenHash`.
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime

  @@index([userId, revokedAt])
  @@index([companyId])
}

/// Token de recuperación de contraseña.
///
/// Se guarda el HASH del token, nunca el token en claro: quien acceda a una
/// copia de la base no debe poder tomar el control de ninguna cuenta. El valor
/// original solo existe dentro del correo que recibe el usuario.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 del token enviado por correo.
  tokenHash String    @unique
  expiresAt DateTime
  /// Marca de un solo uso: una vez canjeado el enlace deja de servir.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Código de respaldo de un solo uso para 2FA/TOTP (recuperar el acceso si se
/// pierde el dispositivo). Hasheado con bcrypt igual que `passwordHash` —
/// nunca en texto plano. Tabla relacionada en vez de array embebido en
/// `User` para que "consumir" un código sea un solo `UPDATE ... WHERE
/// usedAt IS NULL` atómico, sin condición de carrera entre dos canjes
/// concurrentes del mismo código.
model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

/// Empresa adicional que un usuario puede activar como "empresa actual" sin
/// crear una cuenta separada (ej. la misma dueña administrando "Mi Universo"
/// y su academia). Rol/permiso propios de ESTA empresa, independientes del
/// `role`/`customRoleId` que el usuario tiene en su `User.companyId` hogar —
/// switch-company.actions.ts nunca confía en el rol del JWT, siempre relee
/// esta fila. Requiere que la empresa destino tenga `hasMultiCompany` activo
/// (ver `getEffectiveIdentity` en guards.ts); si no, la membresía queda
/// guardada pero inactiva hasta que el superadmin prenda el módulo.
model CompanyMembership {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role         Role
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Feature flags contratados por cada empresa. Fila 1:1 con Company: si falta,
/// el sistema asume el plan mínimo (ver DEFAULT_FEATURES en src/lib/auth/modules.ts).
model CompanyFeatures {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hasInventory          Boolean  @default(true)
  hasPmpCosting         Boolean  @default(true)
  hasDteBilling         Boolean  @default(false)
  hasPurchases          Boolean  @default(false)
  hasTreasury           Boolean  @default(false)
  hasAdvancedReports    Boolean  @default(false)
  hasMultipleWarehouses Boolean  @default(false)
  hasPos                Boolean  @default(false)
  hasAccounting         Boolean  @default(false)
  /// Módulo nuevo, apagado por defecto: Inteligencia de Negocio (Agentes) —
  /// equipo ejecutivo virtual (CEO/CFO/COO/Ventas) que analiza datos reales
  /// del ERP y propone recomendaciones. El nombre interno del campo
  /// (`hasCrm`) quedó de una iteración anterior del alcance; no se renombró
  /// para no sumar otra migración solo por eso — el label visible en
  /// MODULES/superadmin ya dice "Inteligencia de Negocio (Agentes)". Ninguna
  /// empresa lo tiene activo hasta que el superadmin lo prenda a propósito.
  hasCrm                Boolean  @default(false)
  /// Módulos de producción de certámenes/eventos (franquicias tipo Miss
  /// Universe), todos apagados por defecto — mismo criterio que `hasCrm`:
  /// nadie los recibe activados hasta que el superadmin los prenda a
  /// propósito. Ver src/lib/auth/modules.ts.
  hasEventProjects      Boolean  @default(false)
  hasSponsorships       Boolean  @default(false)
  hasFeeDocuments       Boolean  @default(false)
  hasCandidates         Boolean  @default(false)
  /// Ficha de staff (foto/cargo autoservicio) + jerarquía de reporte +
  /// organigrama visual, con sugerencia de IA editable. Apagado por defecto,
  /// mismo criterio que el resto de módulos nuevos.
  hasOrgChart           Boolean  @default(false)
  /// Escaleta en vivo, asignación de vestuario y acreditación de staff por
  /// certamen. Apagado por defecto, mismo criterio que el resto de módulos
  /// de producción de eventos.
  hasLiveProduction     Boolean  @default(false)
  /// Votación/escrutinio en vivo: categorías, jurados externos por link y
  /// planillas de puntuación con bloqueo anti-edición. Apagado por defecto.
  hasJudging            Boolean  @default(false)
  /// Permite que un usuario administre esta empresa Y otra(s) con el mismo
  /// login, cambiando de "empresa activa" sin volver a iniciar sesión — ver
  /// `CompanyMembership`. Apagado por defecto, mismo criterio que el resto.
  hasMultiCompany       Boolean  @default(false)
  /// Presupuesto operativo general por categoría (arriendo, sueldos, flores,
  /// etc.), independiente del presupuesto por certamen que ya cubre
  /// `Project.budgetedIncome`/`budgetedExpense`. Ver `Budget`/`BudgetLine`.
  hasBudgets            Boolean  @default(false)
  /// Pagarés: documento de deuda con un contacto (o candidata/alumna),
  /// autocontenido (no depende de `hasTreasury`). Ver `PromissoryNote`.
  hasPromissoryNotes    Boolean  @default(false)
  /// Planes de cuotas/mensualidades con vencimientos, multa por atraso y
  /// recordatorio automático por correo. Ver `PaymentPlan`.
  hasInstallmentPlans   Boolean  @default(false)
  /// Venta de entradas a la gala final, con confirmación manual de pago y
  /// QR de acceso. Ver `TicketType`/`TicketSale`.
  hasTicketing          Boolean  @default(false)
  /// Votación pagada del público por su candidata favorita, con confirmación
  /// manual de pago. Ver `VoteOrder`.
  hasPublicVoting       Boolean  @default(false)
  /// Centro de Inteligencia 360: salud de la empresa, ciclo de caja,
  /// proyecciones, RFM/ABC, caja a 13 semanas y flujos de negocio. No crea
  /// datos propios: todo se calcula sobre los documentos reales del tenant.
  hasIntelligence       Boolean  @default(false)
  /// CRM comercial: embudo de oportunidades y actividades de seguimiento.
  /// (`hasCrm` es, por historia, el módulo de Agentes — ver arriba.)
  hasSalesPipeline      Boolean  @default(false)
  /// Personas y Remuneraciones: ficha de trabajadores, liquidaciones con
  /// reglas previsionales chilenas y solicitudes de vacaciones/permisos.
  hasPayroll            Boolean  @default(false)
  /// Activo fijo con depreciación lineal/acelerada.
  hasFixedAssets        Boolean  @default(false)
  /// Rendición de gastos con flujo de aprobación y reembolso.
  hasExpenseReports     Boolean  @default(false)
  /// Producción: recetas (lista de materiales) y órdenes de producción.
  hasProduction         Boolean  @default(false)
  /// Servicio técnico: órdenes de servicio con seguimiento para el cliente.
  hasServiceDesk        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CompanySettings {
  id                         String       @id @default(cuid())
  companyId                  String       @unique
  company                    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industryType               IndustryType @default(COMMERCE)
  allowNegativeStock         Boolean      @default(false)
  ppmRateBasisPoints         Int          @default(100)
  /// Retención de honorarios (2ª categoría) en basis points. Sube ~0.75pp cada
  /// año por cronograma legal (Ley 21.133): 1375 = 13.75% fue el valor de
  /// 2024; el default se actualiza periódicamente, revisar vigencia anual.
  honorariumRetentionBps     Int          @default(1525)
  fiscalYear                 Int          @default(2026)
  /// Cobranza automática: si está activa, el cron diario manda un
  /// recordatorio por documento en cada hito (días respecto del vencimiento;
  /// negativo = antes de vencer).
  collectionRemindersEnabled Boolean      @default(false)
  collectionReminderDays     Int[]        @default([])
  /// Remuneraciones · Ola 4: organismo del seguro de accidentes (Ley 16.744)
  /// de la empresa: `ISL`, `ACHS`, `MUSEG` o `IST`. `null` = ISL.
  payrollMutualCode          String?
  /// Restringe el login (contraseña Y 2FA) a IPs o rangos CIDR configurados.
  /// `false` por defecto: activarlo sin haber agregado la propia IP a la
  /// lista deja a toda la empresa (incluido el Dueño) sin poder entrar.
  ipAllowlistEnabled         Boolean      @default(false)
  /// Cada entrada es una IPv4 exacta ("203.0.113.5") o un rango CIDR
  /// ("203.0.113.0/24"). Ver src/lib/auth/ip-allowlist.ts.
  ipAllowlist                String[]     @default([])
  /// CLP entero. `null` = sin umbral configurado (ninguna compra requiere
  /// aprobación). Compras emitidas por sobre este monto quedan `PENDING` en
  /// vez de emitirse directo — ver `PurchaseDocument.approvalStatus`.
  purchaseApprovalThreshold  Int?
  /// Token único para la suscripción de eventos y cumpleaños en Google Calendar
  calendarSyncToken          String?      @unique
  /// Token único para que una automatización externa (n8n, Zapier, un script
  /// propio) llame `POST /api/webhooks` en nombre de esta empresa —
  /// `Authorization: Bearer <token>`. El token ES la identidad de la empresa
  /// en ese endpoint (mismo patrón que `calendarSyncToken`): el companyId
  /// NUNCA se acepta del payload que manda el cliente, siempre se resuelve
  /// buscando este token. `null` hasta que alguien lo genera desde
  /// Configuración → Empresa.
  n8nWebhookSecret           String?      @unique
  /// Texto libre con los datos de transferencia (banco, tipo de cuenta,
  /// número, titular, RUT) que se muestra al comprador en los flujos públicos
  /// de pago manual (entradas, votación) — no hay pasarela de pago integrada,
  /// así que el comprador transfiere fuera del sistema y el staff confirma.
  bankTransferInfo           String?
  /// Integración con la API del SII para esta empresa. Almacena la
  /// configuración específica del cliente (endpoint, key y secret), sin
  /// compartir la credencial entre empresas.
  siiApiEnabled              Boolean      @default(false)
  siiApiBaseUrl              String?
  siiApiKey                  String?
  siiApiSecret               String?
  /// Ítems del menú lateral que la empresa decidió apagar (ids estables de
  /// `src/lib/navigation/workspace-nav.ts`). Es configuración del espacio de
  /// trabajo, no un control de acceso: los permisos siguen en los guards.
  disabledNavItems           String[]     @default([])
  /// Token del portal público de pago de cuotas (`/pagar/[token]`). Mismo
  /// patrón que `calendarSyncToken`: el token resuelve la empresa, el
  /// visitante nunca manda un `companyId`. `null` hasta que alguien comparte
  /// el portal desde Cuotas & Mensualidades.
  installmentPortalToken     String?      @unique
  /// API key de la cuenta de cobro de Khipu de ESTA empresa, cifrada con
  /// AES-256-GCM (`src/lib/payments/crypto.ts`). Decide a qué cuenta llega el
  /// dinero, por eso solo se edita con `settings:company`. El nombre termina
  /// en "Credential" para que el respaldo lo excluya por patrón.
  khipuApiCredential         String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
}

enum InternalDocumentKind {
  PURCHASE_ORDER
  /// Nota de venta (`SalesOrder.folio`).
  SALES_ORDER
  /// Toma de inventario (`InventoryCount.folio`).
  INVENTORY_COUNT
  /// Nómina de pago a proveedores (`PaymentBatch.folio`).
  PAYMENT_BATCH
  GOODS_RECEIPT
  CANDIDATE_APPLICATION
  /// Comprobante de pago en línea de cuotas (`InstallmentPaymentOrder.receiptNumber`).
  INSTALLMENT_RECEIPT
  /// Solicitud de compra (`PurchaseRequest.folio`).
  PURCHASE_REQUEST
  /// Carpeta de importación (`ImportShipment.folio`).
  IMPORT_SHIPMENT
  /// Orden de producción (`ProductionOrder.folio`).
  PRODUCTION_ORDER
  /// Orden de servicio técnico (`ServiceTicket.folio`).
  SERVICE_TICKET
}

/// Correlativos internos (no folio SII) para documentos sin relevancia
/// tributaria — Orden de Compra, Recepción de Mercadería. Mismo patrón que
/// `FolioSequence` (una fila por contador, no una columna compartida): así
/// crear una OC y confirmar una Recepción no compiten por el lock de la
/// misma fila.
model InternalDocumentSequence {
  id           String               @id @default(cuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind         InternalDocumentKind
  currentFolio Int                  @default(0)

  @@unique([companyId, kind])
}

model TaxPeriod {
  id                        String   @id @default(cuid())
  companyId                 String
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year                      Int
  month                     Int
  debitVat                  Int      @default(0)
  creditVat                 Int      @default(0)
  previousRemanent          Int      @default(0)
  remanentCredit            Int      @default(0)
  ppmAmount                 Int      @default(0)
  determinedTax             Int      @default(0)
  /// Retención de honorarios (2ª categoría) sobre las boletas emitidas en el
  /// período — obligación separada del IVA/PPM, NO se suma a `determinedTax`.
  /// Ver src/lib/chile/f29.ts.
  honorariumRetentionAmount Int      @default(0)
  calculatedAt              DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([companyId, year, month])
  @@index([companyId, year, month])
}

/// Rol a medida creado por el Administrador de la empresa. `permissions` guarda
/// claves de la matriz PERMISSIONS; las claves desconocidas se ignoran al
/// resolver, así que revocar un módulo nunca deja un permiso colgando.
model CustomRole {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String[]
  users       User[]
  invitations Invitation[]
  memberships CompanyMembership[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

/// Catálogo de cargos de la empresa (módulo `hasOrgChart`) — controlado por el
/// admin, no texto libre por persona, para que el organigrama sea consistente
/// (evita "Vendedor" vs "Ejecutivo de Ventas" como cargos distintos para lo
/// mismo). No participa en RBAC (eso lo hace `CustomRole`, que es un
/// contenedor de permisos, no una posición jerárquica) — es puramente
/// descriptivo/organizacional.
model JobPosition {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  /// Metadata visual/orden (ej. "Gerencia", "Jefatura", "Analista") — no
  /// participa en la lógica de reporte, eso lo define `User.managerId`.
  level     String?
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Contact {
  id                        String                  @id @default(cuid())
  companyId                 String
  company                   Company                 @relation(fields: [companyId], references: [id])
  rut                       String
  rutClean                  String
  razonSocial               String
  nombreFantasia            String?
  giro                      String?
  email                     String?
  phone                     String?
  address                   String?
  comuna                    String?
  region                    String?
  isCustomer                Boolean                 @default(true)
  isSupplier                Boolean                 @default(false)
  /// CLP entero. `null` = sin límite configurado (no se bloquean ventas a
  /// crédito para este cliente). Se valida solo al EMITIR una venta con
  /// `paymentMethod: CREDITO_30`: deuda vigente + total del documento nuevo
  /// no puede superar este monto.
  creditLimit               Int?
  /// Días de crédito pactados (0 = contado). Hoy es informativo — sugiere el
  /// vencimiento en el formulario de venta — no es en sí un límite duro.
  creditDays                Int                     @default(0)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  salesDocuments            SalesDocument[]
  salesOrders               SalesOrder[]
  /// Lista de precios que se aplica por defecto a este cliente (Ventas y
  /// notas de venta). `null` = precio base del catálogo.
  priceListId               String?
  priceList                 PriceList?              @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  purchaseDocuments         PurchaseDocument[]
  purchaseOrders            PurchaseOrder[]
  payments                  Payment[]
  journalLinesAsCustomer    JournalLine[]           @relation("JournalLineCustomer")
  journalLinesAsSupplier    JournalLine[]           @relation("JournalLineSupplier")
  sponsorshipContracts      SponsorshipContract[]
  feeDocuments              FeeDocument[]
  promissoryNotes           PromissoryNote[]
  paymentPlans              PaymentPlan[]
  opportunities             Opportunity[]
  fixedAssets               FixedAsset[]
  crmPeople                 CrmPerson[]
  /// Datos bancarios para pagarle (nómina de pago a proveedores).
  bankCode                  String?
  bankAccountType           String?
  bankAccountNumber         String?
  /// Correo al que el banco avisa el pago (si no, `email`).
  paymentNoticeEmail        String?
  /// Excluye al cliente de los recordatorios automáticos de cobranza.
  collectionRemindersPaused Boolean                 @default(false)
  cheques                   Cheque[]
  paymentBatchItems         PaymentBatchItem[]
  collectionReminderLogs    CollectionReminderLog[]
  collectionNotes           CollectionNote[]
  supplierQuotes            SupplierQuote[]
  importShipments           ImportShipment[]
  serviceTickets            ServiceTicket[]
  /// Portal del cliente (`/cliente/[token]`): se guarda solo el hash SHA-256
  /// del enlace; el enlace en claro se muestra una vez al generarlo.
  portalTokenHash           String?                 @unique
  portalTokenCreatedAt      DateTime?

  @@unique([companyId, rutClean])
  @@index([companyId, razonSocial])
}

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER
}

model Category {
