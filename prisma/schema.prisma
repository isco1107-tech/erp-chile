// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTANT
}

/// Estado comercial del tenant. Solo ACTIVE y TRIAL permiten operar; SUSPENDED
/// y CANCELLED cortan el acceso de todos los usuarios de la empresa.
enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum IndustryType {
  SERVICES
  COMMERCE
  DISTRIBUTION
  RETAIL
  LIGHT_MANUFACTURING
}

/// Los 4 roles del motor de agentes de inteligencia de negocio. Es un equipo
/// ejecutivo virtual (CEO/CFO/COO/Ventas) que analiza datos REALES ya
/// existentes en el ERP (ventas, compras, inventario, tesorería) y propone
/// recomendaciones para que el dueño las lea — ninguno hace scraping externo
/// ni gestiona leads/marketing/comunicación con terceros.
enum AgentRole {
  CEO
  CFO
  COO
  SALES
  /// Finanzas de producción: rentabilidad y presupuesto por certamen.
  EVENT_FINANCE
  /// Cobranza de eventos: cuotas de candidatas, pagarés y auspicios.
  EVENT_COLLECTIONS
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Todas las tareas de este módulo son recomendaciones informativas (ningún
/// rol dispara una acción externa real): `PENDING` -> `DONE` cuando el dueño
/// la marca como revisada, o `PENDING` -> `REJECTED` si la descarta.
/// `APPROVED` queda en el enum por si un rol futuro sí necesita un paso de
/// aprobación con una acción externa detrás.
enum AgentTaskStatus {
  PENDING
  APPROVED
  REJECTED
  DONE
}

/// `AgentActionConfirmation.status`: el registro nace `PENDING` en la misma
/// operación que consume el `jti` (antes de ejecutar la acción) y termina en
/// `SUCCEEDED` o `FAILED` — nunca queda "RUNNING" colgado porque el mismo
/// request que lo crea también lo cierra, sea cual sea el resultado.
enum AgentActionConfirmationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

